  <rect x="16" y="16" width="480" height="480" rx="116" fill="url(#tzBg)"/>
  <rect x="17.5" y="17.5" width="477" height="477" rx="114.5" fill="none" stroke="#8a5cff" stroke-opacity="0.4" stroke-width="3"/>
  <g filter="url(#tzGlow)">
    <rect width="512" height="512" fill="url(#tzStroke)" mask="url(#tzMoon)"/>
    <circle cx="412" cy="190" r="13" fill="#ff3d9a"/>
  </g>
  <path d="M232 186 L338 254 L232 322 Z" fill="url(#tzPlay)" stroke="url(#tzPlay)" stroke-width="30" stroke-linejoin="round" filter="url(#tzGlow)"/>
