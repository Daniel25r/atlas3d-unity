<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <radialGradient id="tzBg" cx="0.3" cy="0.22" r="0.95">
      <stop offset="0" stop-color="#2b1257"/>
      <stop offset="0.55" stop-color="#140827"/>
      <stop offset="1" stop-color="#08040f"/>
    </radialGradient>
    <linearGradient id="tzStroke" x1="0.05" y1="0.95" x2="0.95" y2="0.1">
      <stop offset="0" stop-color="#5a2dff"/>
      <stop offset="0.5" stop-color="#b93dff"/>
      <stop offset="1" stop-color="#ff3d9a"/>
    </linearGradient>
    <linearGradient id="tzPlay" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset="1" stop-color="#e4d4ff"/>
    </linearGradient>
    <filter id="tzGlow" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="11" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
