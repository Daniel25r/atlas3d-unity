  updateHud();
}

/* =========================================================
   Selección de cuadro y capa
   ========================================================= */
function setFrame(f, scrub = true) {
  if (!P) return;
  if (SEL) commitSel();
  f = clamp(f | 0, 0, P.frames - 1);
  if (f === cur.frame) { requestTimeline(); return; }
  cur.frame = f; sceneDirty = true;
  requestRender(); requestTimeline(); updateFrameUI(); ensureFrameVisible();
  if (scrub && !PB.playing) scrubAudio(f);
}
function setLayer(li) {
  if (!P) return;
  if (SEL) commitSel();
  li = clamp(li, 0, P.layers.length - 1);
  cur.layer = li; sceneDirty = true;
  requestRender(); buildHeads(); requestTimeline(); updateFrameUI();
}
function updateFrameUI() {
  if (!P) return;
  cur.layer = clamp(cur.layer, 0, P.layers.length - 1); cur.frame = clamp(cur.frame, 0, P.frames - 1);
  $('fcount').textContent = String(cur.frame + 1).padStart(3, '0') + ' / ' + String(P.frames).padStart(3, '0');
  const L = P.layers[cur.layer], id = L.cells[cur.frame];
  $('btnSplit').disabled = !id || !isShared(cur.layer, cur.frame);
  $('btnDelFrame').disabled = P.frames < 2;
  $('btnDelLayer').disabled = P.layers.length < 2;
  { const sib = childrenOf(L.parent || null), k = sib.indexOf(L); $('btnLayerUp').disabled = k >= sib.length - 1; $('btnLayerDown').disabled = k <= 0; }
  $('btnFolderOut').disabled = !L.parent;
  $('btnUndo').disabled = !undoStack.length; $('btnRedo').disabled = !redoStack.length;
  $('btnLoop').classList.toggle('on', P.loop); $('btnOnion').classList.toggle('on', P.onion.on);
  $('btnAudio').classList.toggle('on', !!P.audio);
  $('btnPaste').disabled = !clipboard;
  markStrip(); renderLayersPanel(); renderAnimPanel();
}
