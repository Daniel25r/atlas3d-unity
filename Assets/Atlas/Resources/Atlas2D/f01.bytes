/* ---------- 88-gif.js ---------- */
/* =========================================================
   Exportar GIF animado (codificador propio)
   ========================================================= */
function gifPalette(frames) {
  // histograma de 15 bits + corte por la mediana → 256 colores
  const hist = new Uint32Array(32768);
  for (const im of frames) {
    const d = im.data, step = Math.max(1, Math.floor(d.length / 4 / 60000)) * 4;
    for (let i = 0; i < d.length; i += step) hist[((d[i] >> 3) << 10) | ((d[i + 1] >> 3) << 5) | (d[i + 2] >> 3)]++;
  }
  const keys = []; for (let k = 0; k < 32768; k++) if (hist[k]) keys.push(k);
  const ch = (k, c) => c === 0 ? k >> 10 : c === 1 ? (k >> 5) & 31 : k & 31;
  let boxes = [keys];
  while (boxes.length < 256) {
    let bi = -1, bestRange = 0, bestCh = 0;
    boxes.forEach((b, i) => {
      if (b.length < 2) return;
      for (let c = 0; c < 3; c++) { let mn = 31, mx = 0; for (const k of b) { const v = ch(k, c); if (v < mn) mn = v; if (v > mx) mx = v; } if (mx - mn > bestRange) { bestRange = mx - mn; bi = i; bestCh = c; } }
    });
    if (bi < 0) break;
    const b = boxes[bi].sort((x, y) => ch(x, bestCh) - ch(y, bestCh));
    let total = 0; for (const k of b) total += hist[k];
    let acc = 0, cut = 1;
    for (let i = 0; i < b.length - 1; i++) { acc += hist[b[i]]; if (acc >= total / 2) { cut = i + 1; break; } }
    boxes.splice(bi, 1, b.slice(0, cut), b.slice(cut));
  }
  const pal = new Uint8Array(256 * 3);
  boxes.forEach((b, i) => {
    let r = 0, g = 0, bl = 0, n = 0;
    for (const k of b) { const w = hist[k]; r += ((k >> 10) * 8 + 4) * w; g += (((k >> 5) & 31) * 8 + 4) * w; bl += ((k & 31) * 8 + 4) * w; n += w; }
    if (n) { pal[i * 3] = Math.round(r / n); pal[i * 3 + 1] = Math.round(g / n); pal[i * 3 + 2] = Math.round(bl / n); }
  });
  return { pal, count: Math.max(1, boxes.length) };
}
function gifEncode(frames, w, h, delays, onProgress) {
  const { pal, count } = gifPalette(frames);
  const lut = new Int16Array(32768).fill(-1);
  const nearest = k => {
    const r = (k >> 10) * 8 + 4, g = ((k >> 5) & 31) * 8 + 4, b = (k & 31) * 8 + 4;
    let best = 0, bd = 1e9;
    for (let i = 0; i < count; i++) { const dr = pal[i * 3] - r, dg = pal[i * 3 + 1] - g, db = pal[i * 3 + 2] - b, dd = dr * dr * 3 + dg * dg * 4 + db * db * 2; if (dd < bd) { bd = dd; best = i; } }
    return best;
  };
  let buf = new Uint8Array(1 << 20), len = 0;
  const put = v => { if (len >= buf.length) { const n = new Uint8Array(buf.length * 2); n.set(buf); buf = n; } buf[len++] = v; };
  const put16 = v => { put(v & 255); put((v >> 8) & 255); };
  const putStr = s => { for (let i = 0; i < s.length; i++) put(s.charCodeAt(i)); };
  putStr('GIF89a'); put16(w); put16(h); put(0xF7); put(0); put(0);
  for (let i = 0; i < 768; i++) put(pal[i]);
  put(0x21); put(0xFF); put(11); putStr('NETSCAPE2.0'); put(3); put(1); put16(0); put(0);
  const idx = new Uint8Array(w * h);
  frames.forEach((im, fi) => {
    const d = im.data;
    for (let p = 0, i = 0; p < idx.length; p++, i += 4) {
      const k = ((d[i] >> 3) << 10) | ((d[i + 1] >> 3) << 5) | (d[i + 2] >> 3);
      let v = lut[k]; if (v < 0) { v = nearest(k); lut[k] = v; } idx[p] = v;
    }
    put(0x21); put(0xF9); put(4); put(0x04); put16(delays[fi]); put(0); put(0);
    put(0x2C); put16(0); put16(0); put16(w); put16(h); put(0);
    // LZW
    const minCode = 8, clear = 256, eoi = 257;
    put(minCode);
    let codeSize = minCode + 1, next = eoi + 1, cur = 0, nbits = 0;
    const block = new Uint8Array(255); let bl = 0;
    const flushBlock = () => { if (!bl) return; put(bl); for (let i = 0; i < bl; i++) put(block[i]); bl = 0; };
    const emit = code => { cur |= code << nbits; nbits += codeSize; while (nbits >= 8) { block[bl++] = cur & 255; if (bl === 255) flushBlock(); cur >>>= 8; nbits -= 8; } };
    let table = new Map();
    emit(clear);
    let prefix = idx[0];
    for (let i = 1; i < idx.length; i++) {
      const k = idx[i], key = (prefix << 8) | k, hit = table.get(key);
      if (hit !== undefined) { prefix = hit; continue; }
      emit(prefix);
      if (next === 4096) { emit(clear); next = eoi + 1; codeSize = minCode + 1; table = new Map(); }
      else { if (next >= (1 << codeSize)) codeSize++; table.set(key, next++); }
      prefix = k;
    }
    emit(prefix); emit(eoi);
    if (nbits > 0) { block[bl++] = cur & 255; if (bl === 255) flushBlock(); }
    flushBlock(); put(0);
    if (onProgress) onProgress(fi);
  });
  put(0x3B);
  return buf.subarray(0, len);
}
async function exportGif(maxW) {
  stopPlayback(); commitSel();
  const sc = Math.min(1, maxW / P.w), w = Math.max(2, Math.round(P.w * sc)), h = Math.max(2, Math.round(P.h * sc));
  const budget = PERF.exportMB * MB;
  if (w * h * 4 * P.frames > budget) throw new Error('La animación es demasiado larga para un GIF de este tamaño. Prueba con un tamaño menor.');
  const c = mkCanvas(w, h), t = ctx2d(c, { willReadFrequently: true });
  const frames = [];
  busyCancel = false;
  for (let f = 0; f < P.frames; f++) {
    if (busyCancel) { busy(false); return 'Exportación cancelada'; }
    busy(true, 'Creando GIF… cuadro ' + (f + 1) + ' de ' + P.frames, f / P.frames * 0.5);
    await compositeFrameAsync(t, f, w, h, true, true);
    frames.push(t.getImageData(0, 0, w, h));
    if (f % 3 === 2) { trimCache(); await raf(); }
  }
  const delays = []; for (let i = 0; i < P.frames; i++) delays.push(Math.max(2, Math.round((i + 1) * 100 / P.fps) - Math.round(i * 100 / P.fps)));
  busy(true, 'Comprimiendo GIF…', 0.55); await raf();
  const data = gifEncode(frames, w, h, delays);
  busy(true, 'Guardando GIF…', 0.95); await raf();
  const r = await saveBinary(safeName(P.name) + '.gif', 'image/gif', data);
  busy(false);
  return r;
}
window.__trazoGifForTest = w => exportGif(w);
async function exportChooser() {
  if (!P) return;
  stopPlayback(); commitSel();
  const mk = (v, t, s) => el('button', { html: escapeHtml(t) + '<small>' + escapeHtml(s) + '</small>', onclick: () => closeDialog(v) });
  const r = await dialog({ title: 'Exportar', body: el('div', { class: 'menu' }, [
    mk('mp4', 'Video MP4', 'Con audio · para redes y mensajería'),
    mk('gif', 'GIF animado', 'Sin audio · se repite solo'),
    mk('png', 'Imagen PNG', 'Solo el cuadro ' + (cur.frame + 1)),
  ]), buttons: [{ label: 'Cerrar', value: null }] });
  if (r === 'mp4') exportVideoDialog();
  else if (r === 'png') exportPng();
  else if (r === 'gif') {
    const sel = el('select', { id: 'gifSize' }, [480, 720, 960].map(v => el('option', { value: v, text: 'Ancho ' + Math.min(v, P.w) + ' px' + (v === 480 ? ' (ligero)' : '') })));
    const ok = await dialog({ title: 'GIF animado', body: el('div', { class: 'form' }, [el('label', {}, ['Tamaño', sel]), el('p', { class: 'note', text: 'Se guarda en Imágenes/Artlas 2D. Los GIF usan 256 colores.' })]),
      buttons: [{ label: 'Cancelar', value: false }, { label: 'Crear GIF', value: true, primary: true }] });
    if (!ok) return;
    try { toast(await exportGif(+sel.value), 4000); } catch (e) { busy(false); await dialog({ title: 'No se pudo crear el GIF', body: String(e.message || e) }); }
  }
}
/* ---------- 89-capas.js ---------- */
/* =========================================================
   Capas: fusión, duplicar y combinar
   ========================================================= */
const BLENDS = [
  ['source-over', 'Normal'], ['multiply', 'Multiplicar'], ['screen', 'Trama'], ['overlay', 'Superponer'],
  ['darken', 'Oscurecer'], ['lighten', 'Aclarar'], ['color-dodge', 'Sobreexponer'], ['lighter', 'Añadir luz'],
];
const blendName = b => (BLENDS.find(x => x[0] === (b || 'source-over')) || BLENDS[0])[1];
function drawAboveLayers(c) {
  const f = cur.frame;
  for (let i = cur.layer + 1; i < P.layers.length; i++) {
    const L = P.layers[i]; if (!L.visible || !L.cells[f]) continue;
    const cv = getCellSync(L.cells[f]); if (!cv) continue;
    c.globalAlpha = L.opacity; c.globalCompositeOperation = L.blend || 'source-over'; c.drawImage(cv, 0, 0);
  }
  c.globalAlpha = 1; c.globalCompositeOperation = 'source-over';
}
async function duplicateLayer() {
  if (isGroup(P.layers[cur.layer])) return duplicateFolder();
  const L = P.layers[cur.layer], map = new Map(), cells = [];
  for (let f = 0; f < P.frames; f++) {
    const id = L.cells[f];
    if (!id) { cells.push(null); continue; }
    if (!map.has(id)) { const src = await loadCell(id); const nid = createCell(); ctx2d(getCellSync(nid)).drawImage(src, 0, 0); map.set(id, nid); }
    cells.push(map.get(id));
  }
  P.layers.splice(cur.layer + 1, 0, { id: uid(), name: (L.name + ' copia').slice(0, 40), visible: L.visible, locked: false, opacity: L.opacity, blend: L.blend || 'source-over', clip: !!L.clip, alphaLock: !!L.alphaLock, keys: clone(L.keys), parent: L.parent || null, pivot: clone(L.pivot), peg: L.peg || null, fx: clone(L.fx), cells });
  cur.layer++; structural('Duplicar capa'); toast('Capa duplicada');
}
// Duplica una carpeta con todo su contenido (dibujos compartidos se siguen compartiendo entre sí)
async function duplicateFolder() {
  const G = P.layers[cur.layer], block = [...descendantsOf(G), G];
  const idMap = new Map(block.map(L => [L.id, uid()])), cellMap = new Map();
  const copies = [];
  for (const L of block) {
    const cells = [];
    for (const id of L.cells) {
      if (!id) { cells.push(null); continue; }
      if (!cellMap.has(id)) { const src = await loadCell(id); const nid = createCell(); ctx2d(getCellSync(nid)).drawImage(src, 0, 0); cellMap.set(id, nid); }
      cells.push(cellMap.get(id));
    }
    copies.push({ ...L, id: idMap.get(L.id), parent: idMap.get(L.parent) || L.parent || null, name: L === G ? (L.name + ' copia').slice(0, 40) : L.name, keys: clone(L.keys), cells });
  }
  P.layers.splice(cur.layer + 1, 0, ...copies);
  reorderLayers(); cur.layer = P.layers.findIndex(l => l.id === idMap.get(G.id));
  structural('Duplicar carpeta'); toast('Carpeta duplicada con ' + (block.length - 1) + ' capas');
}
async function mergeDown() {
  if (cur.layer === 0) { toast('No hay ninguna capa debajo'); return; }
  const U = P.layers[cur.layer], D = P.layers[cur.layer - 1];
  if (isGroup(U) || isGroup(D) || (U.parent || null) !== (D.parent || null)) { toast('Solo se pueden combinar dos capas de dibujo de la misma carpeta'); return; }
  if (!U.visible || !D.visible) { toast('Muestra las dos capas antes de combinarlas'); return; }
  if (layerHasMotion(U) || layerHasMotion(D)) { toast('Quita la animación de las capas (panel Animar) antes de combinarlas', 4000); return; }
  if (D.opacity < 1 || (D.blend || 'source-over') !== 'source-over') { toast('La capa de abajo debe tener opacidad 100% y modo Normal para combinar sin cambiar el resultado', 4000); return; }
  if (!(await confirmDlg('Combinar hacia abajo', '«' + U.name + '» se fusionará con «' + D.name + '» en todos los cuadros.', 'Combinar'))) return;
  const map = new Map();
  for (let f = 0; f < P.frames; f++) {
    const u = U.cells[f]; if (!u) continue;
    const d = D.cells[f], key = (d || '-') + '|' + u;
    if (!map.has(key)) {
      const nid = createCell(), t = ctx2d(getCellSync(nid));
      if (d) t.drawImage(await loadCell(d), 0, 0);
      let up = await loadCell(u);
      if (U.clip) { // recorte: solo lo que cae dentro del dibujo de abajo
        const k = mkCanvas(P.w, P.h), kt = ctx2d(k); kt.drawImage(up, 0, 0);
        kt.globalCompositeOperation = 'destination-in'; if (d) kt.drawImage(await loadCell(d), 0, 0); else kt.clearRect(0, 0, P.w, P.h);
        up = k;
      }
      t.globalAlpha = U.opacity; t.globalCompositeOperation = U.blend || 'source-over'; t.drawImage(up, 0, 0);
      t.globalAlpha = 1; t.globalCompositeOperation = 'source-over';
      map.set(key, nid);
    }
    D.cells[f] = map.get(key);
  }
  P.layers.splice(cur.layer, 1); cur.layer--; structural('Combinar capas'); toast('Capas combinadas');
}
$('btnDupLayer').onclick = () => guard(duplicateLayer)();
$('btnMergeLayer').onclick = () => guard(mergeDown)();
/* ---------- 90-presentacion.js ---------- */
/* =========================================================
   Presentación, guías y simetría
   ========================================================= */
let presenting = false;
function enterPresent() {
  if (!P) return;
  commitSel(); closeToolPop(); closeColorPop(); $('guidePop').hidden = true;
  presenting = true; $('editor').classList.add('present');
  requestAnimationFrame(() => { sizeStage(); fitView(); startPlayback(); });
  toast('Toca la pantalla para salir', 1800);
}
function exitPresent() {
  if (!presenting) return;
  presenting = false; stopPlayback(); $('editor').classList.remove('present');
  requestAnimationFrame(() => { sizeStage(); fitView(); });
}
$('btnPresent').onclick = enterPresent;
function drawGuides(c) {
  if (presenting) return;
  const k = 1 / view.z, W = P.w, H = P.h, g = P.guides;
  c.save(); c.lineWidth = k;
  const line = (x0, y0, x1, y1) => { c.beginPath(); c.moveTo(x0, y0); c.lineTo(x1, y1); c.stroke(); };
  if (g === 'grid') {
    c.strokeStyle = 'rgba(70,110,230,.22)'; const st = Math.max(W, H) / 16;
    for (let x = st; x < W; x += st) line(x, 0, x, H);
    for (let y = st; y < H; y += st) line(0, y, W, y);
  } else if (g === 'thirds') {
    c.strokeStyle = 'rgba(70,110,230,.5)';
    for (const u of [1 / 3, 2 / 3]) { line(W * u, 0, W * u, H); line(0, H * u, W, H * u); }
  } else if (g === 'safe') {
    c.setLineDash([8 * k, 6 * k]);
    c.strokeStyle = 'rgba(230,70,110,.6)'; c.strokeRect(W * 0.05, H * 0.05, W * 0.9, H * 0.9);
    c.strokeStyle = 'rgba(70,110,230,.6)'; c.strokeRect(W * 0.1, H * 0.1, W * 0.8, H * 0.8);
  }
  if (symmetry !== 'off') {
    c.setLineDash([10 * k, 6 * k]); c.lineWidth = 1.4 * k; c.strokeStyle = 'rgba(150,80,255,.8)';
    if (symmetry === 'v' || symmetry === 'both') line(W / 2, 0, W / 2, H);
    if (symmetry === 'h' || symmetry === 'both') line(0, H / 2, W, H / 2);
  }
  c.restore();
}
function drawPegBar(c) {
  if (presenting) return;
  const bw = Math.min(P.w * 0.36, 520), bh = Math.max(14, P.h * 0.022), x = (P.w - bw) / 2, y = -bh - Math.max(6, P.h * 0.012);
  c.save();
  c.fillStyle = '#3d3d45'; c.beginPath(); c.roundRect(x, y, bw, bh, bh / 2); c.fill();
  c.fillStyle = 'rgba(255,255,255,.08)'; c.fillRect(x + bh / 2, y + 2, bw - bh, 2);
  c.fillStyle = '#9d9da8';
  const pr = bh * 0.32, cy = y + bh / 2;
  c.beginPath(); c.arc(P.w / 2, cy, pr, 0, Math.PI * 2); c.fill();
  for (const s of [-1, 1]) { const px = P.w / 2 + s * bw * 0.34; c.beginPath(); c.roundRect(px - bh * 1.2, cy - pr * 0.8, bh * 2.4, pr * 1.6, pr * 0.8); c.fill(); }
  c.restore();
}
function segGroup(root, options, get, set) {
  root.innerHTML = '';
  for (const [v, label] of options) {
    const b = el('button', { class: 'seg' + (get() === v ? ' on' : ''), text: label });
    b.onclick = () => { set(v); for (const x of root.children) x.classList.toggle('on', x === b); };
    root.appendChild(b);
  }
}
function openGuidePop() {
  const pop = $('guidePop');
  segGroup($('symSeg'), [['off', 'No'], ['v', '↔'], ['h', '↕'], ['both', '✛']], () => symmetry, v => { symmetry = v; savePrefs(); requestRender(); $('btnGuides').classList.toggle('on', symmetry !== 'off' || P.guides !== 'none'); });
  segGroup($('guideSeg'), [['none', 'Ninguna'], ['grid', 'Cuadrícula'], ['thirds', 'Tercios'], ['safe', 'Zona segura']], () => P.guides, v => { P.guides = v; scheduleSave(); requestRender(); $('btnGuides').classList.toggle('on', symmetry !== 'off' || P.guides !== 'none'); });
  pop.hidden = false;
  const b = $('btnGuides').getBoundingClientRect();
  pop.style.left = clamp(b.right - pop.offsetWidth, 8, innerWidth - pop.offsetWidth - 8) + 'px';
  pop.style.top = (b.bottom + 8) + 'px';
}
$('btnGuides').onclick = e => { e.stopPropagation(); $('guidePop').hidden ? openGuidePop() : ($('guidePop').hidden = true); };
document.addEventListener('pointerdown', e => { if (!$('guidePop').hidden && !$('guidePop').contains(e.target) && !$('btnGuides').contains(e.target)) $('guidePop').hidden = true; });

/* ----- ajustes de pinceles y formas ----- */
function renderBrushGrid() {
  const g = $('brushGrid'); g.innerHTML = '';
  for (const b of allBrushes()) {
    const cv = mkCanvas(220, 64);
    const card = el('button', { class: 'bcard' + (b.id === brushType ? ' on' : '') + (b.custom ? ' custom' : ''), title: b.desc }, [cv, el('span', { class: 'bn', text: b.name }), el('span', { class: 'bd', text: b.desc })]);
    card.onclick = () => { brushType = b.id; savePrefs(); renderBrushGrid(); };
    if (b.custom) {
      const ed = el('span', { class: 'bedit', title: 'Editar pincel', role: 'button', 'aria-label': 'Editar ' + b.name, html: '<svg viewBox="0 0 24 24"><path d="m4 20 1-4L16 5l3 3L8 19z"/></svg>' });
      ed.onclick = ev => { ev.stopPropagation(); closeToolPop(); brushEditor(b); };
      card.appendChild(ed);
    }
    g.appendChild(card);
    renderBrushPreview(b, cv);
  }
  const add = el('button', { class: 'bcard badd', title: 'Crear un pincel nuevo a partir del actual' }, [el('span', { class: 'bplus', text: '+' }), el('span', { class: 'bn', text: 'Nuevo pincel' }), el('span', { class: 'bd', text: 'Basado en el actual' })]);
  add.onclick = () => { closeToolPop(); brushEditor(null); };
  g.appendChild(add);
  $('brushExport').hidden = !customBrushes.length;
}
$('brushImport').onclick = () => $('brushFile').click();
$('brushExport').onclick = () => exportBrushPack();
function renderShapeOpts() {
  segGroup($('shapeSeg'), [['line', 'Línea'], ['rect', 'Rectángulo'], ['ellipse', 'Elipse']], () => shapeType, v => { shapeType = v; savePrefs(); });
  $('shapeFill').checked = shapeFill;
}
$('shapeFill').onchange = e => { shapeFill = e.target.checked; savePrefs(); };
/* ---------- 92-animar.js ---------- */
/* =========================================================
   Panel «Animar»: claves de capa y de cámara
   ========================================================= */
let animTab = 'layer';
let AD = null; // arrastre de animación sobre el lienzo
const animKeys = () => animTab === 'cam' ? P.camera.keys : (P.layers[cur.layer].keys || (P.layers[cur.layer].keys = {}));
const animChannels = () => animTab === 'cam' ? CAM_CH : LAYER_CH;
const animOpen = () => !$('animPanel').hidden;
function animValue(ch) { return chanValue(animTab === 'cam' ? P.camera.keys : P.layers[cur.layer].keys, ch.k, cur.frame, ch.def); }
function renderAnimPanel() {
  if (!P || !animOpen()) return;
  segGroup($('animTabs'), [['layer', 'Capa'], ['cam', 'Cámara']], () => animTab, v => { animTab = v; renderAnimPanel(); requestRender(); });
  const keys = animTab === 'cam' ? P.camera.keys : P.layers[cur.layer].keys;
  $('animWho').textContent = (animTab === 'cam' ? 'Cámara' : 'Capa «' + P.layers[cur.layer].name + '»') + ' · cuadro ' + (cur.frame + 1);
  const box = $('animRows'); box.innerHTML = '';
  for (const ch of animChannels()) {
    const has = keyAt(keys, ch.k, cur.frame), animated = !!(keys && keys[ch.k] && keys[ch.k].length);
    const inp = el('input', { type: 'number', step: ch.step, value: ch.toUI(animValue(ch)), id: 'an_' + ch.k, 'aria-label': ch.label });
    inp.onchange = () => {
      const v = parseFloat(inp.value); if (!Number.isFinite(v)) { renderAnimPanel(); return; }
      setKey(animKeys(), ch.k, cur.frame, ch.fromUI(v));
      structural((animTab === 'cam' ? 'Cámara: ' : 'Animar: ') + ch.label);
      renderAnimPanel();
    };
    const kb = el('button', { class: 'kbtn' + (has ? ' on' : animated ? ' anim' : ''), title: has ? 'Quitar la clave de este cuadro' : 'Poner una clave en este cuadro', 'aria-label': 'Clave de ' + ch.label, html: '<svg viewBox="0 0 24 24"><path d="m12 3 9 9-9 9-9-9z"/></svg>' });
    kb.onclick = () => {
      if (has) delKey(keys, ch.k, cur.frame); else setKey(animKeys(), ch.k, cur.frame, animValue(ch));
      structural(has ? 'Quitar clave: ' + ch.label : 'Clave: ' + ch.label);
      renderAnimPanel();
    };
    box.appendChild(el('div', { class: 'arow' }, [kb, el('span', { class: 'an', text: ch.label }), inp, el('span', { class: 'au', text: ch.unit })]));
  }
  // suavizado de las claves de este cuadro
  const here = keys && Object.keys(keys).filter(ch => keyAt(keys, ch, cur.frame));
  const easeSel = $('animEase');
  easeSel.disabled = !here || !here.length;
  if (here && here.length) { const k0 = keys[here[0]].find(k => k.f === cur.frame); easeSel.value = k0.e || 'smooth'; }
  const kf = keyFrames(keys);
  $('animPrev').disabled = !kf.some(f => f < cur.frame);
  $('animNext').disabled = !kf.some(f => f > cur.frame);
  $('animClear').disabled = !kf.length;
  $('animHint').textContent = animTab === 'cam'
    ? 'Arrastra en el lienzo para mover la cámara. El marco naranja muestra lo que se verá al reproducir y exportar.'
    : 'Arrastra en el lienzo para mover la capa. Pon claves en distintos cuadros y Artlas 2D calcula los intermedios. Para un personaje por piezas: pon el punto de giro en cada articulación y pega cada pieza a la de arriba (mano → antebrazo → brazo → cuerpo).';
  renderRigRows();
}
$('animEase').innerHTML = EASES.map(([v, t]) => '<option value="' + v + '">' + t + '</option>').join('');
$('animEase').onchange = () => {
  const keys = animTab === 'cam' ? P.camera.keys : P.layers[cur.layer].keys;
  if (!keys) return;
  for (const ch of Object.keys(keys)) for (const k of keys[ch]) if (k.f === cur.frame) k.e = $('animEase').value;
  structural('Suavizado de claves'); renderAnimPanel();
};
$('animPrev').onclick = () => { const kf = keyFrames(animTab === 'cam' ? P.camera.keys : P.layers[cur.layer].keys).filter(f => f < cur.frame); if (kf.length) setFrame(kf[kf.length - 1]); };
$('animNext').onclick = () => { const kf = keyFrames(animTab === 'cam' ? P.camera.keys : P.layers[cur.layer].keys).filter(f => f > cur.frame); if (kf.length) setFrame(kf[0]); };
$('animClear').onclick = async () => {
  const who = animTab === 'cam' ? 'la cámara' : 'la capa «' + P.layers[cur.layer].name + '»';
  if (!(await confirmDlg('Quitar animación', 'Se borrarán todas las claves de ' + who + '. Puedes deshacerlo.', 'Quitar', true))) return;
  if (animTab === 'cam') P.camera.keys = {}; else P.layers[cur.layer].keys = {};
  structural('Quitar animación'); renderAnimPanel();
};
function toggleAnimPanel(force) {
  const p = $('animPanel'), show = force !== undefined ? force : p.hidden;
  if (show) { commitSel(); $('layersPanel').hidden = true; $('btnLayers').classList.remove('on'); }
  p.hidden = !show; $('btnAnim').classList.toggle('on', show);
  renderAnimPanel(); requestRender();
}
$('btnAnim').onclick = () => toggleAnimPanel();
$('btnCloseAnim').onclick = () => toggleAnimPanel(false);

/* ----- arrastre sobre el lienzo con el panel abierto ----- */
function animDown(e) {
  if (animTab === 'layer' && pivotMode) { setPivotAt(e); return; }
  if (animTab === 'layer' && P.layers[cur.layer].locked) { toast('La capa está bloqueada'); return; }
  const p = screenToWorld(e.offsetX, e.offsetY);
  const keys = animKeys();
  AD = { pid: e.pointerId, p0: p, x0: chanValue(keys, 'x', cur.frame, 0), y0: chanValue(keys, 'y', cur.frame, 0), moved: false };
}
function animMove(e) {
  const p = screenToWorld(e.offsetX, e.offsetY), keys = animKeys();
  const dx = p.x - AD.p0.x, dy = p.y - AD.p0.y;
  if (Math.hypot(dx, dy) > 0.5) AD.moved = true;
  setKey(keys, 'x', cur.frame, Math.round(AD.x0 + dx));
  setKey(keys, 'y', cur.frame, Math.round(AD.y0 + dy));
  requestRender();
}
function animUp() {
  const a = AD; AD = null;
  if (a && a.moved) { structural(animTab === 'cam' ? 'Mover cámara' : 'Mover capa'); renderAnimPanel(); }
}
/* ---------- 93-pro.js ---------- */
/* =========================================================
   Herramientas «pro» (al estilo de Toon Boom Harmony):
   rig de recortables (punto de giro y capas pegadas), trayectoria,
   efectos de capa, sustitución de dibujos, labios automáticos y
   secuencia PNG con transparencia.
   ========================================================= */
let pivotMode = false;

/* ----- filas extra del panel Animar (capa) ----- */
function renderRigRows() {
  const box = $('animRig'); if (!box) return;
  box.innerHTML = '';
  if (!P || animTab !== 'layer') { pivotMode = false; return; }
  const L = P.layers[cur.layer];
  // Punto de giro
  const pv = el('button', { class: 'tb' + (pivotMode ? ' on' : ''), text: pivotMode ? '✓ Toca el lienzo para poner el punto de giro' : '⊕ Punto de giro (hombro, codo, cadera…)' });
  pv.onclick = () => { pivotMode = !pivotMode; renderRigRows(); requestRender(); };
  const pvReset = el('button', { class: 'tb', text: 'Centrar', title: 'Punto de giro en el centro' });
  pvReset.onclick = () => { delete L.pivot; structural('Punto de giro'); renderAnimPanel(); };
  box.appendChild(el('div', { class: 'drow' }, [pv, pvReset]));
  // Pegada a
  const sel = el('select', { 'aria-label': 'Pegada a' });
  sel.appendChild(el('option', { value: '', text: 'Nada (se mueve sola)' }));
  for (const G of P.layers) {
    if (G === L || pegLoops(L, G)) continue;
    sel.appendChild(el('option', { value: G.id, text: (isGroup(G) ? '📁 ' : '') + G.name, selected: L.peg === G.id }));
  }
  sel.onchange = () => {
    L.peg = sel.value || null;
    structural(L.peg ? 'Pegar capa' : 'Soltar capa');
    toast(L.peg ? '«' + L.name + '» ahora sigue a «' + pegOf(L).name + '»: al moverla o girarla, esta capa va con ella' : '«' + L.name + '» ya no sigue a ninguna capa');
    renderAnimPanel();
  };
  box.appendChild(el('label', { class: 'sl' }, [el('span', { text: 'Pegada a' }), sel]));
  const fx = el('button', { class: 'tb', text: '✨ Efectos de la capa' + (fxActive(L) ? ' (activos)' : '') });
  fx.onclick = () => layerFxDialog();
  const an = el('button', { class: 'tb', text: '⚡ Anime' + (animeFxOn(L.fx) ? ' (activo)' : '') });
  an.onclick = () => animeFxDialog();
  box.appendChild(el('div', { class: 'drow' }, [fx, an]));
}

// Toque en el lienzo con «Punto de giro»: el punto del dibujo bajo el dedo
function setPivotAt(e) {
  const L = P.layers[cur.layer];
  const w = screenToWorld(e.offsetX, e.offsetY);
  const m = fullLayerMatrix(L, cur.frame);
  const q = m ? m.inverse().transformPoint(new DOMPoint(w.x, w.y)) : { x: w.x, y: w.y };
  const turned = L.keys && ['r', 's', 'sx', 'sy'].some(ch => L.keys[ch] && L.keys[ch].length);
  L.pivot = { x: Math.round(q.x), y: Math.round(q.y) };
  pivotMode = false;
  structural('Punto de giro');
  renderAnimPanel();
  toast(turned ? 'Punto de giro cambiado. Consejo: ponlo antes de girar o escalar, así la capa no salta.' : 'Punto de giro puesto: la capa gira y se escala alrededor de él', 4000);
}

/* ----- dibujo sobre el lienzo: punto de giro y trayectoria ----- */
function drawRigOverlay(c) {
  if (presenting || !P || !animOpen() || animTab !== 'layer') return;
  const L = P.layers[cur.layer]; if (!L) return;
  const k = 1 / view.z, pv = layerPivot(L);
  const at = f => { const m = fullLayerMatrix(L, f); return m ? m.transformPoint(new DOMPoint(pv.x, pv.y)) : { x: pv.x, y: pv.y }; };
  // Trayectoria (como «motion path»): por dónde pasa el punto de giro
  if (layerHasMotion(L)) {
    const n = Math.min(P.frames, 900);
    c.save(); c.lineWidth = 1.5 * k; c.strokeStyle = 'rgba(80,190,255,.85)'; c.beginPath();
    for (let f = 0; f < n; f++) { const q = at(f); f ? c.lineTo(q.x, q.y) : c.moveTo(q.x, q.y); }
    c.stroke();
    const kf = new Set(keyFrames(L.keys));
    for (let f = 0; f < n; f++) {
      const q = at(f), key = kf.has(f);
      c.fillStyle = key ? '#ffb02e' : 'rgba(80,190,255,.85)';
      const r = (key ? 4 : 1.8) * k;
      c.beginPath(); c.arc(q.x, q.y, r, 0, Math.PI * 2); c.fill();
    }
    c.restore();
  }
  // Punto de giro
  const q = at(cur.frame), r = 9 * k;
  c.save(); c.lineWidth = 2 * k; c.strokeStyle = pivotMode ? '#ff4fa3' : '#ffb02e';
  c.beginPath(); c.arc(q.x, q.y, r, 0, Math.PI * 2); c.moveTo(q.x - r * 1.7, q.y); c.lineTo(q.x + r * 1.7, q.y); c.moveTo(q.x, q.y - r * 1.7); c.lineTo(q.x, q.y + r * 1.7); c.stroke();
  // Línea hasta la capa a la que está pegada
  const G = pegOf(L);
  if (G) {
    const gp = layerPivot(G), gm = fullLayerMatrix(G, cur.frame);
    const g = gm ? gm.transformPoint(new DOMPoint(gp.x, gp.y)) : gp;
    c.setLineDash([6 * k, 5 * k]); c.strokeStyle = 'rgba(255,176,46,.7)';
    c.beginPath(); c.moveTo(g.x, g.y); c.lineTo(q.x, q.y); c.stroke();
  }
  c.restore();
}

/* ----- efectos de capa ----- */
async function layerFxDialog() {
  const L = P.layers[cur.layer];
  if (isGroup(L)) { toast('Los efectos se ponen en capas de dibujo, no en carpetas'); return; }
  const x = Object.assign({ blur: 0, bright: 100, contrast: 100, sat: 100, hue: 0, tint: '#ff3366', tintA: 0, shadow: false, shX: 12, shY: 12, shBlur: 10, shColor: '#000000', shA: 45, glow: 0, glowColor: '#ffe680' }, L.fx || {});
  const before = clone(L.fx);
  const live = () => { L.fx = Object.assign({}, x); invalidateAllFrames(); sceneDirty = true; requestRender(); };
  const slider = (label, key, min, max, unit) => {
    const out = el('output', { text: x[key] + unit });
    const r = el('input', { type: 'range', min: String(min), max: String(max), value: String(x[key]) });
    r.oninput = () => { x[key] = parseFloat(r.value); out.textContent = r.value + unit; live(); };
    return el('label', {}, [el('span', {}, [label + ' ', out]), r]);
  };
  const color = (label, key) => {
    const c = el('input', { type: 'color', value: x[key] });
    c.oninput = () => { x[key] = c.value; live(); };
    return el('label', {}, [label, c]);
  };
  const shOn = el('input', { type: 'checkbox' }); shOn.checked = !!x.shadow;
  shOn.onchange = () => { x.shadow = shOn.checked; live(); };
  const body = el('div', { class: 'form' }, [
    el('p', { class: 'note', text: 'Se ven en el lienzo, al reproducir y al exportar. Sombra y resplandor siguen la forma del dibujo.' }),
    el('label', { class: 'chk' }, [shOn, 'Sombra proyectada']),
    el('div', { class: 'row2' }, [slider('Sombra X', 'shX', -80, 80, ' px'), slider('Sombra Y', 'shY', -80, 80, ' px')]),
    el('div', { class: 'row2' }, [slider('Suavidad sombra', 'shBlur', 0, 60, ' px'), slider('Fuerza sombra', 'shA', 0, 100, '%')]),
    color('Color de la sombra', 'shColor'),
    slider('Resplandor (brillo alrededor)', 'glow', 0, 80, ' px'),
    color('Color del resplandor', 'glowColor'),
    slider('Desenfoque', 'blur', 0, 40, ' px'),
    el('div', { class: 'row2' }, [slider('Brillo', 'bright', 0, 200, '%'), slider('Contraste', 'contrast', 0, 200, '%')]),
    el('div', { class: 'row2' }, [slider('Saturación', 'sat', 0, 200, '%'), slider('Tono', 'hue', -180, 180, '°')]),
    el('div', { class: 'row2' }, [color('Teñir de color', 'tint'), slider('Cuánto teñir', 'tintA', 0, 100, '%')]),
  ]);
  const r = await dialog({ title: 'Efectos · ' + L.name, body, buttons: [{ label: 'Quitar todos', value: 'clear', danger: true }, { label: 'Cancelar', value: false }, { label: 'Aplicar', value: true, primary: true }] });
  if (r === true) { L.fx = Object.assign({}, x); structural('Efectos de capa'); }
  else if (r === 'clear') { delete L.fx; structural('Quitar efectos'); }
  else { if (before) L.fx = before; else delete L.fx; invalidateAllFrames(); sceneDirty = true; requestRender(); }
  if (animOpen()) renderAnimPanel();
}

/* ----- sustitución de dibujos ----- */
// Todos los dibujos que la capa usa en algún cuadro: se puede poner cualquiera en el cuadro actual
// (bocas, manos, ojos… como la sustitución de dibujos de Harmony).
function layerDrawings(L) {
  const seen = [], set = new Set();
  for (const id of L.cells) if (id && !set.has(id)) { set.add(id); seen.push(id); }
  return seen;
}
async function swapDrawingDialog() {
  const L = P.layers[cur.layer];
  if (isGroup(L)) { toast('Elige una capa de dibujo'); return; }
  if (L.locked) { toast('La capa está bloqueada'); return; }
  const ids = layerDrawings(L);
  if (ids.length < 1) { toast('Esta capa aún no tiene dibujos'); return; }
  const tw = 96, th = Math.max(24, Math.round(96 * P.h / P.w));
  const grid = el('div', { style: 'display:grid;grid-template-columns:repeat(auto-fill,minmax(' + (tw + 8) + 'px,1fr));gap:8px;max-height:52vh;overflow:auto' });
  const pick = v => closeDialog(v);
  const tile = (id, n) => {
    const cv = mkCanvas(tw, th), t = ctx2d(cv);
    t.fillStyle = P.paper || '#fff'; t.fillRect(0, 0, tw, th);
    if (id) loadCell(id).then(src => { if (src) t.drawImage(src, 0, 0, tw, th); }).catch(() => { });
    cv.style.cssText = 'width:100%;height:auto;border-radius:6px;display:block;border:2px solid ' + (L.cells[cur.frame] === id ? 'var(--accent)' : 'var(--line2)');
    const b = el('button', { style: 'padding:4px;display:flex;flex-direction:column;gap:3px;align-items:stretch;height:auto;background:var(--panel2);border:1px solid var(--line2);border-radius:8px;color:var(--text)', onclick: () => pick(id || 'none') }, [cv, el('span', { text: id ? 'Dibujo ' + n : 'Vacío', style: 'font-size:11px' })]);
    return b;
  };
  ids.forEach((id, i) => grid.appendChild(tile(id, i + 1)));
  grid.appendChild(tile(null, 0));
  const r = await dialog({ title: 'Cambiar dibujo · cuadro ' + (cur.frame + 1), body: el('div', { class: 'form' }, [el('p', { class: 'note', text: 'Elige qué dibujo de «' + L.name + '» se ve en este cuadro. Es el mismo dibujo, no una copia: si lo retocas, cambia en todos los cuadros donde aparece.' }), grid]), buttons: [{ label: 'Cerrar', value: null }] });
  if (!r) return;
  L.cells[cur.frame] = r === 'none' ? null : r;
  structural('Cambiar dibujo');
}

/* ----- labios automáticos ----- */
async function lipSyncDialog() {
  if (!AU.buffer || !P.audio) { toast('Primero añade el audio con la voz (menú → Añadir audio)', 4000); return; }
  if (!AU.peaks) computePeaks();
  const L = P.layers[cur.layer];
  if (isGroup(L) || L.locked) { toast('Elige la capa de la boca (desbloqueada)'); return; }
  const ids = layerDrawings(L);
  if (ids.length < 2) {
    await dialog({ title: 'Labios automáticos', body: el('div', { class: 'form' }, [el('p', { class: 'note', text: 'En la capa «' + L.name + '» dibuja primero las bocas, una en cada cuadro y en este orden: 1) cerrada, 2) un poco abierta, 3) abierta… (de 2 a 8 bocas). Después vuelve aquí: Artlas 2D las pondrá solas siguiendo la voz.' })]) });
    return;
  }
  const mouths = ids.slice(0, 8);
  const sens = el('input', { type: 'range', min: '1', max: '100', value: '55' });
  const hold = el('select', {}, [el('option', { value: '1', text: 'Cambiar en cada cuadro' }), el('option', { value: '2', text: 'Mínimo 2 cuadros por boca (más natural)', selected: true }), el('option', { value: '3', text: 'Mínimo 3 cuadros' })]);
  const fromHere = el('input', { type: 'checkbox' });
  const body = el('div', { class: 'form' }, [
    el('p', { class: 'note', text: 'Se usarán las ' + mouths.length + ' bocas de «' + L.name + '» en el orden en que aparecen: la primera es la boca cerrada y la última la más abierta. Se sustituyen los dibujos de esta capa en los cuadros con audio.' }),
    el('label', {}, ['Sensibilidad a la voz', sens]),
    el('label', {}, ['Ritmo', hold]),
    el('label', { class: 'chk' }, [fromHere, 'Solo desde el cuadro actual']),
  ]);
  const ok = await dialog({ title: 'Labios automáticos', body, buttons: [{ label: 'Cancelar', value: false }, { label: 'Sincronizar', value: true, primary: true }] });
  if (!ok) return;
  const peaks = AU.peaks, n = Math.min(peaks.length, P.frames);
  const start = fromHere.checked ? cur.frame : 0;
  const s = parseInt(sens.value, 10) / 100;           // más sensibilidad = umbral más bajo
  const floor = 0.22 - s * 0.19, minHold = parseInt(hold.value, 10);
  let last = -1, held = 0, changed = 0;
  for (let f = start; f < n; f++) {
    // un poco de suavizado con el cuadro vecino para que no tiemble
    const v = (peaks[f] * 2 + (peaks[f - 1] || 0) + (peaks[f + 1] || 0)) / 4;
    let idx = v < floor ? 0 : 1 + Math.min(mouths.length - 2, Math.floor((v - floor) / (1 - floor) * (mouths.length - 1)));
    if (last >= 0 && idx !== last && held < minHold) idx = last;
    if (idx === last) held++; else { held = 1; last = idx; }
    if (L.cells[f] !== mouths[idx]) { L.cells[f] = mouths[idx]; changed++; }
  }
  structural('Labios automáticos');
  toast(changed + ' cuadros sincronizados con la voz. Retoca a mano los que quieras con «Cambiar dibujo».', 5000);
}

/* ----- secuencia PNG ----- */
async function exportPngSequence() {
  stopPlayback();
  const trans = el('input', { type: 'checkbox', checked: true });
  const scaleSel = el('select', {}, [el('option', { value: '1', text: '100% (' + P.w + '×' + P.h + ')' }), el('option', { value: '0.5', text: '50% (' + Math.round(P.w / 2) + '×' + Math.round(P.h / 2) + ')' })]);
  const body = el('div', { class: 'form' }, [
    el('p', { class: 'note', text: P.frames + ' cuadros en un ZIP, uno por imagen (nombre_0001.png…). Sirve para editores de vídeo, juegos o para seguir el trabajo en otro programa.' }),
    el('label', { class: 'chk' }, [trans, 'Fondo transparente (sin el color del papel)']),
    el('label', {}, ['Tamaño', scaleSel]),
  ]);
  const ok = await dialog({ title: 'Exportar secuencia PNG', body, buttons: [{ label: 'Cancelar', value: false }, { label: 'Exportar', value: true, primary: true }] });
  if (!ok) return;
  const k = parseFloat(scaleSel.value) || 1, w = Math.max(1, Math.round(P.w * k)), h = Math.max(1, Math.round(P.h * k));
  const base = safeName(P.name), files = [];
  busyCancel = false;
  busy(true, 'Exportando cuadros…', 0);
  try {
    const c = mkCanvas(w, h), t = ctx2d(c);
    for (let f = 0; f < P.frames && !busyCancel; f++) {
      await compositeFrameAsync(t, f, w, h, !trans.checked, true);
      const blob = await canvasToBlob(c);
      files.push({ name: base + '_' + String(f + 1).padStart(4, '0') + '.png', data: new Uint8Array(await blob.arrayBuffer()) });
      busy(true, 'Exportando cuadros… ' + (f + 1) + ' / ' + P.frames, (f + 1) / P.frames);
      if (f % 10 === 9) trimCache();
    }
    if (busyCancel) { busy(false); toast('Exportación cancelada'); return; }
    busy(true, 'Creando el ZIP…', 1);
    const r = await saveBinary(base + '_png.zip', 'application/zip', zipBuild(files));
    busy(false); toast(r, 4000);
  } catch (e) { busy(false); toast('Error al exportar: ' + (e && e.message || e), 4000); }
}
/* ---------- 94-anime.js ---------- */
/* =========================================================
   Efectos de anime (nivel estudio):
   · En la capa: luz de contorno (rim light), sombra cel de dos tonos,
     aura de energía animada (ki) y destellos que parpadean.
   · En la escena: líneas de velocidad, temblor de cámara, resplandor
     (bloom), aberración cromática, grano de película, viñeta y destello.
   Todo se ve igual en el lienzo, al reproducir y al exportar.
   ========================================================= */

// Números al azar que se repiten igual (cada cuadro dibuja lo mismo siempre)
function seeded(seed) {
  let s = (seed | 0) ^ 0x9e3779b9;
  return () => {
    s |= 0; s = s + 0x6d2b79f5 | 0;
    let t = Math.imul(s ^ s >>> 15, 1 | s);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}
const animeFxOn = x => !!x && !!(x.rim || x.cel || x.aura || x.spark);

// Silueta del dibujo vista a 1/8: bordes y caja que la contiene
function silhouetteInfo(a, w, h) {
  const s = 8, sw = Math.max(8, Math.ceil(w / s)), sh = Math.max(8, Math.ceil(h / s));
  const c = tmpCanvas('silh', sw, sh), t = resetCtx(ctx2d(c));
  t.clearRect(0, 0, sw, sh); t.drawImage(a, 0, 0, sw, sh);
  const d = t.getImageData(0, 0, sw, sh).data;
  const edges = []; let x0 = sw, y0 = sh, x1 = -1, y1 = -1;
  const A = (x, y) => (x < 0 || y < 0 || x >= sw || y >= sh) ? 0 : d[(y * sw + x) * 4 + 3];
  for (let y = 0; y < sh; y++) for (let x = 0; x < sw; x++) {
    if (A(x, y) < 50) continue;
    if (x < x0) x0 = x; if (y < y0) y0 = y; if (x > x1) x1 = x; if (y > y1) y1 = y;
    if (A(x - 1, y) < 50 || A(x + 1, y) < 50 || A(x, y - 1) < 50 || A(x, y + 1) < 50) edges.push([(x + 0.5) * w / sw, (y + 0.5) * h / sh]);
  }
  if (x1 < 0) return null;
  return { edges, box: [x0 * w / sw, y0 * h / sh, (x1 + 1) * w / sw, (y1 + 1) * h / sh] };
}

// La silueta del dibujo desplazada, para luz y sombra de dos tonos
function shiftedBand(a, w, h, dx, dy, color, soft, name) {
  const b = tmpCanvas(name, w, h), t = resetCtx(ctx2d(b));
  t.clearRect(0, 0, w, h);
  t.drawImage(a, 0, 0);
  t.globalCompositeOperation = 'destination-out'; t.drawImage(a, dx, dy);
  t.globalCompositeOperation = 'source-in'; t.fillStyle = color; t.fillRect(0, 0, w, h);
  t.globalCompositeOperation = 'source-over';
  if (soft > 0) {
    const s = tmpCanvas(name + 's', w, h), st = resetCtx(ctx2d(s));
    st.clearRect(0, 0, w, h); st.filter = 'blur(' + soft.toFixed(2) + 'px)'; st.drawImage(b, 0, 0); st.filter = 'none';
    st.globalCompositeOperation = 'destination-in'; st.drawImage(a, 0, 0); st.globalCompositeOperation = 'source-over';
    return s;
  }
  return b;
}

// Aplica los efectos de anime a `a` (el dibujo con sus efectos de color) en `o`.
// Devuelve el lienzo final.
function applyAnimeFx(L, full, a, w, h, f) {
  const x = L.fx, k = w / P.w;
  const o = tmpCanvas('anim', w, h), ot = resetCtx(ctx2d(o));
  ot.clearRect(0, 0, w, h);
  const info = (x.aura || x.spark) ? silhouetteInfo(a, w, h) : null;
  const hold = Math.max(1, x.auraHold || 2);
  // --- Aura de energía: lenguas de luz que suben desde el borde (detrás del dibujo)
  if (x.aura && info && info.edges.length) {
    const au = tmpCanvas('aura', w, h), t = resetCtx(ctx2d(au));
    t.clearRect(0, 0, w, h);
    const size = x.aura * k, cycle = Math.max(2, x.auraCycle || 4);
    const R = seeded(1000 + (Math.floor(f / hold) % cycle) * 7919);
    const dirA = ((x.auraDir != null ? x.auraDir : -90) * Math.PI) / 180;
    const inner = x.auraColor2 || '#ffffff', outer = x.auraColor || '#7fd4ff';
    // halo suave
    t.save(); t.shadowColor = rgba(outer, 0.9); t.shadowBlur = size * 0.6; t.shadowOffsetX = w * 3 + 100;
    t.drawImage(a, -(w * 3 + 100), 0); t.drawImage(a, -(w * 3 + 100), 0); t.restore();
    t.globalCompositeOperation = 'lighter';
    const n = Math.min(260, Math.round(30 + info.edges.length * 0.35 * (x.auraDensity || 1)));
    for (let i = 0; i < n; i++) {
      const p = info.edges[Math.floor(R() * info.edges.length)];
      const len = size * (0.45 + R() * 1.1), wid = size * (0.10 + R() * 0.16);
      const sway = (R() - 0.5) * 0.9;
      const ang = dirA + sway;
      const ux = Math.cos(ang), uy = Math.sin(ang), px = -uy, py = ux;
      const tipx = p[0] + ux * len, tipy = p[1] + uy * len;
      const bend = (R() - 0.5) * len * 0.5;
      const g = t.createLinearGradient(p[0], p[1], tipx, tipy);
      g.addColorStop(0, rgba(inner, 0.55)); g.addColorStop(0.35, rgba(outer, 0.45)); g.addColorStop(1, rgba(outer, 0));
      t.fillStyle = g;
      t.beginPath();
      t.moveTo(p[0] - px * wid, p[1] - py * wid);
      t.quadraticCurveTo(p[0] + ux * len * 0.55 + px * bend - px * wid * 0.6, p[1] + uy * len * 0.55 + py * bend - py * wid * 0.6, tipx + px * bend * 0.6, tipy + py * bend * 0.6);
      t.quadraticCurveTo(p[0] + ux * len * 0.55 + px * bend + px * wid * 0.6, p[1] + uy * len * 0.55 + py * bend + py * wid * 0.6, p[0] + px * wid, p[1] + py * wid);
      t.closePath(); t.fill();
    }
    t.globalCompositeOperation = 'source-over';
    ot.globalAlpha = Math.min(1, (x.auraA != null ? x.auraA : 90) / 100);
    ot.filter = 'blur(' + Math.max(0.5, size * 0.04).toFixed(2) + 'px)';
    ot.drawImage(au, 0, 0);
    ot.filter = 'none'; ot.globalAlpha = 1;
  }
  // --- El dibujo (con su sombra y resplandor)
  ot.drawImage(full, 0, 0);
  const lightA = (((x.lightDir != null ? x.lightDir : -45)) * Math.PI) / 180;
  const lx = Math.cos(lightA), ly = Math.sin(lightA);
  // --- Sombra cel (dos tonos, borde duro): la parte que no mira a la luz
  if (x.cel) {
    const d = x.cel * k;
    const band = shiftedBand(a, w, h, lx * d, ly * d, x.celColor || '#3a2c6e', (x.celSoft || 0) * k, 'cel');
    ot.globalAlpha = (x.celA != null ? x.celA : 55) / 100; ot.globalCompositeOperation = 'multiply';
    ot.drawImage(band, 0, 0);
    ot.globalAlpha = 1; ot.globalCompositeOperation = 'source-over';
  }
  // --- Luz de contorno: el borde que mira a la luz se ilumina
  if (x.rim) {
    const d = x.rim * k;
    const band = shiftedBand(a, w, h, -lx * d, -ly * d, x.rimColor || '#bfe8ff', Math.max(0.5, d * 0.25), 'rim');
    ot.globalAlpha = (x.rimA != null ? x.rimA : 90) / 100; ot.globalCompositeOperation = 'screen';
    ot.drawImage(band, 0, 0);
    ot.globalAlpha = 1; ot.globalCompositeOperation = 'source-over';
  }
  // --- Destellos: estrellas de cuatro puntas que aparecen y se apagan
  if (x.spark && info) {
    const b = info.box, pad = (x.aura || 20) * k;
    const R = seeded(777 + (L.id ? String(L.id).length * 131 : 0));
    const sz = (x.sparkSize || 10) * k, col = x.sparkColor || '#ffffff';
    ot.globalCompositeOperation = 'lighter';
    for (let i = 0; i < x.spark; i++) {
      const sx = b[0] - pad + R() * (b[2] - b[0] + pad * 2), sy = b[1] - pad + R() * (b[3] - b[1] + pad * 2);
      const speed = 0.35 + R() * 0.5, ph = R() * 6.283;
      const life = Math.sin(f * speed + ph);
      if (life <= 0.05) continue;
      const s = sz * (0.4 + R() * 0.8) * life;
      const g = ot.createRadialGradient(sx, sy, 0, sx, sy, s * 1.2);
      g.addColorStop(0, rgba(col, 0.9 * life)); g.addColorStop(1, rgba(col, 0));
      ot.fillStyle = g; ot.beginPath(); ot.arc(sx, sy, s * 1.2, 0, 6.283); ot.fill();
      ot.fillStyle = rgba(col, life);
      ot.beginPath();
      const th = s * 0.12;
      ot.moveTo(sx, sy - s * 2); ot.lineTo(sx + th, sy - th); ot.lineTo(sx + s * 2, sy); ot.lineTo(sx + th, sy + th);
      ot.lineTo(sx, sy + s * 2); ot.lineTo(sx - th, sy + th); ot.lineTo(sx - s * 2, sy); ot.lineTo(sx - th, sy - th);
      ot.closePath(); ot.fill();
    }
    ot.globalCompositeOperation = 'source-over';
  }
  return o;
}

/* ----- Estilos listos ----- */
const ANIME_PRESETS = {
  ultra: { name: 'Ultra instinto (plateado)', fx: { aura: 70, auraColor: '#8fd8ff', auraColor2: '#ffffff', auraA: 85, auraDir: -90, auraHold: 2, auraCycle: 4, rim: 10, rimColor: '#cfeeff', rimA: 95, lightDir: -60, cel: 0, spark: 26, sparkColor: '#ffffff', sparkSize: 9, glow: 18, glowColor: '#a9e4ff' } },
  ssj: { name: 'Aura dorada', fx: { aura: 80, auraColor: '#ffcc33', auraColor2: '#fff7c2', auraA: 90, auraDir: -90, auraHold: 2, auraCycle: 4, rim: 8, rimColor: '#fff0a0', rimA: 90, lightDir: -90, spark: 14, sparkColor: '#fff4b0', sparkSize: 8, glow: 22, glowColor: '#ffd24a' } },
  dark: { name: 'Aura oscura', fx: { aura: 75, auraColor: '#9b30ff', auraColor2: '#ff4fd8', auraA: 85, auraDir: -90, auraHold: 2, auraCycle: 3, rim: 7, rimColor: '#e0a0ff', rimA: 80, lightDir: -90, cel: 18, celColor: '#2a103f', celA: 60, spark: 8, sparkColor: '#ffb8ff', glow: 14, glowColor: '#b04cff' } },
  fire: { name: 'Fuego', fx: { aura: 90, auraColor: '#ff5a1f', auraColor2: '#ffe066', auraA: 95, auraDir: -90, auraHold: 1, auraCycle: 5, rim: 9, rimColor: '#ffb066', lightDir: 90, glow: 20, glowColor: '#ff7a2a' } },
  cel: { name: 'Sombra y luz de anime', fx: { cel: 22, celColor: '#4a3478', celA: 55, rim: 6, rimColor: '#ffffff', rimA: 70, lightDir: -45 } },
};

/* ----- Diálogo «Efectos de anime» de la capa ----- */
async function animeFxDialog() {
  const L = P.layers[cur.layer];
  if (!L || isGroup(L)) { toast('Los efectos se ponen en capas de dibujo, no en carpetas'); return; }
  const base = { rim: 0, rimColor: '#bfe8ff', rimA: 90, lightDir: -45, cel: 0, celColor: '#3a2c6e', celA: 55, celSoft: 0, aura: 0, auraColor: '#7fd4ff', auraColor2: '#ffffff', auraA: 90, auraDir: -90, auraHold: 2, auraCycle: 4, auraDensity: 1, spark: 0, sparkColor: '#ffffff', sparkSize: 10 };
  const x = Object.assign({}, base, L.fx || {});
  const before = clone(L.fx);
  const live = () => { L.fx = Object.assign({}, L.fx || {}, x); invalidateAllFrames(); sceneDirty = true; requestRender(); };
  const inputs = {};
  const slider = (label, key, min, max, unit) => {
    const out = el('output', { text: x[key] + unit });
    const r = el('input', { type: 'range', min: String(min), max: String(max), value: String(x[key]) });
    r.oninput = () => { x[key] = parseFloat(r.value); out.textContent = r.value + unit; live(); };
    inputs[key] = v => { r.value = String(v); out.textContent = v + unit; };
    return el('label', {}, [el('span', {}, [label + ' ', out]), r]);
  };
  const color = (label, key) => {
    const c = el('input', { type: 'color', value: x[key] });
    c.oninput = () => { x[key] = c.value; live(); };
    inputs[key] = v => { c.value = v; };
    return el('label', {}, [label, c]);
  };
  const head = t => el('p', { class: 'note', html: '<b style="color:var(--text)">' + escapeHtml(t) + '</b>' });
  const presets = el('div', { class: 'drow', style: 'flex-wrap:wrap;gap:6px' }, Object.keys(ANIME_PRESETS).map(id => {
    const b = el('button', { class: 'tb', text: ANIME_PRESETS[id].name });
    b.onclick = () => {
      Object.assign(x, base, ANIME_PRESETS[id].fx);
      for (const k in inputs) if (x[k] != null) inputs[k](x[k]);
      // el resplandor es de «Efectos de la capa»: se copia tal cual
      L.fx = Object.assign({}, L.fx || {}, x); invalidateAllFrames(); sceneDirty = true; requestRender();
    };
    return b;
  }));
  const body = el('div', { class: 'form' }, [
    el('p', { class: 'note', text: 'Estilos listos (luego puedes ajustar cada cosa):' }),
    presets,
    head('Luz'),
    slider('Dirección de la luz', 'lightDir', -180, 180, '°'),
    head('Aura de energía (se mueve sola)'),
    slider('Tamaño del aura', 'aura', 0, 200, ' px'),
    el('div', { class: 'row2' }, [color('Color de fuera', 'auraColor'), color('Color de dentro', 'auraColor2')]),
    el('div', { class: 'row2' }, [slider('Fuerza', 'auraA', 0, 100, '%'), slider('Hacia dónde sube', 'auraDir', -180, 180, '°')]),
    el('div', { class: 'row2' }, [slider('Cuadros por dibujo', 'auraHold', 1, 4, ''), slider('Dibujos del ciclo', 'auraCycle', 2, 8, '')]),
    slider('Densidad', 'auraDensity', 0.3, 3, '×'),
    head('Luz de contorno (borde iluminado)'),
    el('div', { class: 'row2' }, [slider('Ancho', 'rim', 0, 60, ' px'), slider('Fuerza', 'rimA', 0, 100, '%')]),
    color('Color de la luz', 'rimColor'),
    head('Sombra de anime (dos tonos, borde duro)'),
    el('div', { class: 'row2' }, [slider('Tamaño', 'cel', 0, 120, ' px'), slider('Fuerza', 'celA', 0, 100, '%')]),
    el('div', { class: 'row2' }, [color('Color de la sombra', 'celColor'), slider('Suavidad', 'celSoft', 0, 30, ' px')]),
    head('Destellos'),
    el('div', { class: 'row2' }, [slider('Cantidad', 'spark', 0, 120, ''), slider('Tamaño', 'sparkSize', 2, 40, ' px')]),
    color('Color de los destellos', 'sparkColor'),
  ]);
  const r = await dialog({ title: 'Efectos de anime · ' + L.name, body, buttons: [{ label: 'Quitar', value: 'clear', danger: true }, { label: 'Cancelar', value: false }, { label: 'Aplicar', value: true, primary: true }] });
  if (r === true) { L.fx = Object.assign({}, L.fx || {}, x); structural('Efectos de anime'); }
  else if (r === 'clear') {
    const fx = Object.assign({}, L.fx || {});
    for (const k of ['rim', 'cel', 'aura', 'spark']) fx[k] = 0;
    L.fx = fx; structural('Quitar efectos de anime');
  } else { if (before) L.fx = before; else delete L.fx; invalidateAllFrames(); sceneDirty = true; requestRender(); }
  if (animOpen()) renderAnimPanel();
}

/* =========================================================
   Efectos de escena (sobre el cuadro entero, como la cámara de un anime)
   P.scene = {from, to, speed, speedColor, speedX, speedY, shake, bloom, chroma, grain, vignette, flash, flashColor}
   ========================================================= */
function sceneFxOn(f) {
  const s = P && P.scene;
  if (!s) return false;
  if (!(s.speed || s.shake || s.bloom || s.chroma || s.grain || s.vignette || s.flash)) return false;
  const a = Math.max(1, s.from || 1) - 1, b = (s.to || P.frames) - 1;
  return f == null || (f >= a && f <= b);
}
function applySceneFx(cv, f, w, h) {
  const s = P.scene, k = w / P.w, t = ctx2d(cv);
  resetCtx(t);
  // Temblor de cámara
  if (s.shake) {
    const R = seeded(31 * f + 5), m = s.shake * k;
    const dx = (R() * 2 - 1) * m, dy = (R() * 2 - 1) * m, sc = 1 + (2 * m + 2) / Math.min(w, h);
    const c = tmpCanvas('scShake', w, h), ct = resetCtx(ctx2d(c));
    ct.clearRect(0, 0, w, h); ct.drawImage(cv, 0, 0);
    t.clearRect(0, 0, w, h);
    t.setTransform(sc, 0, 0, sc, w / 2 * (1 - sc) + dx, h / 2 * (1 - sc) + dy);
    t.drawImage(c, 0, 0); resetCtx(t);
  }
  // Resplandor (las zonas claras brillan alrededor)
  if (s.bloom) {
    const c = tmpCanvas('scBloom', w, h), ct = resetCtx(ctx2d(c));
    ct.clearRect(0, 0, w, h);
    ct.filter = 'brightness(0.85) contrast(2.4) blur(' + Math.max(2, 14 * k).toFixed(1) + 'px)';
    ct.drawImage(cv, 0, 0); ct.filter = 'none';
    t.globalCompositeOperation = 'screen'; t.globalAlpha = Math.min(1, s.bloom / 100);
    t.drawImage(c, 0, 0); resetCtx(t);
  }
  // Líneas de velocidad / concentración hacia un punto
  if (s.speed) {
    const R = seeded(97 * Math.floor(f / 2) + 13);
    const cx = (s.speedX != null ? s.speedX : 50) / 100 * w, cy = (s.speedY != null ? s.speedY : 50) / 100 * h;
    const far = Math.hypot(Math.max(cx, w - cx), Math.max(cy, h - cy)) * 1.05;
    const n = Math.round(40 + s.speed * 1.6);
    t.fillStyle = s.speedColor || '#ffffff';
    for (let i = 0; i < n; i++) {
      const a = R() * Math.PI * 2, wd = (0.004 + R() * 0.012) * (1 + s.speed / 100);
      const r0 = far * (0.38 + R() * 0.35) * (1.15 - s.speed / 200);
      t.globalAlpha = 0.35 + R() * 0.55;
      t.beginPath();
      t.moveTo(cx + Math.cos(a) * r0, cy + Math.sin(a) * r0);
      t.lineTo(cx + Math.cos(a - wd) * far, cy + Math.sin(a - wd) * far);
      t.lineTo(cx + Math.cos(a + wd) * far, cy + Math.sin(a + wd) * far);
      t.closePath(); t.fill();
    }
    resetCtx(t);
  }
  // Aberración cromática: rojo y azul se separan hacia los bordes
  if (s.chroma) {
    const d = s.chroma * k;
    const ch = (name, col) => {
      const c = tmpCanvas(name, w, h), ct = resetCtx(ctx2d(c));
      ct.clearRect(0, 0, w, h); ct.drawImage(cv, 0, 0);
      ct.globalCompositeOperation = 'multiply'; ct.fillStyle = col; ct.fillRect(0, 0, w, h);
      ct.globalCompositeOperation = 'destination-in'; ct.drawImage(cv, 0, 0);
      return c;
    };
    const r = ch('scR', '#ff0000'), g = ch('scG', '#00ff00'), b = ch('scB', '#0000ff');
    t.clearRect(0, 0, w, h);
    t.globalCompositeOperation = 'lighter';
    t.drawImage(r, -d, 0); t.drawImage(g, 0, 0); t.drawImage(b, d, 0);
    resetCtx(t);
  }
  // Destello de luz que llena la pantalla
  if (s.flash) {
    t.globalCompositeOperation = 'screen'; t.globalAlpha = Math.min(1, s.flash / 100);
    t.fillStyle = s.flashColor || '#ffffff'; t.fillRect(0, 0, w, h); resetCtx(t);
  }
  // Viñeta
  if (s.vignette) {
    const g = t.createRadialGradient(w / 2, h / 2, Math.min(w, h) * 0.35, w / 2, h / 2, Math.hypot(w, h) * 0.55);
    g.addColorStop(0, 'rgba(0,0,0,0)'); g.addColorStop(1, 'rgba(0,0,0,' + Math.min(1, s.vignette / 100) + ')');
    t.fillStyle = g; t.fillRect(0, 0, w, h);
  }
  // Grano de película (cambia en cada cuadro)
  if (s.grain) {
    const n = tmpCanvas('scNoise', 160, 160), nt = resetCtx(ctx2d(n));
    const img = nt.createImageData(160, 160), d = img.data, R = seeded(f * 17 + 3);
    for (let i = 0; i < d.length; i += 4) { const v = R() * 255 | 0; d[i] = d[i + 1] = d[i + 2] = v; d[i + 3] = 255; }
    nt.putImageData(img, 0, 0);
    t.globalCompositeOperation = 'overlay'; t.globalAlpha = Math.min(1, s.grain / 100) * 0.6;
    t.fillStyle = t.createPattern(n, 'repeat'); t.fillRect(0, 0, w, h);
    resetCtx(t);
  }
}

async function sceneFxDialog() {
  if (!P.scene) P.scene = {};
  const x = Object.assign({ from: 1, to: P.frames, speed: 0, speedColor: '#ffffff', speedX: 50, speedY: 50, shake: 0, bloom: 0, chroma: 0, grain: 0, vignette: 0, flash: 0, flashColor: '#ffffff' }, P.scene);
  const before = clone(P.scene);
  const live = () => { P.scene = Object.assign({}, x); invalidateAllFrames(); sceneDirty = true; requestRender(); };
  const slider = (label, key, min, max, unit) => {
    const out = el('output', { text: x[key] + unit });
    const r = el('input', { type: 'range', min: String(min), max: String(max), value: String(x[key]) });
    r.oninput = () => { x[key] = parseFloat(r.value); out.textContent = r.value + unit; live(); };
    return el('label', {}, [el('span', {}, [label + ' ', out]), r]);
  };
  const num = (label, key) => {
    const i = el('input', { type: 'number', min: '1', max: String(P.frames), value: String(x[key]) });
    i.onchange = () => { x[key] = clamp(parseInt(i.value, 10) || 1, 1, P.frames); live(); };
    return el('label', {}, [label, i]);
  };
  const color = (label, key) => {
    const c = el('input', { type: 'color', value: x[key] });
    c.oninput = () => { x[key] = c.value; live(); };
    return el('label', {}, [label, c]);
  };
  const body = el('div', { class: 'form' }, [
    el('p', { class: 'note', text: 'Se aplican a la imagen entera entre esos cuadros: para golpes, transformaciones y ataques. Se ven al reproducir y al exportar.' }),
    el('div', { class: 'row2' }, [num('Desde el cuadro', 'from'), num('Hasta el cuadro', 'to')]),
    slider('Líneas de velocidad', 'speed', 0, 100, '%'),
    el('div', { class: 'row2' }, [slider('Centro X', 'speedX', 0, 100, '%'), slider('Centro Y', 'speedY', 0, 100, '%')]),
    color('Color de las líneas', 'speedColor'),
    slider('Temblor de cámara', 'shake', 0, 60, ' px'),
    slider('Resplandor (bloom)', 'bloom', 0, 100, '%'),
    slider('Aberración cromática', 'chroma', 0, 20, ' px'),
    el('div', { class: 'row2' }, [slider('Destello de luz', 'flash', 0, 100, '%'), color('Color del destello', 'flashColor')]),
    el('div', { class: 'row2' }, [slider('Viñeta', 'vignette', 0, 100, '%'), slider('Grano de película', 'grain', 0, 100, '%')]),
  ]);
  const r = await dialog({ title: 'Efectos de escena', body, buttons: [{ label: 'Quitar todos', value: 'clear', danger: true }, { label: 'Cancelar', value: false }, { label: 'Aplicar', value: true, primary: true }] });
  if (r === true) { P.scene = Object.assign({}, x); structural('Efectos de escena'); }
  else if (r === 'clear') { delete P.scene; structural('Quitar efectos de escena'); }
  else { if (before) P.scene = before; else delete P.scene; invalidateAllFrames(); sceneDirty = true; requestRender(); }
}
/* ---------- 95-proyectos.js ---------- */
/* =========================================================
   Proyectos
   ========================================================= */
async function renderProjects() {
  const list = (await DB.all('projects')).sort((a, b) => b.updated - a.updated);
  const box = $('plist'); box.innerHTML = '';
  $('pempty').hidden = list.length > 0;
  for (const p of list) {
    const img = el('img', { class: 'pthumb', alt: '' });
    img.src = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 9"><rect width="16" height="9" fill="#fff"/></svg>');
    DB.get('thumbs', p.id).then(b => { if (b) { const u = URL.createObjectURL(b); img.onload = () => URL.revokeObjectURL(u); img.src = u; } }).catch(() => { });
    img.onclick = () => openProject(p.id);
    const date = new Date(p.updated).toLocaleDateString('es', { day: 'numeric', month: 'short', year: 'numeric' });
    const info = el('div', { class: 'pinfo' }, [el('b', { text: p.name }), el('small', { text: p.frames + ' cuadros · ' + p.fps + ' fps · ' + p.w + '×' + p.h }), el('small', { text: 'Editado ' + date })]);
    const act = el('div', { class: 'pact' }, [
      el('button', { class: 'btn primary sm', text: 'Abrir', onclick: () => openProject(p.id) }),
      el('button', { class: 'btn sm', text: 'Renombrar', onclick: async () => {
        const inp = el('input', { type: 'text', value: p.name, maxlength: 60, id: 'rnName' });
        const ok = await dialog({ title: 'Renombrar', body: el('div', { class: 'form' }, [el('label', {}, ['Nombre', inp])]), buttons: [{ label: 'Cancelar', value: false }, { label: 'Guardar', value: true, primary: true }] });
        if (ok && inp.value.trim()) { p.name = inp.value.trim().slice(0, 60); await DB.put('projects', p); renderProjects(); }
      } }),
      el('button', { class: 'btn sm', text: 'Duplicar', onclick: () => duplicateProject(p) }),
      el('button', { class: 'btn sm', text: 'Copia', title: 'Guardar una copia de seguridad .artlas', onclick: async () => {
        try { toast('Preparando copia…'); toast(await exportProjectBackup(p.id), 4000); } catch (e) { toast('No se pudo crear la copia: ' + e.message, 4000); }
      } }),
      el('button', { class: 'btn danger sm', text: 'Eliminar', onclick: async () => {
        if (!(await confirmDlg('Eliminar proyecto', '«' + p.name + '» se borrará para siempre con todos sus dibujos y audio.', 'Eliminar', true))) return;
        await DB.delRange('cells', p.id + ':'); await DB.del('audio', p.id); await DB.del('thumbs', p.id); await DB.del('projects', p.id);
        renderProjects(); toast('Proyecto eliminado');
      } }),
    ]);
    box.appendChild(el('div', { class: 'pcard' }, [img, info, act]));
  }
}
$('btnNew').onclick = async () => {
  const name = el('input', { type: 'text', value: 'Mi animación', maxlength: 60, id: 'npName' });
  const res = el('select', { id: 'npRes' }, RES_PRESETS.map(r => el('option', { value: r.id, text: r.label })));
  const fps = el('select', { id: 'npFps' }, [8, 12, 15, 24, 25, 30].map(v => el('option', { value: v, text: v + ' fps', selected: v === 12 })));
  const frames = el('input', { type: 'number', min: 1, max: 5000, value: 24, id: 'npFrames' });
  const body = el('div', { class: 'form' }, [
    el('label', {}, ['Nombre', name]), el('label', {}, ['Tamaño de la hoja', res]),
    el('div', { class: 'row2' }, [el('label', {}, ['Velocidad', fps]), el('label', {}, ['Cuadros', frames])]),
    el('p', { class: 'note', text: '12 fps es lo habitual para animación dibujada a mano («en dos»). 24 fps es el estándar de cine.' }),
  ]);
  const ok = await dialog({ title: 'Nuevo proyecto', body, buttons: [{ label: 'Cancelar', value: false }, { label: 'Crear', value: true, primary: true }] });
  if (!ok) return;
  const r = RES_PRESETS.find(x => x.id === res.value) || RES_PRESETS[0];
  const p = newProjectObject({ name: name.value.trim().slice(0, 60) || 'Mi animación', w: r.w, h: r.h, fps: +fps.value, frames: clamp(parseInt(frames.value, 10) || 24, 1, 5000) });
  await DB.put('projects', p);
  openProject(p.id);
};
async function duplicateProject(p) {
  try {
    toast('Duplicando…');
    const np = JSON.parse(JSON.stringify(p));
    np.id = 'p' + uid(); np.name = (p.name + ' (copia)').slice(0, 60); np.created = np.updated = Date.now();
    const map = new Map();
    for (const L of np.layers) L.cells = L.cells.map(id => { if (!id) return null; if (!map.has(id)) map.set(id, np.id + ':' + uid()); return map.get(id); });
    for (const [o, n] of map) { const blob = await DB.get('cells', o); if (blob) await DB.put('cells', blob, n); }
    const au = await DB.get('audio', p.id); if (au) await DB.put('audio', au, np.id);
    const th = await DB.get('thumbs', p.id); if (th) await DB.put('thumbs', th, np.id);
    await DB.put('projects', np);
    renderProjects(); toast('Proyecto duplicado');
  } catch (e) { toast('No se pudo duplicar: ' + e.message, 4000); }
}
async function openProject(id) {
  try {
    const p = await DB.get('projects', id);
    if (!p) { toast('No se encontró el proyecto'); return; }
    P = normalizeProject(p);
    cur.layer = P.layers.length - 1; cur.frame = 0;
    cache.clear(); loading.clear(); invalidateAllFrames(); clearUndo(); resetStructSnap();
    S = null; MV = null; PB.scale = 1;
    allocWork();
    cur.layer = P.layers.length - 1; cur.frame = 0; TL.scroll = 0;
    $('projects').hidden = true; $('editor').hidden = false;
    $('pname').textContent = P.name;
    setSavedUI(true);
    sceneDirty = true;
    setTool(tool);
    await raf();
    SEL = null; LS = null; SD = null; showSelBar(false);
    toggleTimeline(false); $('layersPanel').hidden = true; $('animPanel').hidden = true; $('btnAnim').classList.remove('on'); animTab = 'layer'; AD = null; $('guidePop').hidden = true; presenting = false; $('editor').classList.remove('present');
    $('btnGuides').classList.toggle('on', symmetry !== 'off' || P.guides !== 'none'); $('btnLayers').classList.remove('on'); closeToolPop();
    sizeStage(); fitView(); buildHeads(); buildStrip(); updateFrameUI();
    loadProjectAudio().then(() => { if (P && P.id === id) { buildHeads(); sizeTimeline(); updateFrameUI(); } });
    cleanupOrphans(P).catch(() => { });
  } catch (e) { console.error(e); toast('No se pudo abrir: ' + e.message, 4000); }
}
async function cleanupOrphans(p) {
  const keys = await DB.keysRange('cells', p.id + ':');
  const used = new Set(); for (const L of p.layers) for (const id of L.cells) if (id) used.add(id);
  for (const k of keys) if (!used.has(k) && !cache.has(k)) await DB.del('cells', k);
}
async function closeProject() {
  stopPlayback();
  if (S) abortStroke();
  commitSel(); LS = null; SD = null;
  if (MV) endMove(true);
  await flushSave();
  while (saving) await sleep(30);
  P = null; structSnap = null; cache.clear(); loading.clear(); invalidateAllFrames(); clearUndo(); freeWork();
  AU.buffer = null; AU.peaks = null;
  if (STRIP.io) STRIP.io.disconnect(); STRIP.els = []; $('strip').innerHTML = '';
  $('editor').hidden = true; $('projects').hidden = false; closeColorPop(); closeToolPop();
  renderProjects();
}
$('btnBack').onclick = closeProject;
window.trazoBack = () => {
  if (!$('modal').hidden) { closeDialog(null); return true; }
  if (presenting) { exitPresent(); return true; }
  if (!$('guidePop').hidden) { $('guidePop').hidden = true; return true; }
  if (!$('colorPop').hidden) { closeColorPop(); return true; }
  if (!$('toolPop').hidden) { closeToolPop(); return true; }
  if (!$('busy').hidden) { busyCancel = true; return true; }
  if (SEL) { commitSel(); return true; }
  if (!$('layersPanel').hidden) { $('btnCloseLayers').click(); return true; }
  if (!$('animPanel').hidden) { toggleAnimPanel(false); return true; }
  if (!$('tl').hidden) { toggleTimeline(false); return true; }
  if (P) { closeProject(); return true; }
  return false;
};

/* ----- proyecto de ejemplo ----- */
async function createSample() {
  const p = newProjectObject({ name: 'Ejemplo: pelota que rebota', w: 1280, h: 720, fps: 12, frames: 12 });
  p.layers[0].name = 'Fondo';
  const ball = { id: uid(), name: 'Pelota', visible: true, locked: false, opacity: 1, cells: [] };
  p.layers.push(ball);
  const put = async (cv) => { const id = p.id + ':' + uid(); await DB.put('cells', await canvasToBlob(cv), id); return id; };
  const bg = mkCanvas(1280, 720), b = ctx2d(bg);
  b.fillStyle = '#dff1ff'; b.fillRect(0, 0, 1280, 520);
  b.fillStyle = '#cfe8b8'; b.fillRect(0, 520, 1280, 200);
  b.strokeStyle = '#2a2a2a'; b.lineWidth = 5; b.lineCap = 'round'; b.beginPath(); b.moveTo(0, 522); b.lineTo(1280, 522); b.stroke();
  b.fillStyle = '#ffd25e'; b.beginPath(); b.arc(1110, 120, 54, 0, Math.PI * 2); b.fill();
  const bgId = await put(bg);
  p.layers[0].cells = new Array(12).fill(bgId);
  for (let i = 0; i < 12; i++) {
    const cv = mkCanvas(1280, 720), c = ctx2d(cv);
    const t = i / 12, hgt = Math.abs(Math.cos(t * Math.PI));
    const x = 200 + t * 880, ground = 520, R = 62;
    const sq = hgt < 0.18 ? 1 - (0.18 - hgt) * 1.7 : 1;
    const y = ground - R * sq - hgt * 300;
    c.fillStyle = 'rgba(40,40,40,.18)'; c.beginPath(); c.ellipse(x, ground + 6, R * (1.25 - hgt * 0.55), 11 * (1.25 - hgt * 0.55), 0, 0, Math.PI * 2); c.fill();
    c.save(); c.translate(x, y); c.scale(1 / sq, sq);
    c.fillStyle = '#e2542f'; c.strokeStyle = '#2a2a2a'; c.lineWidth = 5;
    c.beginPath(); c.arc(0, 0, R, 0, Math.PI * 2); c.fill(); c.stroke();
    c.strokeStyle = '#fff'; c.lineWidth = 7; c.lineCap = 'round'; c.beginPath(); c.arc(-14, -16, 34, Math.PI * 1.05, Math.PI * 1.45); c.stroke();
    c.restore();
    ball.cells.push(await put(cv));
    if (i === 0) {
      const t = mkCanvas(320, 180), tc = ctx2d(t);
      tc.drawImage(bg, 0, 0, 320, 180); tc.drawImage(cv, 0, 0, 320, 180);
      await DB.put('thumbs', await canvasToBlob(t, 'image/jpeg', 0.85), p.id);
    }
  }
  await DB.put('projects', p);
}
/* ---------- 96-copias.js ---------- */
/* =========================================================
   Copias de seguridad .artlas (ZIP propio, sin compresión; también se aceptan .trazo antiguas)
   ========================================================= */
// Los dibujos ya son PNG comprimidos, así que el ZIP los guarda tal cual (método «store»).
const CRC_TABLE = (() => { const t = new Uint32Array(256); for (let n = 0; n < 256; n++) { let c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320 ^ (c >>> 1) : c >>> 1; t[n] = c >>> 0; } return t; })();
function crc32(u8) { let c = 0xFFFFFFFF; for (let i = 0; i < u8.length; i++) c = CRC_TABLE[(c ^ u8[i]) & 255] ^ (c >>> 8); return (c ^ 0xFFFFFFFF) >>> 0; }
function zipBuild(files) { // files: [{name, data:Uint8Array}]
  const enc = new TextEncoder(), parts = [], central = [];
  let off = 0;
  const d = new Date(), dosTime = (d.getHours() << 11) | (d.getMinutes() << 5) | (d.getSeconds() >> 1), dosDate = ((d.getFullYear() - 1980) << 9) | ((d.getMonth() + 1) << 5) | d.getDate();
  for (const f of files) {
    const name = enc.encode(f.name), crc = crc32(f.data), size = f.data.length;
    const h = new DataView(new ArrayBuffer(30));
    h.setUint32(0, 0x04034b50, true); h.setUint16(4, 20, true); h.setUint16(6, 0x0800, true); h.setUint16(8, 0, true);
    h.setUint16(10, dosTime, true); h.setUint16(12, dosDate, true); h.setUint32(14, crc, true); h.setUint32(18, size, true); h.setUint32(22, size, true);
    h.setUint16(26, name.length, true); h.setUint16(28, 0, true);
    parts.push(new Uint8Array(h.buffer), name, f.data);
    const c = new DataView(new ArrayBuffer(46));
    c.setUint32(0, 0x02014b50, true); c.setUint16(4, 20, true); c.setUint16(6, 20, true); c.setUint16(8, 0x0800, true); c.setUint16(10, 0, true);
    c.setUint16(12, dosTime, true); c.setUint16(14, dosDate, true); c.setUint32(16, crc, true); c.setUint32(20, size, true); c.setUint32(24, size, true);
    c.setUint16(28, name.length, true); c.setUint32(42, off, true);
    central.push(new Uint8Array(c.buffer), name);
    off += 30 + name.length + size;
  }
  const cdSize = central.reduce((s, a) => s + a.length, 0);
  const e = new DataView(new ArrayBuffer(22));
  e.setUint32(0, 0x06054b50, true); e.setUint16(8, files.length, true); e.setUint16(10, files.length, true); e.setUint32(12, cdSize, true); e.setUint32(16, off, true);
  const all = parts.concat(central, [new Uint8Array(e.buffer)]);
  const out = new Uint8Array(all.reduce((s, a) => s + a.length, 0));
  let p = 0; for (const a of all) { out.set(a, p); p += a.length; }
  return out;
}
function zipRead(u8) { // → Map(name → {data, ok})
  const v = new DataView(u8.buffer, u8.byteOffset, u8.byteLength), dec = new TextDecoder();
  let eocd = -1;
  for (let i = u8.length - 22; i >= Math.max(0, u8.length - 65557); i--) if (v.getUint32(i, true) === 0x06054b50) { eocd = i; break; }
  if (eocd < 0) throw new Error('El archivo no es una copia de Artlas 2D válida');
  const count = v.getUint16(eocd + 10, true); let p = v.getUint32(eocd + 16, true);
  const out = new Map();
  for (let k = 0; k < count; k++) {
    if (p + 46 > u8.length || v.getUint32(p, true) !== 0x02014b50) throw new Error('El índice del archivo está dañado');
    const method = v.getUint16(p + 10, true), crc = v.getUint32(p + 16, true), size = v.getUint32(p + 20, true);
    const nl = v.getUint16(p + 28, true), el2 = v.getUint16(p + 30, true), cl = v.getUint16(p + 32, true), lo = v.getUint32(p + 42, true);
    const name = dec.decode(u8.subarray(p + 46, p + 46 + nl));
    p += 46 + nl + el2 + cl;
    if (lo + 30 > u8.length || v.getUint32(lo, true) !== 0x04034b50) { out.set(name, { data: null, ok: false }); continue; }
    const start = lo + 30 + v.getUint16(lo + 26, true) + v.getUint16(lo + 28, true);
    if (method !== 0 || start + size > u8.length) { out.set(name, { data: null, ok: false }); continue; }
    const data = u8.subarray(start, start + size);
    out.set(name, { data, ok: crc32(data) === crc });
  }
  return out;
}
async function exportProjectBackup(id) {
  if (P && P.id === id) { commitSel(); await flushSave(); while (saving) await sleep(30); }
  const proj = await DB.get('projects', id);
  if (!proj) throw new Error('No se encontró el proyecto');
  const files = [], enc = new TextEncoder(), ids = new Set();
  for (const L of proj.layers) for (const c of L.cells) if (c) ids.add(c);
  let n = 0;
  for (const cid of ids) {
    const blob = await DB.get('cells', cid);
    if (blob) { files.push({ name: 'cells/' + cid.split(':').pop() + '.png', data: new Uint8Array(await blob.arrayBuffer()) }); n++; }
  }
  const audio = await DB.get('audio', id);
  if (audio) files.push({ name: 'audio.bin', data: new Uint8Array(await audio.arrayBuffer()) });
  const thumb = await DB.get('thumbs', id);
  if (thumb) files.push({ name: 'thumb.jpg', data: new Uint8Array(await thumb.arrayBuffer()) });
  files.unshift({ name: 'project.json', data: enc.encode(JSON.stringify(proj)) });
  files.unshift({ name: 'manifest.json', data: enc.encode(JSON.stringify({ format: 'trazo-project', version: 1, saved: Date.now(), cells: n, audio: !!audio, audioType: audio ? audio.type : '' })) });
  return saveBinary(safeName(proj.name) + '.artlas', 'application/zip', zipBuild(files));
}
async function importProjectBackup(file) {
  const zip = zipRead(new Uint8Array(await file.arrayBuffer()));
  const dec = new TextDecoder();
  const man = zip.get('manifest.json'), pj = zip.get('project.json');
  if (!man || !man.ok || !pj || !pj.ok) throw new Error('Falta o está dañada la información del proyecto');
  const manifest = JSON.parse(dec.decode(man.data));
  if (manifest.format !== 'trazo-project') throw new Error('No es una copia de un proyecto de Artlas 2D');
  if (manifest.version > 1) throw new Error('Esta copia es de una versión más nueva de Artlas 2D. Actualiza la app.');
  const src = JSON.parse(dec.decode(pj.data));
  if (!src || !Array.isArray(src.layers) || !src.w || !src.h) throw new Error('El proyecto de la copia no es válido');
  const p = normalizeProject(src);
  p.id = 'p' + uid(); p.updated = Date.now();
  if (!p.name) p.name = 'Proyecto importado';
  const map = new Map(); let damaged = 0, restored = 0;
  for (const L of p.layers) {
    L.cells = L.cells.map(old => {
      if (!old) return null;
      if (map.has(old)) return map.get(old);
      const e = zip.get('cells/' + String(old).split(':').pop() + '.png');
      if (!e || !e.ok) { damaged++; map.set(old, null); return null; }
      const nid = p.id + ':' + uid(); map.set(old, nid); return nid;
    });
  }
  for (const [old, nid] of map) {
    if (!nid) continue;
    const e = zip.get('cells/' + String(old).split(':').pop() + '.png');
    await DB.put('cells', new Blob([e.data], { type: 'image/png' }), nid); restored++;
  }
  const au = zip.get('audio.bin');
  if (p.audio) {
    if (au && au.ok) await DB.put('audio', new Blob([au.data], { type: manifest.audioType || 'audio/mpeg' }), p.id);
    else { p.audio = null; damaged++; }
  }
  const th = zip.get('thumb.jpg');
  if (th && th.ok) await DB.put('thumbs', new Blob([th.data], { type: 'image/jpeg' }), p.id);
  await DB.put('projects', p);
  return { name: p.name, restored, damaged };
}
$('btnImportProject').onclick = () => $('projectFile').click();
$('projectFile').onchange = async e => {
  const f = e.target.files && e.target.files[0]; e.target.value = '';
  if (!f) return;
  try {
    toast('Importando copia…');
    const r = await importProjectBackup(f);
    await renderProjects();
    if (r.damaged) await dialog({ title: 'Copia importada con daños', body: '«' + r.name + '» se recuperó, pero ' + r.damaged + (r.damaged === 1 ? ' parte estaba dañada y se ha quitado' : ' partes estaban dañadas y se han quitado') + ' (' + r.restored + ' dibujos recuperados).' });
    else toast('Proyecto importado: ' + r.name + ' (' + r.restored + ' dibujos)', 3500);
  } catch (err) { await dialog({ title: 'No se pudo importar', body: String(err.message || err) }); }
};
window.__trazoBackupTest = { zipBuild, zipRead, crc32 };
/* ---------- 99-arranque.js ---------- */
/* =========================================================
   Arranque
   ========================================================= */
(async () => {
  try {
    await DB.open();
    if (navigator.storage && navigator.storage.persist) navigator.storage.persist().catch(() => { });
    let seeded = false; try { seeded = localStorage.getItem('trazo_seeded') === '1'; } catch (e) { }
    if (!seeded) {
      // el proyecto de ejemplo solo se crea para las pruebas automáticas (index.html?ejemplo=1)
      if (new URLSearchParams(location.search).has('ejemplo') && !(await DB.all('projects')).length) await createSample();
      try { localStorage.setItem('trazo_seeded', '1'); } catch (e) { }
    }
    setColor(color); setTool('brush');
    await renderProjects();
    $('projects').hidden = false;
    hideSplash();
  } catch (e) {
    console.error(e);
    document.body.innerHTML = '<p style="padding:24px;color:#fff;font-family:sans-serif">No se pudo iniciar Artlas 2D: ' + escapeHtml(e.message || e) + '</p>';
  }
})();
})();
