    const a = kind === 'grain' ? (g > 0.42 ? 0.3 + 0.7 * g : 0) * Math.min(1, edge * 3) : (g > 0.22 ? 1 : 0.12) * Math.min(1, edge * 4);
    const k = (y * N + x) * 4; d[k] = d[k + 1] = d[k + 2] = 255; d[k + 3] = Math.round(a * 255);
  }
  t.putImageData(img, 0, 0);
  return c;
}
function tipKey(o) {
  if (o.tip === 'image') return TIPS['img:' + o.id] ? 'img:' + o.id : 'soft';
  if (o.tip === 'round') return 'round:' + Math.round((o.hardness == null ? 0.9 : o.hardness) * 20);
  return o.tip || 'soft';
}
function tintedTip(o, col) {
  const key = tipKey(o);
  if (!TIPS[key]) TIPS[key] = key.startsWith('round:') ? makeTip('round', +key.slice(6) / 20) : makeTip(key);
  const s = TIPS[key], c = mkCanvas(s.width, s.height), t = ctx2d(c);
  t.drawImage(s, 0, 0); t.globalCompositeOperation = 'source-in'; t.fillStyle = col; t.fillRect(0, 0, c.width, c.height);
  return c;
}

/* ----- simetría ----- */
function mirrorFns() {
  const f = [p => p];
  if (!P || symmetry === 'off') return f;
  const W = P.w, H = P.h;
  if (symmetry === 'v' || symmetry === 'both') f.push(p => ({ x: W - p.x, y: p.y }));
  if (symmetry === 'h' || symmetry === 'both') f.push(p => ({ x: p.x, y: H - p.y }));
  if (symmetry === 'both') f.push(p => ({ x: W - p.x, y: H - p.y }));
  return f;
