/* ----- borrar celda ----- */
function clearCell() {
  const c = currentCellForEdit(false);
  if (!c) { toast('No hay dibujo en esta celda'); return; }
  const before = crop(c.cv, 0, 0, P.w, P.h);
  ctx2d(c.cv).clearRect(0, 0, P.w, P.h);
  pushUndo({ label: 'Borrar dibujo', cellId: c.id, layerId: c.L.id, frame: cur.frame, created: false, x: 0, y: 0, before, after: crop(c.cv, 0, 0, P.w, P.h) });
