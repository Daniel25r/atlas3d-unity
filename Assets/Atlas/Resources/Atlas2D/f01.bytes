    id: typeof b.id === 'string' && /^c_[a-z0-9]+$/i.test(b.id) ? b.id : 'c_' + uid(),
    name: String(b.name || 'Pincel').slice(0, 24), desc: String(b.desc || 'Personalizado').slice(0, 40), custom: true,
    kind: 'stamp', tip, tipData: tip === 'image' && typeof b.tipData === 'string' && b.tipData.startsWith('data:image/') ? b.tipData : undefined,
    hardness: n(b.hardness, 0, 1, 0.85), spacing: n(b.spacing, 0.02, 1.5, 0.12), flow: n(b.flow, 0.02, 1, 0.8),
    scatter: n(b.scatter, 0, 2, 0), sizeJitter: n(b.sizeJitter, 0, 1, 0), opacityJitter: n(b.opacityJitter, 0, 1, 0),
    rotation: ROT_MODES.some(r => r[0] === b.rotation) ? b.rotation : 'none',
    pressure: b.pressure !== false, pressureFlow: !!b.pressureFlow, speed: !!b.speed, taper: !!b.taper, sizeMul: n(b.sizeMul, 0.2, 4, 1),
  };
}
// Convierte una imagen en punta de pincel de 96 px: usa su transparencia o, si es opaca, lo oscuro pinta.
async function imageToTip(file) {
  const bm = await createImageBitmap(file);
  const N = 96, c = mkCanvas(N, N), t = ctx2d(c, { willReadFrequently: true });
  const s = Math.min(N / bm.width, N / bm.height);
  t.drawImage(bm, (N - bm.width * s) / 2, (N - bm.height * s) / 2, bm.width * s, bm.height * s);
  if (bm.close) bm.close();
