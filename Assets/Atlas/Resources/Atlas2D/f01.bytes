function drawSelOverlayInner(c) {
  const k = 1 / view.z;
  if (LS && LS.pts.length > 1) {
    c.save(); c.lineWidth = 1.6 * k; c.setLineDash([6 * k, 5 * k]); c.beginPath();
    LS.pts.forEach((q, i) => i ? c.lineTo(q.x, q.y) : c.moveTo(q.x, q.y));
