function drawSelOverlay(c) {
  const lm = P && fullLayerMatrix(P.layers[cur.layer], cur.frame);
  if (lm) { c.save(); c.transform(lm.a, lm.b, lm.c, lm.d, lm.e, lm.f); drawSelOverlayInner(c); c.restore(); return; }
