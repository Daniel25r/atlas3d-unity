function toolDown(e) {
  if (!P) return;
  const p = screenToCell(e.offsetX, e.offsetY);
  if (tool === 'picker') { TAP = { pid: e.pointerId, x: e.offsetX, y: e.offsetY, t: performance.now(), run: () => pickColor(screenToWorld(e.offsetX, e.offsetY)) }; return; }
  if (tool === 'fill') { TAP = { pid: e.pointerId, x: e.offsetX, y: e.offsetY, t: performance.now(), run: () => doFill(p) }; return; }
  if (tool === 'move') { startMove(e, p); return; }
  if (tool === 'lasso') { lassoDown(e, p); return; }
