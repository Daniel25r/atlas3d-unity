function copyCell() {
  if (SEL) { clipboard = { cv: cloneCanvas(SEL.cv), cx: SEL.cx, cy: SEL.cy, s: SEL.s, r: SEL.r, flip: SEL.flip }; toast('Selección copiada'); updateFrameUI(); return; }
  const L = P.layers[cur.layer], id = L.cells[cur.frame], cv = id && getCellSync(id);
  const b = cv && contentBox(cv);
  if (!b) { toast('No hay dibujo para copiar en esta capa'); return; }
  const c = mkCanvas(b.w, b.h); ctx2d(c).drawImage(cv, b.x, b.y, b.w, b.h, 0, 0, b.w, b.h);
  clipboard = { cv: c, cx: b.x + b.w / 2, cy: b.y + b.h / 2, s: 1, r: 0, flip: false };
