  if (e.created) L.cells[e.frame] = dir === 'undo' ? null : e.cellId;
  try {
    const cv = await loadCell(e.cellId);
    ctx2d(cv).putImageData(dir === 'undo' ? e.before : e.after, e.x, e.y);
