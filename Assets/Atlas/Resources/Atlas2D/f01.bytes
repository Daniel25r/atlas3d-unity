  stopPlayback(); if (S) abortStroke(); commitSel();
  const c = currentCellForEdit(true); if (!c) return;
  SEL = { cellId: c.id, layerId: c.L.id, frame: cur.frame, created: c.created, before: crop(c.cv, 0, 0, P.w, P.h), cv: cloneCanvas(clipboard.cv),
    cx: clipboard.cx, cy: clipboard.cy, w: clipboard.cv.width, h: clipboard.cv.height, s: clipboard.s, r: clipboard.r, flip: clipboard.flip };
