  catch (e) { toast('No se pudieron guardar los pinceles: memoria llena', 4000); return false; }
}
function sanitizeBrush(b) {
  const n = (v, a, z, d) => { v = Number(v); return Number.isFinite(v) ? clamp(v, a, z) : d; };
  const tip = TIP_KINDS.some(t => t[0] === b.tip) ? b.tip : 'round';
