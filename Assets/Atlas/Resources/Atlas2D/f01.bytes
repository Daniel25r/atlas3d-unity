'use strict';
/* Trazo — motor de animación 2D. ARCHIVO GENERADO: edita src/js/*.js y ejecuta tools/bundle.sh */
(() => {
/* ---------- 00-base.js ---------- */
const $ = id => document.getElementById(id);
const clamp = (v, a, b) => v < a ? a : v > b ? b : v;
const sleep = ms => new Promise(r => setTimeout(r, ms));
const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-5);
const raf = () => new Promise(r => requestAnimationFrame(r));
const LAYER_COLORS = ['#ff9f6b', '#7fc8f8', '#a3e48b', '#f7d070', '#d4a5ff', '#ff8fb1', '#7ee0d0', '#c9b38f'];
const DEFAULT_PALETTE = ['#000000', '#ffffff', '#7f7f7f', '#3a2a1e', '#e2542f', '#f28c28', '#f2c12e', '#7bc043',
  '#2a9d8f', '#3a86ff', '#5e60ce', '#c77dff', '#ff70a6', '#8d5524', '#f1c27d', '#ffdbac'];
const RES_PRESETS = [
  { id: 'hd', label: 'HD 1280 × 720', w: 1280, h: 720 },
  { id: 'fhd', label: 'Full HD 1920 × 1080', w: 1920, h: 1080 },
  { id: 'sq', label: 'Cuadrado 1080 × 1080', w: 1080, h: 1080 },
  { id: 'vert', label: 'Vertical 720 × 1280', w: 720, h: 1280 },
  { id: 'sd', label: 'Ligero 960 × 540', w: 960, h: 540 },
];

/* =========================================================
   Base de datos local (IndexedDB)
   ========================================================= */
const DB = {
  db: null,
  open() {
    return new Promise((res, rej) => {
      const r = indexedDB.open('trazo', 1);
      r.onupgradeneeded = () => {
        const d = r.result;
        d.createObjectStore('projects', { keyPath: 'id' });
        d.createObjectStore('cells');
        d.createObjectStore('audio');
        d.createObjectStore('thumbs');
      };
      r.onsuccess = () => { this.db = r.result; res(); };
      r.onerror = () => rej(r.error);
    });
  },
  req(store, mode, fn) {
    return new Promise((res, rej) => {
      const t = this.db.transaction(store, mode);
      const r = fn(t.objectStore(store));
      let out;
      if (r) r.onsuccess = () => { out = r.result; };
      t.oncomplete = () => res(out);
      t.onerror = () => rej(t.error);
      t.onabort = () => rej(t.error || new Error('Transacción cancelada'));
    });
  },
  get(s, k) { return this.req(s, 'readonly', st => st.get(k)); },
  put(s, v, k) { return this.req(s, 'readwrite', st => k === undefined ? st.put(v) : st.put(v, k)); },
  del(s, k) { return this.req(s, 'readwrite', st => st.delete(k)); },
  all(s) { return this.req(s, 'readonly', st => st.getAll()); },
  keysRange(s, prefix) { return this.req(s, 'readonly', st => st.getAllKeys(IDBKeyRange.bound(prefix, prefix + '￿'))); },
  delRange(s, prefix) { return this.req(s, 'readwrite', st => st.delete(IDBKeyRange.bound(prefix, prefix + '￿'))); },
};

/* =========================================================
   Utilidades de interfaz
   ========================================================= */
let toastT = null;
function toast(msg, ms = 2200) {
  const t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('show'), ms);
}
let dlgResolve = null;
function dialog({ title, body, buttons }) {
  return new Promise(res => {
    if (dlgResolve) dlgResolve(null);
    dlgResolve = res;
    $('dlgTitle').textContent = title || '';
    const b = $('dlgBody'); b.innerHTML = '';
    if (typeof body === 'string') { const p = document.createElement('p'); p.className = 'note'; p.textContent = body; b.appendChild(p); }
    else if (body) b.appendChild(body);
    const bb = $('dlgBtns'); bb.innerHTML = '';
    for (const btn of (buttons || [{ label: 'Aceptar', value: true, primary: true }])) {
      const e = document.createElement('button');
      e.className = 'btn' + (btn.primary ? ' primary' : '') + (btn.danger ? ' danger' : '');
      e.textContent = btn.label;
      e.onclick = () => closeDialog(typeof btn.value === 'function' ? btn.value() : btn.value);
      bb.appendChild(e);
    }
    $('modal').hidden = false;
    const first = b.querySelector('input,select');
    if (first) setTimeout(() => { if (!b.contains(document.activeElement)) first.focus(); }, 30);
  });
}
function closeDialog(v) {
  $('modal').hidden = true;
  const r = dlgResolve; dlgResolve = null;
  if (r) r(v === undefined ? null : v);
}
$('modal').addEventListener('pointerdown', e => { if (e.target === $('modal')) closeDialog(null); });
const confirmDlg = (title, text, okLabel = 'Aceptar', danger = false) =>
  dialog({ title, body: text, buttons: [{ label: 'Cancelar', value: false }, { label: okLabel, value: true, primary: !danger, danger }] });
function el(tag, attrs = {}, kids = []) {
  const e = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) {
    if (k === 'text') e.textContent = v;
    else if (k === 'html') e.innerHTML = v;
    else if (k.startsWith('on')) e[k] = v;
    else if (v === true) e.setAttribute(k, '');
    else if (v !== false && v != null) e.setAttribute(k, v);
  }
  for (const c of [].concat(kids)) if (c) e.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
  return e;
}
const escapeHtml = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

/* busy overlay */
let busyCancel = false;
function busy(on, txt, pct) {
  $('busy').hidden = !on;
  if (on) { $('busyTxt').textContent = txt || 'Trabajando…'; $('busyBar').style.width = Math.round((pct || 0) * 100) + '%'; }
}
$('busyCancel').onclick = () => { busyCancel = true; };
/* ---------- 10-proyecto.js ---------- */
/* =========================================================
   Estado del proyecto
   ========================================================= */
let P = null;                       // proyecto abierto
const cur = { layer: 0, frame: 0 }; // selección
let tool = 'brush', prevTool = 'brush';
const toolSettings = {
  brush: { size: 8, opacity: 100 },
  pencil: { size: 3, opacity: 100 },
  eraser: { size: 30, opacity: 100 },
  shape: { size: 6, opacity: 100 },
};
let stringLen = 0;
let color = '#1f1b16', smoothing = 0.35, fillGap = 2, fillTol = 30, fillAll = true;
let penOnly = false;
let recents = [];
const prefs = (() => { try { return JSON.parse(localStorage.getItem('trazo_prefs') || '{}'); } catch (e) { return {}; } })();
function savePrefs() {
  try { localStorage.setItem('trazo_prefs', JSON.stringify({ toolSettings, color, smoothing, stringLen, fillGap, fillTol, fillAll, penOnly, recents, brushType, symmetry, shapeType, shapeFill, perfMode, selMode, wandTol })); } catch (e) { /* sin almacenamiento */ }
}
if (prefs.toolSettings) for (const k of Object.keys(toolSettings)) Object.assign(toolSettings[k], prefs.toolSettings[k] || {});
if (prefs.color) color = prefs.color;
if (typeof prefs.smoothing === 'number') smoothing = prefs.smoothing;
if (typeof prefs.stringLen === 'number') stringLen = prefs.stringLen;
if (typeof prefs.fillGap === 'number') fillGap = prefs.fillGap;
if (typeof prefs.fillTol === 'number') fillTol = prefs.fillTol;
if (typeof prefs.fillAll === 'boolean') fillAll = prefs.fillAll;
if (typeof prefs.penOnly === 'boolean') penOnly = prefs.penOnly;
if (Array.isArray(prefs.recents)) recents = prefs.recents.slice(0, 10);
const BRUSHES = [
  { id: 'round', name: 'Pincel', desc: 'Grosor según la presión', kind: 'path', pressure: true },
  { id: 'ink', name: 'Tinta', desc: 'Se afina al ir rápido', kind: 'path', pressure: true, speed: true, taper: true },
  { id: 'marker', name: 'Rotulador', desc: 'Plano y translúcido', kind: 'path', marker: true },
  { id: 'graphite', name: 'Grafito', desc: 'Grano de lápiz', kind: 'stamp', tip: 'grain', spacing: 0.16, flow: 0.5, jitter: true, pressure: true },
  { id: 'crayon', name: 'Cera', desc: 'Textura de crayón', kind: 'stamp', tip: 'crayon', spacing: 0.12, flow: 0.85, jitter: true, pressure: true },
  { id: 'air', name: 'Aerógrafo', desc: 'Suave, para sombras', kind: 'stamp', tip: 'soft', spacing: 0.07, flow: 0.09, sizeMul: 2.2, pressureFlow: true },
];
let customBrushes = (() => { try { const a = JSON.parse(localStorage.getItem('trazo_brushes') || '[]'); return Array.isArray(a) ? a.filter(b => b && b.id && b.name) : []; } catch (e) { return []; } })();
const allBrushes = () => BRUSHES.concat(customBrushes);
let brushType = allBrushes().some(b => b.id === prefs.brushType) ? prefs.brushType : 'round';
let symmetry = ['off', 'v', 'h', 'both'].includes(prefs.symmetry) ? prefs.symmetry : 'off';
let shapeType = ['line', 'rect', 'ellipse'].includes(prefs.shapeType) ? prefs.shapeType : 'line';
let shapeFill = prefs.shapeFill === true;
if (!CanvasRenderingContext2D.prototype.roundRect) CanvasRenderingContext2D.prototype.roundRect = function (x, y, w, h) { this.rect(x, y, w, h); };

function newProjectObject({ name, w, h, fps, frames }) {
  const layer = { id: uid(), name: 'Capa 1', visible: true, locked: false, opacity: 1, cells: new Array(frames).fill(null) };
  return {
    id: 'p' + uid(), name, w, h, fps, frames, layers: [layer], audio: null,
    palette: DEFAULT_PALETTE.slice(), onion: { on: true, prev: 2, next: 1 }, loop: true,
    created: Date.now(), updated: Date.now(), version: 1,
  };
}
function normalizeProject(p) {
  p.frames = Math.max(1, p.frames | 0);
  p.fps = clamp(p.fps | 0 || 12, 1, 60);
  if (!Array.isArray(p.layers) || !p.layers.length) p.layers = [{ id: uid(), name: 'Capa 1', visible: true, locked: false, opacity: 1, cells: [] }];
  for (const L of p.layers) {
    if (!Array.isArray(L.cells)) L.cells = [];
    while (L.cells.length < p.frames) L.cells.push(null);
    L.cells.length = p.frames;
    for (let i = 0; i < L.cells.length; i++) if (L.cells[i] === undefined) L.cells[i] = null;
    if (typeof L.opacity !== 'number') L.opacity = 1;
    if (!L.blend) L.blend = 'source-over';
    L.visible = L.visible !== false; L.locked = !!L.locked; L.clip = !!L.clip; L.alphaLock = !!L.alphaLock;
  }
  if (!p.onion) p.onion = { on: true, prev: 2, next: 1 };
  if (!Array.isArray(p.palette)) p.palette = DEFAULT_PALETTE.slice();
  p.layers = reorderLayersOf(p.layers);
  if (!p.layers.some(L => !isGroup(L))) p.layers.unshift({ id: uid(), name: 'Capa 1', visible: true, locked: false, opacity: 1, cells: new Array(p.frames).fill(null) });
  if (!p.camera || typeof p.camera !== 'object') p.camera = { keys: {} };
  if (!p.camera.keys) p.camera.keys = {};
  if (typeof p.loop !== 'boolean') p.loop = true;
  if (!/^#[0-9a-f]{6}$/i.test(p.paper || '')) p.paper = '#ffffff';
  if (!['none', 'grid', 'thirds', 'safe'].includes(p.guides)) p.guides = 'none';
  return p;
}
const newCellId = () => P.id + ':' + uid();

/* =========================================================
   Lienzos de trabajo y caché de dibujos
   ========================================================= */
function mkCanvas(w, h) { const c = document.createElement('canvas'); c.width = w; c.height = h; return c; }
const ctx2d = (c, opts) => c.getContext('2d', opts);
let belowCv, aboveCv, strokeCv, backupCv, tintCv, workCv;
function allocWork() {
  belowCv = mkCanvas(P.w, P.h); aboveCv = mkCanvas(P.w, P.h); strokeCv = mkCanvas(P.w, P.h);
  backupCv = mkCanvas(P.w, P.h); tintCv = mkCanvas(P.w, P.h); workCv = mkCanvas(P.w, P.h);
}
function freeWork() { belowCv = aboveCv = strokeCv = backupCv = tintCv = workCv = null; }

const cache = new Map();   // cellId -> {cv, dirty, used}
const loading = new Map(); // cellId -> Promise<canvas>
let useTick = 0;
const cellBytes = () => P.w * P.h * 4;

function getCellSync(id) {
  const e = cache.get(id);
  if (!e) return null;
  e.used = ++useTick;
  return e.cv;
}
function loadCell(id) {
  const e = cache.get(id);
  if (e) { e.used = ++useTick; return Promise.resolve(e.cv); }
  if (loading.has(id)) return loading.get(id);
  const projAtStart = P;
  const p = DB.get('cells', id).then(async blob => {
    if (P !== projAtStart) throw new Error('Proyecto cerrado');
    const cv = mkCanvas(P.w, P.h);
    if (blob) {
      const bm = await createImageBitmap(blob);
      ctx2d(cv).drawImage(bm, 0, 0);
      if (bm.close) bm.close();
    }
    if (P !== projAtStart) throw new Error('Proyecto cerrado');
    const ex = cache.get(id);
    loading.delete(id);
    if (ex) return ex.cv; // se creó mientras cargaba
    cache.set(id, { cv, dirty: false, used: ++useTick });
    trimCache();
    return cv;
  }).catch(err => { loading.delete(id); throw err; });
  loading.set(id, p);
  return p;
}
function createCell() {
  const id = newCellId();
  cache.set(id, { cv: mkCanvas(P.w, P.h), dirty: true, used: ++useTick });
  return id;
}
function markCellDirty(id) {
  const e = cache.get(id);
  if (e) { e.dirty = true; e.used = ++useTick; }
  scheduleSave();
}
function protectedIds() {
  const s = new Set();
  if (!P) return s;
  for (const L of P.layers) { const id = L.cells[cur.frame]; if (id) s.add(id); }
  for (const id of onionIds()) s.add(id);
  if (S && S.cellId) s.add(S.cellId);
  for (const u of undoStack) s.add(u.cellId);
  return s;
}
function trimCache() {
  if (!P) return;
  const prot = protectedIds();
  const maxCells = Math.max(Math.floor(PERF.cacheMB * MB / cellBytes()), prot.size + 6);
  if (cache.size <= maxCells) return;
  const cand = [...cache.entries()].filter(([id, e]) => !e.dirty && !prot.has(id)).sort((a, b) => a[1].used - b[1].used);
  let i = 0;
  while (cache.size > maxCells && i < cand.length) cache.delete(cand[i++][0]);
}

/* =========================================================
   Guardado automático
   ========================================================= */
let saveTimer = null, saving = false, saveAgain = false, savedOk = true;
function setSavedUI(ok) { savedOk = ok; const s = $('saved'); s.classList.toggle('pending', !ok); s.title = ok ? 'Todo guardado' : 'Guardando…'; }
function scheduleSave() {
  if (!P) return;
  P.updated = Date.now();
  if (typeof structSnap !== 'undefined' && structSnap) structSnap = snapStructure(); // la «foto» sigue al estado real
  setSavedUI(false);
  clearTimeout(saveTimer);
  saveTimer = setTimeout(flushSave, 900);
}
const canvasToBlob = (cv, type = 'image/png', q) => new Promise((res, rej) => cv.toBlob(b => b ? res(b) : rej(new Error('No se pudo codificar la imagen')), type, q));
async function flushSave() {
  clearTimeout(saveTimer);
  if (!P) return;
  if (saving) { saveAgain = true; return; }
  saving = true;
  const proj = P;
  try {
    for (const [id, e] of [...cache.entries()]) {
      if (!e.dirty) continue;
      e.dirty = false;
      try { await DB.put('cells', await canvasToBlob(e.cv), id); }
      catch (err) { e.dirty = true; throw err; }
    }
    await DB.put('projects', JSON.parse(JSON.stringify(proj)));
    if (P === proj) await saveThumb();
    if (P === proj) setSavedUI(true);
  } catch (err) {
    console.error(err);
    toast('No se pudo guardar: ' + (err && err.message || err), 4000);
  } finally {
    saving = false;
    if (saveAgain) { saveAgain = false; flushSave(); }
  }
}
let thumbBusy = false;
async function saveThumb() {
  if (thumbBusy || !P) return;
  thumbBusy = true;
  try {
    const tw = 320, th = Math.max(1, Math.round(320 * P.h / P.w));
    const c = mkCanvas(tw, th);
    await compositeFrameAsync(ctx2d(c), 0, tw, th, true);
    await DB.put('thumbs', await canvasToBlob(c, 'image/jpeg', 0.8), P.id);
  } catch (e) { /* miniatura opcional */ } finally { thumbBusy = false; }
}
window.trazoFlush = () => { try { commitSel(); } catch (e) { } flushSave(); };
document.addEventListener('visibilitychange', () => { if (document.hidden) { stopPlayback(); try { commitSel(); } catch (e) { } flushSave(); } });

/* =========================================================
   Composición de cuadros
   ========================================================= */
async function compositeFrameAsync(c, f, w, h, bg, useCamera) {
  // se guardan referencias locales para que la caché no libere un dibujo entre dos esperas
  const local = new Map();
  for (const L of P.layers) { const id = L.cells[f]; if (L.visible && id && !local.has(id)) local.set(id, await loadCell(id)); }
  c.save(); c.setTransform(1, 0, 0, 1, 0, 0); c.globalAlpha = 1; c.globalCompositeOperation = 'source-over';
  if (bg) { c.fillStyle = P.paper || '#ffffff'; c.fillRect(0, 0, w, h); } else c.clearRect(0, 0, w, h);
  if (useCamera && cameraActive()) { const m = cameraMatrix(f, w, h); c.transform(m.a, m.b, m.c, m.d, m.e, m.f); composeLayers(c, f, P.w, P.h, id => local.get(id), false); }
  else composeLayers(c, f, w, h, id => local.get(id), false);
  c.restore();
  if (useCamera && sceneFxOn(f)) applySceneFx(c.canvas, f, w, h);
}
function onionFrames() {
  const none = { prev: [], next: [], light: [], ibPrev: null, ibNext: null };
  if (!P) return none;
  const o = onionOpts();
  const light = o.light && P.light ? P.light.slice() : [];
  const L = P.layers[cur.layer];
  if (!L || !L.visible) return Object.assign(none, { light });
  const curId = L.cells[cur.frame];
  const seen = new Set(curId ? [curId] : []);
  const isKey = id => { const m = markOf(id); return m === 'K' || m === 'B'; };
  const collect = (dir, count, onlyKeys) => {
    const out = []; let f = cur.frame + dir;
    while (out.length < count && f >= 0 && f < P.frames) {
      const id = L.cells[f];
      if (id && !seen.has(id) && (!onlyKeys || isKey(id))) { seen.add(id); out.push(id); }
      f += dir;
    }
    return out;
  };
  const r = { prev: [], next: [], light, ibPrev: null, ibNext: null };
  if (o.ib) { r.ibPrev = collect(-1, 1, true)[0] || null; r.ibNext = collect(1, 1, true)[0] || null; }
  if (P.onion.on) { r.prev = collect(-1, o.prev, o.keys); r.next = collect(1, o.next, o.keys); }
  return r;
}
function onionIds() { const o = onionFrames(); const a = o.prev.concat(o.next, o.light); if (o.ibPrev) a.push(o.ibPrev); if (o.ibNext) a.push(o.ibNext); return a; }

let sceneDirty = true, sceneLoading = false;
function rebuildScene() {
  const f = cur.frame;
  const needed = [];
  for (const L of P.layers) if (L.visible && L.cells[f]) needed.push(L.cells[f]);
  const on = onionFrames();
  needed.push(...on.prev, ...on.next);
  const missing = needed.filter(id => !cache.has(id));
  if (missing.length) {
    if (!sceneLoading) {
      sceneLoading = true;
      Promise.all(missing.map(id => loadCell(id).catch(() => null))).finally(() => { sceneLoading = false; sceneDirty = true; requestRender(); });
    }
    return false;
  }
  const b = ctx2d(belowCv);
  b.setTransform(1, 0, 0, 1, 0, 0); b.globalAlpha = 1; b.globalCompositeOperation = 'source-over';
  b.fillStyle = P.paper; b.fillRect(0, 0, P.w, P.h);
  for (let i = 0; i < cur.layer; i++) {
    const L = P.layers[i]; if (!L.visible || !L.cells[f]) continue;
    b.globalAlpha = L.opacity; b.globalCompositeOperation = L.blend || 'source-over'; b.drawImage(getCellSync(L.cells[f]), 0, 0);
  }
  b.globalCompositeOperation = 'source-over';
  drawOnionInto(b);
  return true;
}
/* ---------- 12-rendimiento.js ---------- */
/* =========================================================
   Perfiles de rendimiento (Bajo / Equilibrado / Alto)
   ========================================================= */
// Límites que dependen de la memoria del dispositivo. Todo el motor los lee de aquí.
const PERF_PROFILES = {
  low: { id: 'low', name: 'Bajo', desc: 'Teléfonos modestos: menos memoria, previsualización más ligera', cacheMB: 90, undoMB: 50, undoSteps: 25, previewMax: 640, playbackMB: 120, dprMax: 1, exportMB: 120 },
  mid: { id: 'mid', name: 'Equilibrado', desc: 'Gama media: buen equilibrio entre fluidez y calidad', cacheMB: 200, undoMB: 130, undoSteps: 50, previewMax: 960, playbackMB: 280, dprMax: 1.5, exportMB: 220 },
  high: { id: 'high', name: 'Alto', desc: 'Teléfonos potentes y tablets: más historial y previsualización nítida', cacheMB: 380, undoMB: 260, undoSteps: 100, previewMax: 1280, playbackMB: 520, dprMax: 2, exportMB: 400 },
};
function detectPerfProfile() {
  const mem = navigator.deviceMemory || 4;          // GB (Chrome lo redondea y limita a 8)
  const cores = navigator.hardwareConcurrency || 4;
  if (mem <= 2 || (mem <= 3 && cores <= 4)) return 'low';
  if (mem >= 6 && cores >= 6) return 'high';
  return 'mid';
}
let perfMode = ['auto', 'low', 'mid', 'high'].includes(prefs.perfMode) ? prefs.perfMode : 'auto';
let PERF = PERF_PROFILES[perfMode === 'auto' ? detectPerfProfile() : perfMode];
const MB = 1024 * 1024;
function applyPerfMode(mode) {
  perfMode = mode;
  PERF = PERF_PROFILES[mode === 'auto' ? detectPerfProfile() : mode];
  savePrefs();
  if (typeof P !== 'undefined' && P) {
    invalidateAllFrames();
    trimCache();
    trimUndo();
    sizeStage();
    requestRender();
  }
}
async function perfDialog() {
  const auto = PERF_PROFILES[detectPerfProfile()];
  const sel = el('select', { id: 'perfSel' }, [
    el('option', { value: 'auto', text: 'Automático (detectado: ' + auto.name + ')', selected: perfMode === 'auto' }),
    ...Object.values(PERF_PROFILES).map(p => el('option', { value: p.id, text: p.name, selected: perfMode === p.id })),
  ]);
  const info = el('p', { class: 'note' });
  const show = () => { const p = sel.value === 'auto' ? auto : PERF_PROFILES[sel.value]; info.textContent = p.desc + '. Historial: ' + p.undoSteps + ' pasos · memoria de dibujos: ' + p.cacheMB + ' MB · previsualización hasta ' + p.previewMax + ' px.'; };
  sel.onchange = show; show();
  const dev = el('p', { class: 'note', text: 'Este dispositivo: ' + (navigator.deviceMemory ? '≈' + navigator.deviceMemory + ' GB de RAM' : 'RAM desconocida') + ' · ' + (navigator.hardwareConcurrency || '?') + ' núcleos.' });
  const ok = await dialog({ title: 'Rendimiento', body: el('div', { class: 'form' }, [el('label', {}, ['Perfil', sel]), info, dev]), buttons: [{ label: 'Cancelar', value: false }, { label: 'Aplicar', value: true, primary: true }] });
