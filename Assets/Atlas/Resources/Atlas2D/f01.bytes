/* ----- operaciones ----- */
function newFolder() {
  const L = P.layers[cur.layer];
  const n = P.layers.filter(isGroup).length + 1;
  const G = { id: uid(), type: 'group', name: 'Carpeta ' + n, visible: true, locked: false, opacity: 1, blend: 'source-over', collapsed: false, parent: L.parent || null, cells: new Array(P.frames).fill(null) };
  P.layers.splice(cur.layer + 1, 0, G);
  L.parent = G.id;
  reorderLayers();
  cur.layer = P.layers.indexOf(G);
  structural('Nueva carpeta'); toast('Carpeta creada con «' + L.name + '» dentro');
}
function leaveFolder() {
  const L = P.layers[cur.layer], G = L.parent && layerById(L.parent);
  if (!G) { toast('Esta capa no está dentro de una carpeta'); return; }
  // sale justo por encima de la carpeta
  const block = isGroup(L) ? [...descendantsOf(L), L] : [L];
  P.layers = P.layers.filter(x => !block.includes(x));
  const gi = P.layers.indexOf(G);
  P.layers.splice(gi + 1, 0, ...block);
