  const L = P.layers[cur.layer];
  const folders = P.layers.filter(g => isGroup(g) && g !== L && !isDescendant(g, L) && g.id !== L.parent);
  if (!folders.length) { toast('No hay otra carpeta a la que mover esta capa'); return; }
  const sel = el('select', { id: 'mvFolder' }, folders.map(g => el('option', { value: g.id, text: '  '.repeat(depthOf(g)) + g.name })));
  const ok = await dialog({ title: 'Mover a carpeta', body: el('div', { class: 'form' }, [el('label', {}, ['Carpeta', sel])]), buttons: [{ label: 'Cancelar', value: false }, { label: 'Mover', value: true, primary: true }] });
  if (!ok) return;
  const G = layerById(sel.value);
  const block = isGroup(L) ? [...descendantsOf(L), L] : [L];
  P.layers = P.layers.filter(x => !block.includes(x));
  P.layers.splice(P.layers.indexOf(G), 0, ...block); // arriba del todo dentro de la carpeta
