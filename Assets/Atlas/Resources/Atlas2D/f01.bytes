/* ---------- 30-dibujo.js ---------- */
/* =========================================================
   Herramientas de dibujo
   ========================================================= */
let S = null;   // trazo activo
let MV = null;  // movimiento activo
function currentCellForEdit(createIfMissing) {
  const L = P.layers[cur.layer];
  if (isGroup(L)) { toast('«' + L.name + '» es una carpeta: elige una capa de dentro para dibujar'); return null; }
  if (effLocked(L)) { toast('La capa «' + L.name + '» (o su carpeta) está bloqueada'); return null; }
  if (!effVisible(L)) { toast('La capa «' + L.name + '» (o su carpeta) está oculta'); return null; }
  let id = L.cells[cur.frame], created = false;
  if (!id) {
    if (!createIfMissing) return null;
    id = createCell(); L.cells[cur.frame] = id; created = true;
  }
  const cv = getCellSync(id);
  if (!cv) { loadCell(id).then(() => { sceneDirty = true; requestRender(); }); toast('Cargando dibujo…'); return null; }
  return { L, id, cv, created };
}
function pressureOf(e) { return e.pointerType === 'pen' && e.pressure > 0 ? e.pressure : 1; }
const brushDef = () => allBrushes().find(b => b.id === brushType) || BRUSHES[0];

/* ----- puntas de pincel con textura ----- */
const TIPS = {};
function makeTip(kind, hardness) {
  const N = 96, c = mkCanvas(N, N), t = ctx2d(c), r = N / 2;
  if (kind === 'round') { // punta redonda con dureza ajustable
    const h = clamp(hardness == null ? 0.9 : hardness, 0, 0.98);
    const g = t.createRadialGradient(r, r, 0, r, r, r);
    g.addColorStop(0, 'rgba(255,255,255,1)'); g.addColorStop(h, 'rgba(255,255,255,1)'); g.addColorStop(1, 'rgba(255,255,255,0)');
    t.fillStyle = g; t.fillRect(0, 0, N, N); return c;
  }
  if (kind === 'soft') {
    const g = t.createRadialGradient(r, r, 0, r, r, r);
    g.addColorStop(0, 'rgba(255,255,255,1)'); g.addColorStop(0.45, 'rgba(255,255,255,.5)'); g.addColorStop(1, 'rgba(255,255,255,0)');
    t.fillStyle = g; t.fillRect(0, 0, N, N); return c;
  }
  const img = t.createImageData(N, N), d = img.data;
  let seed = kind === 'grain' ? 7 : 13;
  const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
  for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
    const dx = (x + 0.5 - r) / r, dy = (y + 0.5 - r) / r, dd = Math.sqrt(dx * dx + dy * dy);
    const edge = kind === 'crayon' ? 1 - dd + (rnd() - 0.5) * 0.4 : 1 - dd;
    if (edge <= 0) continue;
