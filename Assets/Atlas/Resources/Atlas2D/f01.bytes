/* ---------- 45-controles.js ---------- */
/* =========================================================
   Herramientas y controles
   ========================================================= */
function setTool(t, keepSel) {
  if (t !== 'lasso' && SEL && !keepSel) commitSel();
  if (t !== 'lasso') { LS = null; SD = null; }
  if (t !== tool) prevTool = tool;
  tool = t;
  for (const b of document.querySelectorAll('.tool')) b.classList.toggle('on', b.dataset.tool === t);
  $('sliders').hidden = !toolSettings[t];
  if (toolSettings[t]) { sizeSlider.draw(); opSlider.draw(); $('opSlider').classList.toggle('dis', t === 'eraser'); }
  stage.style.cursor = t === 'move' ? 'move' : t === 'picker' ? 'copy' : 'crosshair';
  requestRender();
}
for (const b of document.querySelectorAll('.tool')) b.onclick = () => { if (tool === b.dataset.tool) { $('toolPop').hidden ? openToolPop(b) : closeToolPop(); } else { closeToolPop(); setTool(b.dataset.tool); } };
$('stringLen').value = stringLen; $('stringLenV').textContent = stringLen;
$('stringLen').oninput = e => { stringLen = +e.target.value; $('stringLenV').textContent = e.target.value; savePrefs(); };
$('smooth').oninput = e => { smoothing = e.target.value / 100; $('smoothV').textContent = e.target.value; savePrefs(); };
$('gap').oninput = e => { fillGap = +e.target.value; $('gapV').textContent = fillGap; savePrefs(); };
$('tol').oninput = e => { fillTol = +e.target.value; $('tolV').textContent = fillTol; savePrefs(); };
$('fillAll').onchange = e => { fillAll = e.target.checked; savePrefs(); };
$('smooth').value = Math.round(smoothing * 100); $('smoothV').textContent = Math.round(smoothing * 100);
$('gap').value = fillGap; $('gapV').textContent = fillGap; $('tol').value = fillTol; $('tolV').textContent = fillTol; $('fillAll').checked = fillAll;
$('btnUndo').onclick = undo; $('btnRedo').onclick = redo;
/* ---------- 50-color.js ---------- */
/* =========================================================
   Color
   ========================================================= */
const hsv = { h: 0, s: 0, v: 0 };
function hexToRgb(h) { const n = parseInt(h.slice(1), 16); return [n >> 16, (n >> 8) & 255, n & 255]; }
function rgbToHex(r, g, b) { return '#' + [r, g, b].map(v => clamp(Math.round(v), 0, 255).toString(16).padStart(2, '0')).join(''); }
function rgbToHsv(r, g, b) {
  r /= 255; g /= 255; b /= 255;
  const mx = Math.max(r, g, b), mn = Math.min(r, g, b), d = mx - mn;
  let h = 0;
  if (d) { if (mx === r) h = ((g - b) / d) % 6; else if (mx === g) h = (b - r) / d + 2; else h = (r - g) / d + 4; h *= 60; if (h < 0) h += 360; }
  return { h, s: mx ? d / mx : 0, v: mx };
}
function hsvToRgb(h, s, v) {
  const c = v * s, x = c * (1 - Math.abs((h / 60) % 2 - 1)), m = v - c;
  let r = 0, g = 0, b = 0;
  if (h < 60) [r, g, b] = [c, x, 0]; else if (h < 120) [r, g, b] = [x, c, 0]; else if (h < 180) [r, g, b] = [0, c, x];
  else if (h < 240) [r, g, b] = [0, x, c]; else if (h < 300) [r, g, b] = [x, 0, c]; else [r, g, b] = [c, 0, x];
  return [(r + m) * 255, (g + m) * 255, (b + m) * 255];
}
function setColor(hex, fromPicker) {
  if (!/^#[0-9a-f]{6}$/i.test(hex)) return;
  color = hex.toLowerCase();
  $('colorChip').style.background = color; $('cprev').style.background = color;
  if (document.activeElement !== $('hexIn')) $('hexIn').value = color;
  if (!fromPicker) Object.assign(hsv, rgbToHsv(...hexToRgb(color)));
  drawPickers(); savePrefs();
}
function addRecent(c) {
  recents = [c, ...recents.filter(x => x !== c)].slice(0, 10);
  savePrefs();
  if (!$('colorPop').hidden) renderSwatches();
}
function drawPickers() {
  const sv = $('svPick'), t = sv.getContext('2d');
  const [r, g, b] = hsvToRgb(hsv.h, 1, 1);
  t.fillStyle = rgbToHex(r, g, b); t.fillRect(0, 0, sv.width, sv.height);
  let gr = t.createLinearGradient(0, 0, sv.width, 0); gr.addColorStop(0, '#fff'); gr.addColorStop(1, 'rgba(255,255,255,0)'); t.fillStyle = gr; t.fillRect(0, 0, sv.width, sv.height);
  gr = t.createLinearGradient(0, 0, 0, sv.height); gr.addColorStop(0, 'rgba(0,0,0,0)'); gr.addColorStop(1, '#000'); t.fillStyle = gr; t.fillRect(0, 0, sv.width, sv.height);
  const cx = hsv.s * sv.width, cy = (1 - hsv.v) * sv.height;
  t.lineWidth = 2; t.strokeStyle = hsv.v > 0.5 ? '#000' : '#fff'; t.beginPath(); t.arc(cx, cy, 6, 0, Math.PI * 2); t.stroke();
  const hp = $('huePick'), u = hp.getContext('2d');
  const hg = u.createLinearGradient(0, 0, hp.width, 0);
  for (let i = 0; i <= 6; i++) hg.addColorStop(i / 6, rgbToHex(...hsvToRgb((i * 60) % 360, 1, 1)));
  u.fillStyle = hg; u.fillRect(0, 0, hp.width, hp.height);
  const hx = hsv.h / 360 * hp.width;
  u.lineWidth = 3; u.strokeStyle = '#fff'; u.strokeRect(hx - 3, 1, 6, hp.height - 2);
}
function pickerDrag(canvas, fn) {
  canvas.addEventListener('pointerdown', e => {
    canvas.setPointerCapture(e.pointerId);
    const go = ev => { const r = canvas.getBoundingClientRect(); fn(clamp((ev.clientX - r.left) / r.width, 0, 1), clamp((ev.clientY - r.top) / r.height, 0, 1)); };
    go(e);
    const mv = ev => go(ev);
    const up = () => { canvas.removeEventListener('pointermove', mv); canvas.removeEventListener('pointerup', up); canvas.removeEventListener('pointercancel', up); addRecent(color); };
    canvas.addEventListener('pointermove', mv); canvas.addEventListener('pointerup', up); canvas.addEventListener('pointercancel', up);
  });
}
pickerDrag($('svPick'), (x, y) => { hsv.s = x; hsv.v = 1 - y; setColor(rgbToHex(...hsvToRgb(hsv.h, hsv.s, hsv.v)), true); });
pickerDrag($('huePick'), x => { hsv.h = Math.min(359.9, x * 360); setColor(rgbToHex(...hsvToRgb(hsv.h, hsv.s, hsv.v)), true); });
$('hexIn').addEventListener('input', e => { let v = e.target.value.trim(); if (v[0] !== '#') v = '#' + v; if (/^#[0-9a-f]{6}$/i.test(v)) setColor(v); });
$('btnAddSwatch').onclick = () => {
  if (!P) return;
  if (!P.palette.includes(color)) { P.palette.push(color); scheduleSave(); renderSwatches(); toast('Color guardado en la paleta del proyecto'); }
};
function swatch(c, onPick, onLong) {
  const b = el('button', { title: c + (onLong ? ' (mantén pulsado para quitar)' : ''), 'aria-label': 'Color ' + c });
  b.style.background = c;
  let lt = null, long = false;
  b.onpointerdown = () => { long = false; if (onLong) lt = setTimeout(() => { long = true; onLong(); }, 600); };
  b.onpointerup = b.onpointerleave = () => clearTimeout(lt);
  b.onclick = () => { if (!long) onPick(); };
  return b;
}
function renderSwatches() {
  const s = $('swatches'); s.innerHTML = '';
  for (const c of (P ? P.palette : DEFAULT_PALETTE)) s.appendChild(swatch(c, () => setColor(c), P ? () => { P.palette = P.palette.filter(x => x !== c); scheduleSave(); renderSwatches(); toast('Color quitado de la paleta'); } : null));
  const r = $('recents'); r.innerHTML = '';
  for (const c of recents) r.appendChild(swatch(c, () => setColor(c)));
}
function openColorPop() {
  const pop = $('colorPop'), b = $('btnColor').getBoundingClientRect();
  renderSwatches(); drawPickers();
  pop.hidden = false;
  const pw = pop.offsetWidth, ph = pop.offsetHeight;
  pop.style.left = clamp(b.right + 12, 8, innerWidth - pw - 8) + 'px';
  pop.style.top = clamp(b.top + b.height / 2 - ph / 2, 8, innerHeight - ph - 8) + 'px';
}
function closeColorPop() { $('colorPop').hidden = true; }
$('btnColor').onclick = e => { e.stopPropagation(); $('colorPop').hidden ? openColorPop() : closeColorPop(); };
document.addEventListener('pointerdown', e => { if (!$('colorPop').hidden && !$('colorPop').contains(e.target) && e.target !== $('btnColor') && !$('btnColor').contains(e.target)) closeColorPop(); });
/* ---------- 60-tiempo.js ---------- */
/* =========================================================
   Línea de tiempo
   ========================================================= */
const TL = { cw: 26, rh: 34, rulerH: 24, audioH: 42, scroll: 0, w: 0, h: 0 };
const tlc = $('tlc'), tctx = tlc.getContext('2d');
function tlHeight() { return TL.rulerH + visibleRows().length * TL.rh + (AU.buffer ? TL.audioH : 0); }
function sizeTimeline() {
  if (!P) return;
  const w = $('tlcwrap').getBoundingClientRect().width;
  if (w < 2) return;
  TL.w = w; TL.h = tlHeight();
  const d = Math.min(window.devicePixelRatio || 1, PERF.dprMax);
  tlc.width = Math.round(w * d); tlc.height = Math.round(TL.h * d);
  tlc.style.width = w + 'px'; tlc.style.height = TL.h + 'px';
  TL.dpr = d;
  clampScroll(); drawTimeline();
}
new ResizeObserver(sizeTimeline).observe($('tlcwrap'));
function clampScroll() { const max = Math.max(0, P.frames * TL.cw - TL.w + TL.cw * 2); TL.scroll = clamp(TL.scroll, 0, max); }
function ensureFrameVisible() {
  if (!TL.w) return;
  const x = cur.frame * TL.cw;
  if (x < TL.scroll) TL.scroll = x - TL.cw;
  else if (x + TL.cw > TL.scroll + TL.w) TL.scroll = x + TL.cw * 2 - TL.w;
  clampScroll();
}
function drawTimeline() {
  if (!P || !TL.w) return;
  if (Math.abs(TL.h - tlHeight()) > 0.5) { sizeTimeline(); return; }
  const c = tctx, w = TL.w, cw = TL.cw;
  c.setTransform(TL.dpr, 0, 0, TL.dpr, 0, 0);
  c.fillStyle = '#1c1c20'; c.fillRect(0, 0, w, TL.h);
  const f0 = Math.max(0, Math.floor(TL.scroll / cw)), f1 = Math.min(P.frames - 1, Math.ceil((TL.scroll + w) / cw));
  const endX = P.frames * cw - TL.scroll;
  if (endX < w) { c.fillStyle = '#141416'; c.fillRect(endX, 0, w - endX, TL.h); }
  // regla
  c.fillStyle = '#18181b'; c.fillRect(0, 0, Math.min(w, endX), TL.rulerH);
  c.font = '600 10px system-ui,sans-serif'; c.textAlign = 'center'; c.textBaseline = 'middle';
  for (let f = f0; f <= f1; f++) {
    const x = f * cw - TL.scroll;
    const sec = (f % P.fps) === 0;
    c.fillStyle = sec ? '#5d6271' : '#3a3e48';
    c.fillRect(x, sec ? 4 : TL.rulerH - 7, 1, sec ? TL.rulerH - 4 : 7);
    if (f === 0 || (f + 1) % 5 === 0) { c.fillStyle = '#9a9fb0'; c.fillText(String(f + 1), x + cw / 2, TL.rulerH / 2); }
  }
  // capas (arriba = capa superior)
  const rows = visibleRows(), n = rows.length;
  for (let r = 0; r < n; r++) {
    const li = rows[r], L = P.layers[li], y = TL.rulerH + r * TL.rh;
    if (isGroup(L)) { // fila de carpeta: franja sin cuadros
      c.fillStyle = li === cur.layer ? 'rgba(157,92,255,.16)' : '#232029'; c.fillRect(0, y, Math.min(w, endX), TL.rh);
      c.fillStyle = '#2a2a30'; c.fillRect(0, y + TL.rh - 1, w, 1);
      for (let f = f0; f <= f1; f++) if (anyKeyAt(L.keys, f)) { const x = f * cw - TL.scroll; c.fillStyle = '#ffb02e'; c.beginPath(); c.moveTo(x + cw / 2, y + TL.rh - 9); c.lineTo(x + cw / 2 + 4, y + TL.rh - 5); c.lineTo(x + cw / 2, y + TL.rh - 1); c.lineTo(x + cw / 2 - 4, y + TL.rh - 5); c.closePath(); c.fill(); }
      continue;
    }
    c.fillStyle = li === cur.layer ? 'rgba(157,92,255,.10)' : (r % 2 ? '#1f1f24' : '#1c1c20');
    c.fillRect(0, y, Math.min(w, endX), TL.rh);
    c.fillStyle = '#2a2a30'; c.fillRect(0, y + TL.rh - 1, w, 1);
    const col = LAYER_COLORS[li % LAYER_COLORS.length];
    for (let f = f0; f <= f1; f++) {
      const x = f * cw - TL.scroll;
      c.fillStyle = '#26262c'; c.fillRect(x + cw - 1, y, 1, TL.rh - 1);
      const id = L.cells[f];
      if (anyKeyAt(L.keys, f)) { c.fillStyle = '#ffb02e'; c.beginPath(); c.moveTo(x + cw / 2, y + TL.rh - 9); c.lineTo(x + cw / 2 + 4, y + TL.rh - 5); c.lineTo(x + cw / 2, y + TL.rh - 1); c.lineTo(x + cw / 2 - 4, y + TL.rh - 5); c.closePath(); c.fill(); }
      if (!id) continue;
      const ps = f > 0 && L.cells[f - 1] === id, ns = f < P.frames - 1 && L.cells[f + 1] === id;
      c.globalAlpha = L.visible ? 1 : 0.35;
      c.fillStyle = col;
      const bx = x + (ps ? 0 : 3), bw2 = cw - (ps ? 0 : 3) - (ns ? 0 : 3);
      c.fillRect(bx, y + 7, bw2, TL.rh - 15);
      if (!ps) {
        const mk = markOf(id);
        if (mk) { c.fillStyle = MARKS[mk][1]; c.fillRect(bx, y + 7, Math.min(bw2, 5), TL.rh - 15); }
        c.fillStyle = '#111113'; c.beginPath(); c.arc(x + cw / 2, y + TL.rh / 2 - 0.5, 3.2, 0, Math.PI * 2); c.fill();
      }
      c.globalAlpha = 1;
    }
  }
  // audio
  if (AU.buffer && AU.peaks) {
    const y = TL.rulerH + n * TL.rh, mid = y + TL.audioH / 2;
    c.fillStyle = '#1f2a30'; c.fillRect(0, y, Math.min(w, endX), TL.audioH);
    c.fillStyle = P.audio && P.audio.muted ? '#4a5560' : '#4cc9f0';
    for (let f = f0; f <= f1 && f < AU.peaks.length; f++) {
      const x = f * cw - TL.scroll, a = AU.peaks[f] * (TL.audioH / 2 - 4);
      c.fillRect(x + 2, mid - a, cw - 4, Math.max(1, a * 2));
    }
  }
  // cuadro actual
  const cx = cur.frame * cw - TL.scroll;
  c.fillStyle = 'rgba(157,92,255,.16)'; c.fillRect(cx, 0, cw, TL.h);
  c.strokeStyle = '#9d5cff'; c.lineWidth = 2; c.strokeRect(cx + 1, 1, cw - 2, TL.rulerH - 2);
  const ri = rows.indexOf(cur.layer), ry = TL.rulerH + Math.max(0, ri) * TL.rh;
  c.strokeRect(cx + 1, ry + 1, cw - 2, TL.rh - 3);
  c.fillStyle = '#9d5cff'; c.fillRect(cx + cw / 2 - 1, TL.rulerH, 2, TL.h - TL.rulerH);
}
let tlDrag = null;
tlc.addEventListener('pointerdown', e => {
  if (!P) return;
  tlc.setPointerCapture(e.pointerId);
  const r = tlc.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
  stopPlayback();
  tlDrag = { x, y, sx: TL.scroll, moved: false, ruler: y < TL.rulerH };
  if (tlDrag.ruler) setFrame(Math.floor((x + TL.scroll) / TL.cw));
});
tlc.addEventListener('pointermove', e => {
  if (!tlDrag) return;
  const r = tlc.getBoundingClientRect(), x = e.clientX - r.left;
  if (tlDrag.ruler) { setFrame(Math.floor((x + TL.scroll) / TL.cw)); return; }
  if (Math.abs(x - tlDrag.x) > 8) tlDrag.moved = true;
  if (tlDrag.moved) { TL.scroll = tlDrag.sx - (x - tlDrag.x); clampScroll(); requestTimeline(); }
});
const tlUp = e => {
  if (!tlDrag) return;
  const d = tlDrag; tlDrag = null;
  if (d.ruler || d.moved || e.type === 'pointercancel') return;
  const f = Math.floor((d.x + TL.scroll) / TL.cw);
  if (f >= P.frames) return;
  const row = Math.floor((d.y - TL.rulerH) / TL.rh);
  const rws = visibleRows();
  if (row >= 0 && row < rws.length) setLayer(rws[row]);
  setFrame(f);
};
tlc.addEventListener('pointerup', tlUp); tlc.addEventListener('pointercancel', tlUp);
tlc.addEventListener('wheel', e => { if (!P) return; e.preventDefault(); TL.scroll += (Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY); clampScroll(); requestTimeline(); }, { passive: false });

const ICON_EYE = '<svg viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>';
const ICON_LOCK = '<svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
const ICON_DOTS = '<svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.3"/><circle cx="12" cy="12" r="1.3"/><circle cx="19" cy="12" r="1.3"/></svg>';
function buildHeads() {
  if (!P) return;
  const h = $('lheads'); h.innerHTML = '';
  const ruler = el('div', { class: 'lh ruler', text: 'Capas' }); ruler.style.height = TL.rulerH + 'px'; h.appendChild(ruler);
  for (const li of visibleRows()) {
    const L = P.layers[li];
    const row = el('div', { class: 'lh' + (li === cur.layer ? ' on' : '') + (isGroup(L) ? ' grp' : '') });
    row.style.height = TL.rh + 'px';
    row.style.paddingLeft = (4 + depthOf(L) * 12) + 'px';
    const eye = el('button', { class: 'mini' + (L.visible ? '' : ' off'), title: L.visible ? 'Ocultar capa' : 'Mostrar capa', 'aria-label': 'Visibilidad de ' + L.name, html: ICON_EYE });
    eye.onclick = ev => { ev.stopPropagation(); L.visible = !L.visible; layerChanged(); };
    const lock = el('button', { class: 'mini' + (L.locked ? ' lockon' : ' off'), title: L.locked ? 'Desbloquear capa' : 'Bloquear capa', 'aria-label': 'Bloqueo de ' + L.name, html: ICON_LOCK });
    lock.onclick = ev => { ev.stopPropagation(); L.locked = !L.locked; buildHeads(); scheduleSave(); };
    const nm = el('span', { class: 'nm', text: (isGroup(L) ? (L.collapsed ? '▸ ' : '▾ ') : '') + L.name });
    if (isGroup(L)) nm.onclick = ev => { ev.stopPropagation(); toggleCollapse(L); };
    const more = el('button', { class: 'mini', title: 'Ajustes de la capa', 'aria-label': 'Ajustes de ' + L.name, html: ICON_DOTS });
    more.onclick = ev => { ev.stopPropagation(); layerSettings(li); };
    row.append(eye, lock, nm, more);
    row.onclick = () => setLayer(li);
    row.ondblclick = () => layerSettings(li);
    h.appendChild(row);
  }
  if (AU.buffer) {
    const a = el('div', { class: 'lh audio' });
    a.style.height = TL.audioH + 'px';
    a.append(el('span', { class: 'nm', text: '♪ ' + (P.audio ? P.audio.name : 'Audio') }));
    const more = el('button', { class: 'mini', title: 'Ajustes de audio', 'aria-label': 'Ajustes de audio', html: ICON_DOTS });
    more.onclick = ev => { ev.stopPropagation(); audioMenu(); };
    a.append(more); a.onclick = () => audioMenu();
    h.appendChild(a);
  }
}
function layerChanged() { invalidateAllFrames(); sceneDirty = true; buildHeads(); requestRender(); requestTimeline(); scheduleSave(); updateFrameUI(); }
async function layerSettings(li) {
  const L = P.layers[li];
  const name = el('input', { type: 'text', value: L.name, maxlength: 40, id: 'lsName' });
  const op = el('input', { type: 'range', min: 0, max: 100, value: Math.round(L.opacity * 100), id: 'lsOp' });
  const opv = el('output', { text: Math.round(L.opacity * 100) + '%' });
  op.oninput = () => { opv.textContent = op.value + '%'; };
  const blend = el('select', { id: 'lsBlend' }, BLENDS.map(([v, n]) => el('option', { value: v, text: n, selected: (L.blend || 'source-over') === v })));
  const clip = el('input', { type: 'checkbox', id: 'lsClip' }); clip.checked = !!L.clip;
  const alock = el('input', { type: 'checkbox', id: 'lsAlpha' }); alock.checked = !!L.alphaLock;
  const grp = isGroup(L);
  const body = el('div', { class: 'form' }, [el('label', {}, ['Nombre', name]), el('label', {}, [el('span', {}, ['Opacidad ', opv]), op]), el('label', {}, ['Modo de fusión', blend]),
    grp ? el('p', { class: 'note', text: 'Es una carpeta: su opacidad y su modo de fusión se aplican a todo su contenido.' }) : el('label', { class: 'chk' }, [clip, 'Máscara de recorte: mostrar solo dentro de la capa de abajo']),
    grp ? null : el('label', { class: 'chk' }, [alock, 'Bloqueo alfa: pintar solo sobre lo ya dibujado'])]);
  const ok = await dialog({ title: grp ? 'Carpeta' : 'Capa', body, buttons: [{ label: 'Cancelar', value: false }, { label: 'Guardar', value: true, primary: true }] });
  if (!ok) return;
  L.name = name.value.trim().slice(0, 40) || L.name;
  L.opacity = clamp(op.value / 100, 0, 1);
  L.blend = blend.value;
  L.clip = !grp && clip.checked && childrenOf(L.parent || null).indexOf(L) > 0;
  L.alphaLock = !grp && alock.checked;
  layerChanged();
}

/* ----- operaciones de cuadros y capas ----- */
function insertFrame() {
  for (const L of P.layers) L.cells.splice(cur.frame + 1, 0, null);
  shiftAllKeys(cur.frame + 1, 1);
  P.frames++; cur.frame++; ensureFrameVisible(); structural('Insertar cuadro');
}
async function duplicateFrame() {
  const f = cur.frame;
  const copies = [];
  for (const L of P.layers) {
    const id = L.cells[f];
    if (!id) { copies.push(null); continue; }
    const src = await loadCell(id);
    const nid = createCell(); ctx2d(getCellSync(nid)).drawImage(src, 0, 0);
    copies.push(nid);
  }
  P.layers.forEach((L, i) => L.cells.splice(f + 1, 0, copies[i]));
  shiftAllKeys(f + 1, 1);
  P.frames++; cur.frame++; ensureFrameVisible(); structural('Duplicar cuadro');
}
function extendExposure() {
  const L = P.layers[cur.layer], id = L.cells[cur.frame];
  if (!id) { toast('No hay dibujo para extender en esta celda'); return; }
  if (cur.frame + 1 >= P.frames) { for (const l of P.layers) l.cells.push(null); P.frames++; }
  L.cells[cur.frame + 1] = id;
  cur.frame++; ensureFrameVisible(); structural('Extender exposición');
}
async function splitCell() {
  const L = P.layers[cur.layer], id = L.cells[cur.frame];
  if (!id || !isShared(cur.layer, cur.frame)) return;
  const src = await loadCell(id);
  const nid = createCell(); ctx2d(getCellSync(nid)).drawImage(src, 0, 0);
  L.cells[cur.frame] = nid;
  structural('Separar dibujo'); toast('Este cuadro ahora tiene su propio dibujo');
}
async function deleteFrame() {
  if (P.frames < 2) return;
  const hasArt = P.layers.some(L => L.cells[cur.frame]);
  if (hasArt && !(await confirmDlg('Eliminar cuadro', 'Se eliminará el cuadro ' + (cur.frame + 1) + ' en todas las capas.', 'Eliminar', true))) return;
  for (const L of P.layers) L.cells.splice(cur.frame, 1);
  shiftAllKeys(cur.frame, -1);
  P.frames--; cur.frame = Math.min(cur.frame, P.frames - 1); structural('Eliminar cuadro');
}
function addLayer() {
  const n = P.layers.length + 1;
  const C = P.layers[cur.layer];
  const n2 = P.layers.filter(l => !isGroup(l)).length + 1;
  const L = { id: uid(), name: 'Capa ' + n2, visible: true, locked: false, opacity: 1, parent: isGroup(C) ? C.id : (C.parent || null), cells: new Array(P.frames).fill(null) };
  if (isGroup(C)) { C.collapsed = false; P.layers.splice(cur.layer, 0, L); } // arriba del todo dentro de la carpeta
  else P.layers.splice(cur.layer + 1, 0, L);
  reorderLayers(); cur.layer = P.layers.indexOf(L);
  structural('Nueva capa');
}
async function deleteLayer() {
  if (P.layers.length < 2) return;
  const L = P.layers[cur.layer];
  const block = isGroup(L) ? [...descendantsOf(L), L] : [L];
  if (P.layers.filter(l => !isGroup(l) && !block.includes(l)).length === 0) { toast('El proyecto necesita al menos una capa de dibujo'); return; }
  const what = isGroup(L) ? 'la carpeta «' + L.name + '» y las ' + (block.length - 1) + ' capas que contiene' : 'la capa «' + L.name + '» con todos sus dibujos';
  if (!(await confirmDlg(isGroup(L) ? 'Eliminar carpeta' : 'Eliminar capa', 'Se eliminará ' + what + '. Puedes deshacerlo.', 'Eliminar', true))) return;
  const at = P.layers.indexOf(block[0]);
  P.layers = P.layers.filter(l => !block.includes(l));
  cur.layer = clamp(at, 0, P.layers.length - 1); structural(isGroup(L) ? 'Eliminar carpeta' : 'Eliminar capa');
}
function moveFrame(d) {
  const j = cur.frame + d;
  if (j < 0 || j >= P.frames) return;
  for (const L of P.layers) [L.cells[cur.frame], L.cells[j]] = [L.cells[j], L.cells[cur.frame]];
  swapKeyFrames(cur.frame, j);
  cur.frame = j; structural('Mover cuadro');
}
function moveLayer(d) {
  const L = P.layers[cur.layer];
  const sib = childrenOf(L.parent || null), k = sib.indexOf(L), T = sib[k + d];
  if (!T) { toast(d > 0 ? 'Ya está arriba del todo' + (L.parent ? ' en su carpeta' : '') : 'Ya está abajo del todo' + (L.parent ? ' en su carpeta' : '')); return; }
  const block = isGroup(L) ? [...descendantsOf(L), L] : [L];
  const tBlock = isGroup(T) ? [...descendantsOf(T), T] : [T];
  P.layers = P.layers.filter(x => !block.includes(x));
  const at = d > 0 ? P.layers.indexOf(tBlock[tBlock.length - 1]) + 1 : P.layers.indexOf(tBlock[0]);
  P.layers.splice(at, 0, ...block);
  reorderLayers(); cur.layer = P.layers.indexOf(L);
  structural('Mover capa');
}
const guard = fn => async () => { if (!P) return; stopPlayback(); if (S) abortStroke(); commitSel(); try { await fn(); } catch (e) { console.error(e); toast('Error: ' + e.message); } };
$('btnAddFrame').onclick = guard(insertFrame);
$('btnDupFrame').onclick = guard(duplicateFrame);
$('btnExtend').onclick = guard(extendExposure);
$('btnSplit').onclick = guard(splitCell);
$('btnDelFrame').onclick = guard(deleteFrame);
$('btnAddLayer').onclick = guard(addLayer);
$('btnDelLayer').onclick = guard(deleteLayer);
$('btnLayerUp').onclick = guard(() => moveLayer(1));
$('btnLayerDown').onclick = guard(() => moveLayer(-1));
$('btnPrev').onclick = () => { stopPlayback(); setFrame(cur.frame - 1); };
$('btnNext').onclick = () => { stopPlayback(); setFrame(cur.frame + 1); };
addEventListener('keydown', e => { if (e.key === 'Home' && P && !$('editor').hidden && $('modal').hidden) { stopPlayback(); setFrame(0); } });
$('btnLoop').onclick = () => { P.loop = !P.loop; updateFrameUI(); scheduleSave(); };
$('btnOnion').oncontextmenu = e => { e.preventDefault(); if (P) onionDialog(); };
$('btnOnion').onclick = () => { P.onion.on = !P.onion.on; sceneDirty = true; requestRender(); updateFrameUI(); scheduleSave(); };
/* ---------- 61-exposicion.js ---------- */
/* =========================================================
   Tiempo profesional (como en los estudios de anime):
   · duración de cada dibujo (a 1s, 2s, 3s…) y re-temporizar la capa
   · marcas de dibujo: clave, extremo (breakdown) e intermedio
   · hoja de tiempos (X-sheet): filas = cuadros, columnas = capas
   · papel cebolla completo, mesa de luz y ayuda para intercalar
   · estabilizador «cuerda» (el trazo solo avanza cuando el lápiz se aleja)
   ========================================================= */

const MARKS = { K: ['Clave', '#ff4d6d'], B: ['Extremo', '#ffb02e'], I: ['Intermedio', '#4cc9f0'] };
const markOf = id => (id && P && P.marks && P.marks[id]) || '';

// Tramo de cuadros seguidos con el mismo dibujo alrededor de f
function runAt(L, f) {
  const id = L.cells[f];
  let s = f, e = f;
  while (s > 0 && L.cells[s - 1] === id) s--;
  while (e < P.frames - 1 && L.cells[e + 1] === id) e++;
  return { s, e, id, len: e - s + 1 };
}
// Ajusta la longitud de la capa a P.frames; si se pasa con dibujos, alarga el proyecto
function fitLayerLength(L) {
  let last = L.cells.length - 1;
  while (last >= P.frames && !L.cells[last]) last--;
  if (last >= P.frames) {
    const n = last + 1;
    for (const o of P.layers) while (o.cells.length < n) o.cells.push(null);
    P.frames = n;
  }
  L.cells.length = P.frames;
  for (let i = 0; i < P.frames; i++) if (L.cells[i] === undefined) L.cells[i] = null;
}
function setHold(n) {
  const L = P.layers[cur.layer];
  if (!L || isGroup(L)) { toast('Elige una capa de dibujo'); return; }
  if (!L.cells[cur.frame]) { toast('No hay dibujo en este cuadro'); return; }
  const r = runAt(L, cur.frame);
  if (n > r.len) L.cells.splice(r.e + 1, 0, ...new Array(n - r.len).fill(r.id));
  else if (n < r.len) L.cells.splice(r.s + n, r.len - n);
  fitLayerLength(L);
  cur.frame = Math.min(r.s, P.frames - 1);
  structural('Duración del dibujo');
  toast('El dibujo dura ' + n + (n === 1 ? ' cuadro' : ' cuadros') + ' (los siguientes de esta capa se movieron)');
}
// Toda la capa «a 1s / 2s / 3s»: cada dibujo dura n cuadros; los huecos se conservan
function retimeLayer(li, n) {
  const L = P.layers[li];
  if (!L || isGroup(L)) return;
  const out = [];
  for (let f = 0; f < P.frames;) {
    const r = runAt(L, f);
    if (r.id) for (let k = 0; k < n; k++) out.push(r.id);
    else for (let k = 0; k < r.len; k++) out.push(null);
    f = r.e + 1;
  }
  while (out.length && !out[out.length - 1] && out.length > P.frames) out.pop();
  L.cells = out;
  fitLayerLength(L);
  structural('Capa a ' + n + 's');
  toast('«' + L.name + '» animada a ' + n + 's: cada dibujo dura ' + n + ' cuadros');
}
async function holdDialog() {
  const L = P.layers[cur.layer];
  const has = L && !isGroup(L) && L.cells[cur.frame];
  const now = has ? runAt(L, cur.frame).len : 0;
  const mk = (v, t, s) => el('button', { html: escapeHtml(t) + (s ? '<small>' + escapeHtml(s) + '</small>' : ''), onclick: () => closeDialog(v) });
  const grid = el('div', { class: 'drow', style: 'flex-wrap:wrap;gap:6px' });
  if (has) for (let n = 1; n <= 8; n++) {
    const b = el('button', { class: 'tb' + (n === now ? ' on' : ''), text: n + (n === 1 ? ' cuadro' : ' cuadros') });
    b.onclick = () => closeDialog('h' + n);
    grid.appendChild(b);
  }
  const body = el('div', { class: 'form' }, [
    el('p', { class: 'note', text: has ? 'Cuánto dura este dibujo (ahora: ' + now + '). En anime se anima «a 2s» o «a 3s»: cada dibujo se ve 2 o 3 cuadros. Los dibujos siguientes de la capa se mueven.' : 'Este cuadro no tiene dibujo: puedes cambiar el ritmo de toda la capa.' }),
    grid,
    el('div', { class: 'menu' }, [mk('r1', 'Toda la capa a 1s', 'Un dibujo por cuadro (acción muy suave)'), mk('r2', 'Toda la capa a 2s', 'Cada dibujo dura 2 cuadros (lo más usado)'), mk('r3', 'Toda la capa a 3s', 'Cada dibujo dura 3 cuadros (anime de TV)')]),
  ]);
  const r = await dialog({ title: 'Duración · ' + (L ? L.name : ''), body, buttons: [{ label: 'Cerrar', value: null }] });
  if (!r) return;
  if (r[0] === 'h') setHold(parseInt(r.slice(1), 10));
  else if (r[0] === 'r') retimeLayer(cur.layer, parseInt(r.slice(1), 10));
}

/* ----- marcas de dibujo ----- */
async function markDialog() {
  const L = P.layers[cur.layer], id = L && L.cells[cur.frame];
  if (!id) { toast('No hay dibujo en este cuadro'); return; }
  const mk = (v, t, s, c) => el('button', { html: '<span style="display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:8px;background:' + c + '"></span>' + escapeHtml(t) + '<small>' + escapeHtml(s) + '</small>', onclick: () => closeDialog(v) });
  const r = await dialog({ title: 'Marcar dibujo', body: el('div', { class: 'menu' }, [
    mk('K', 'Clave', 'Las poses principales del movimiento', MARKS.K[1]),
    mk('B', 'Extremo (breakdown)', 'La pose que decide el camino entre dos claves', MARKS.B[1]),
    mk('I', 'Intermedio', 'Los dibujos que van entre medias', MARKS.I[1]),
    mk('-', 'Sin marca', 'Quitar la marca', '#555'),
  ]), buttons: [{ label: 'Cerrar', value: null }] });
  if (!r) return;
  if (!P.marks) P.marks = {};
  if (r === '-') delete P.marks[id]; else P.marks[id] = r;
  structural('Marcar dibujo');
}

/* ----- mesa de luz ----- */
function toggleLightTable() {
  const L = P.layers[cur.layer], id = L && L.cells[cur.frame];
  if (!id) { toast('No hay dibujo en este cuadro'); return; }
  if (!P.light) P.light = [];
  const i = P.light.indexOf(id);
  if (i >= 0) { P.light.splice(i, 1); toast('Quitado de la mesa de luz'); }
  else { P.light.push(id); if (P.light.length > 4) P.light.shift(); toast('En la mesa de luz: se verá en azul en todos los cuadros mientras dibujas'); }
  structural('Mesa de luz');
}

/* ----- papel cebolla completo ----- */
function onionOpts() {
  const o = P.onion || {};
  return {
    prev: o.prev != null ? o.prev : 2, next: o.next != null ? o.next : 1,
    colPrev: o.colPrev || '#e8473c', colNext: o.colNext || '#2fae5b',
    near: o.near != null ? o.near : 32, far: o.far != null ? o.far : 8,
    keys: !!o.keys, ib: !!o.ib, light: o.lightOn !== false,
  };
}
async function onionDialog() {
  const x = onionOpts();
  const before = clone(P.onion);
  const live = () => { Object.assign(P.onion, { prev: x.prev, next: x.next, colPrev: x.colPrev, colNext: x.colNext, near: x.near, far: x.far, keys: x.keys, ib: x.ib, lightOn: x.light }); sceneDirty = true; requestRender(); };
  const slider = (label, key, min, max, unit) => {
    const out = el('output', { text: x[key] + unit });
    const r = el('input', { type: 'range', min: String(min), max: String(max), value: String(x[key]) });
    r.oninput = () => { x[key] = parseFloat(r.value); out.textContent = r.value + unit; live(); };
    return el('label', {}, [el('span', {}, [label + ' ', out]), r]);
  };
  const color = (label, key) => { const c = el('input', { type: 'color', value: x[key] }); c.oninput = () => { x[key] = c.value; live(); }; return el('label', {}, [label, c]); };
  const chk = (label, key) => { const c = el('input', { type: 'checkbox' }); c.checked = !!x[key]; c.onchange = () => { x[key] = c.checked; live(); }; return el('label', { class: 'chk' }, [c, label]); };
  const lightN = (P.light || []).length;
  const clearLight = el('button', { class: 'tb', text: 'Vaciar mesa de luz (' + lightN + ')' });
  clearLight.onclick = () => { P.light = []; structural('Vaciar mesa de luz'); clearLight.textContent = 'Vaciar mesa de luz (0)'; };
  const body = el('div', { class: 'form' }, [
    el('div', { class: 'row2' }, [slider('Dibujos antes', 'prev', 0, 8, ''), slider('Dibujos después', 'next', 0, 8, '')]),
    el('div', { class: 'row2' }, [color('Color de los anteriores', 'colPrev'), color('Color de los siguientes', 'colNext')]),
    el('div', { class: 'row2' }, [slider('Opacidad del más cercano', 'near', 5, 80, '%'), slider('Opacidad del más lejano', 'far', 2, 60, '%')]),
    chk('Solo dibujos clave y extremos (para intercalar entre poses)', 'keys'),
    chk('Ayuda para intercalar: siempre muestra la clave anterior y la siguiente', 'ib'),
    chk('Mostrar la mesa de luz', 'light'),
    el('p', { class: 'note', text: 'Mesa de luz: menú del cuadro → «Fijar en mesa de luz». El dibujo se ve en azul en todos los cuadros, como el papel de referencia de un animador.' }),
    clearLight,
  ]);
  const r = await dialog({ title: 'Papel cebolla', body, buttons: [{ label: 'Cancelar', value: false }, { label: 'Listo', value: true, primary: true }] });
  if (r) { P.onion.on = true; updateFrameUI(); scheduleSave(); }
  else { P.onion = before; sceneDirty = true; requestRender(); }
}

/* ----- hoja de tiempos (X-sheet) ----- */
async function xsheetDialog() {
  stopPlayback(); commitSel();
  const cols = [];
  for (let i = 0; i < P.layers.length; i++) if (!isGroup(P.layers[i])) cols.push(i);
  // número de cada dibujo dentro de su capa, por orden de aparición
  const num = cols.map(li => { const m = new Map(); for (const id of P.layers[li].cells) if (id && !m.has(id)) m.set(id, m.size + 1); return m; });
  const camKeys = P.camera && P.camera.keys ? P.camera.keys : null;
  const camAt = f => camKeys && Object.values(camKeys).some(a => Array.isArray(a) && a.some(k => k.f === f));
  let h = '<table class="xs"><thead><tr><th>#</th>';
  cols.forEach((li, c) => {
    const L = P.layers[li];
    h += '<th>' + escapeHtml(L.name.slice(0, 14)) + '<div class="xsr">' + [1, 2, 3].map(n => '<button data-rt="' + li + ':' + n + '">' + n + 's</button>').join('') + '</div></th>';
  });
  if (camKeys) h += '<th>Cámara</th>';
  h += '</tr></thead><tbody>';
  for (let f = 0; f < P.frames; f++) {
    const sec = (f % P.fps) === P.fps - 1;
    h += '<tr' + (f === cur.frame ? ' class="cur"' : '') + (sec ? ' style="border-bottom:2px solid #555"' : '') + '><td class="xn">' + (f + 1) + '</td>';
    cols.forEach((li, c) => {
      const L = P.layers[li], id = L.cells[f], prevSame = f > 0 && L.cells[f - 1] === id;
      let t = '', st = '';
      if (id && !prevSame) {
        const mk = markOf(id);
        t = String(num[c].get(id));
        if (mk) st = 'color:' + MARKS[mk][1] + ';font-weight:800';
      } else if (id) t = '│';
      else if (f > 0 && L.cells[f - 1]) t = '×';
      h += '<td data-f="' + f + '" data-l="' + li + '"' + (li === cur.layer && f === cur.frame ? ' class="sel"' : '') + (st ? ' style="' + st + '"' : '') + '>' + t + '</td>';
    });
    if (camKeys) h += '<td>' + (camAt(f) ? '◆' : '') + '</td>';
    h += '</tr>';
  }
  h += '</tbody></table>';
  const wrap = el('div', { class: 'xswrap', html: h });
  wrap.onclick = e => {
    const rt = e.target.closest('[data-rt]');
    if (rt) { const [li, n] = rt.dataset.rt.split(':').map(Number); closeDialog(null); retimeLayer(li, n); return; }
    const td = e.target.closest('td[data-f]');
    if (td) { setLayer(+td.dataset.l); setFrame(+td.dataset.f); closeDialog(null); }
  };
  const legend = el('p', { class: 'note', html: 'Cada número es un dibujo; <b>│</b> = el mismo dibujo sigue; <b>×</b> = vacío. Colores: <b style="color:' + MARKS.K[1] + '">clave</b>, <b style="color:' + MARKS.B[1] + '">extremo</b>, <b style="color:' + MARKS.I[1] + '">intermedio</b>. Toca una casilla para ir allí; «1s 2s 3s» cambian el ritmo de la columna.' });
  setTimeout(() => { const r = wrap.querySelector('tr.cur'); if (r) r.scrollIntoView({ block: 'center' }); }, 30);
  await dialog({ title: 'Hoja de tiempos', body: el('div', {}, [legend, wrap]), buttons: [{ label: 'Cerrar', value: null }] });
}
(() => {
  const st = document.createElement('style');
  st.textContent = '.xswrap{max-height:58vh;overflow:auto;border:1px solid var(--line2);border-radius:8px}' +
    '.xs{border-collapse:collapse;font:600 13px system-ui,sans-serif;width:100%}' +
    '.xs th{position:sticky;top:0;background:#26262c;color:var(--text);padding:4px 6px;font-size:12px;z-index:1;border-left:1px solid #333}' +
    '.xs td{border-left:1px solid #333;border-bottom:1px solid #2a2a30;text-align:center;padding:3px 6px;min-width:44px;cursor:pointer;color:#ddd}' +
    '.xs td.xn{color:#888;min-width:30px;cursor:default}.xs tr.cur td{background:rgba(157,92,255,.16)}.xs td.sel{outline:2px solid #9d5cff;outline-offset:-2px}' +
    '.xsr{display:flex;gap:2px;justify-content:center;margin-top:3px}.xsr button{font:600 10px system-ui;padding:2px 5px;border-radius:5px;border:1px solid #444;background:#1c1c20;color:#ccc}';
  document.head.appendChild(st);
})();

/* ----- dibujo del estabilizador «cuerda» sobre el lienzo ----- */
function drawStringGuide(c) {
  if (!S || !S.eng || !S.eng.anc || !S.eng.raw || !(stringLen > 0)) return;
  const a = S.eng.anc, r = S.eng.raw;
  c.save();
  c.lineWidth = 1.5 / view.z; c.strokeStyle = 'rgba(157,92,255,.8)';
  c.setLineDash([4 / view.z, 3 / view.z]);
  c.beginPath(); c.moveTo(a.x, a.y); c.lineTo(r.x, r.y); c.stroke();
  c.setLineDash([]);
  c.beginPath(); c.arc(a.x, a.y, stringLen / view.z, 0, Math.PI * 2); c.stroke();
  c.restore();
}
/* ---------- 62-color.js ---------- */
/* =========================================================
   Tinta y color de anime (shiage):
   · capa de línea de referencia para el relleno
   · rellenar por debajo de la línea (sin bordes blancos)
   · línea sin suavizado (binaria) para rellenar sin huecos
   · colores con nombre: cambiar uno recolorea toda la escena
   · línea de color: la línea toma el color del relleno de al lado
   · capas de sombra y brillo (recortadas al color), vacías o automáticas
   ========================================================= */
let fillUnder = 2, aliasOff = false;
try {
  const pr = JSON.parse(localStorage.getItem('trazo_color2') || '{}');
  if (typeof pr.fillUnder === 'number') fillUnder = pr.fillUnder;
  if (typeof pr.aliasOff === 'boolean') aliasOff = pr.aliasOff;
} catch (e) { }
function bindColorPrefs() {
  const fu = $('fillUnder'), ao = $('aliasOff');
  if (fu) { fu.value = fillUnder; $('fillUnderV').textContent = fillUnder; fu.oninput = e => { fillUnder = +e.target.value; $('fillUnderV').textContent = fillUnder; saveColorPrefs(); }; }
  if (ao) { ao.checked = aliasOff; ao.onchange = e => { aliasOff = e.target.checked; saveColorPrefs(); }; }
}
bindColorPrefs();
const saveColorPrefs = () => { try { localStorage.setItem('trazo_color2', JSON.stringify({ fillUnder, aliasOff })); } catch (e) { } };

// Capas marcadas como «línea de referencia» (el relleno solo mira esas y la actual)
const refLayers = () => P.layers.filter(L => L.ref && !isGroup(L) && L.visible);

// Línea binaria: cada píxel del trazo es del todo opaco o del todo transparente
function binarize(cv, box) {
  const t = ctx2d(cv, { willReadFrequently: true });
  const img = t.getImageData(box.x, box.y, box.w, box.h), d = img.data;
  for (let k = 3; k < d.length; k += 4) d[k] = d[k] >= 110 ? 255 : 0;
  t.putImageData(img, box.x, box.y);
}

const hexRgb = h => { const n = parseInt(h.slice(1), 16); return [n >> 16, (n >> 8) & 255, n & 255]; };
const rgbHex = (r, g, b) => '#' + [r, g, b].map(v => Math.max(0, Math.min(255, Math.round(v))).toString(16).padStart(2, '0')).join('');
function allDrawingIds(onlyLayer) {
  const s = new Set();
  for (const L of P.layers) if (!isGroup(L) && (!onlyLayer || L === onlyLayer)) for (const id of L.cells) if (id) s.add(id);
  return [...s];
}

/* ----- colores con nombre ----- */
const COLOR_SET = [['Línea', '#1f1b16'], ['Piel', '#f6d2b8'], ['Piel sombra', '#d9a58f'], ['Pelo', '#2c2a3a'], ['Pelo brillo', '#6a6c8f'], ['Ropa', '#e56b2c'], ['Ropa sombra', '#b54a1c'], ['Ojos', '#3a5fd6']];
async function recolorScene(fromHex, toHex) {
  const [r0, g0, b0] = hexRgb(fromHex), [r1, g1, b1] = hexRgb(toHex);
  const ids = allDrawingIds();
  let changed = 0;
  toast('Cambiando el color en ' + ids.length + ' dibujos…', 4000);
  for (const id of ids) {
    const cv = await loadCell(id); if (!cv) continue;
    const t = ctx2d(cv, { willReadFrequently: true });
    const img = t.getImageData(0, 0, P.w, P.h), d = img.data;
    let hit = false;
    for (let k = 0; k < d.length; k += 4) {
      if (!d[k + 3]) continue;
      if (Math.abs(d[k] - r0) + Math.abs(d[k + 1] - g0) + Math.abs(d[k + 2] - b0) <= 9) { d[k] = r1; d[k + 1] = g1; d[k + 2] = b1; hit = true; }
    }
    if (hit) { t.putImageData(img, 0, 0); markCellDirty(id); invalidateCellFrames(id); changed++; }
  }
  sceneDirty = true; requestRender(); requestTimeline();
  toast(changed ? 'Color cambiado en ' + changed + ' dibujos' : 'Ningún dibujo usa ese color exacto');
}
async function namedColorsDialog() {
  if (!P.named) P.named = [];
  const list = el('div', { class: 'form' });
  const render = () => {
    list.innerHTML = '';
    if (!P.named.length) list.appendChild(el('p', { class: 'note', text: 'Aún no hay colores. Añade el color actual o el juego básico de anime.' }));
    P.named.forEach((c, i) => {
      const sw = el('button', { class: 'tb', style: 'width:40px;height:34px;padding:0;flex:none;background:' + c.hex + ';border:2px solid #444', title: 'Usar este color' });
      sw.onclick = () => { setColor(c.hex); toast('Color «' + c.name + '»'); };
      const name = el('input', { type: 'text', value: c.name, maxlength: 24, style: 'flex:1;min-width:0;width:auto' });
      name.onchange = () => { c.name = name.value.trim().slice(0, 24) || c.name; scheduleSave(); };
      const pick = el('input', { type: 'color', value: c.hex, style: 'width:46px;height:34px;flex:none;padding:0', title: 'Cambiar este color en toda la escena' });
      pick.onchange = async () => {
        const old = c.hex, nu = pick.value.toLowerCase();
        if (old === nu) return;
        if (!(await confirmDlg('Cambiar «' + c.name + '»', 'Todo lo pintado con ' + old + ' pasará a ' + nu + ' en todos los dibujos. Para volver atrás, cámbialo de nuevo al color anterior.', 'Cambiar'))) { pick.value = old; return; }
        c.hex = nu; scheduleSave(); await recolorScene(old, nu); render();
      };
      const del = el('button', { class: 'tb', text: '✕', style: 'flex:none', title: 'Quitar de la lista' });
      del.onclick = () => { P.named.splice(i, 1); scheduleSave(); render(); };
      list.appendChild(el('div', { style: 'display:flex;flex-wrap:nowrap;gap:6px;align-items:center' }, [sw, name, pick, del]));
    });
  };
  render();
  const addCur = el('button', { class: 'tb', text: '+ Color actual' });
  addCur.onclick = () => { P.named.push({ name: 'Color ' + (P.named.length + 1), hex: color }); scheduleSave(); render(); };
  const addSet = el('button', { class: 'tb', text: '+ Juego básico de anime' });
  addSet.onclick = () => { for (const [n, h] of COLOR_SET) if (!P.named.some(c => c.name === n)) P.named.push({ name: n, hex: h }); scheduleSave(); render(); };
  const body = el('div', { class: 'form' }, [
    el('p', { class: 'note', text: 'Como las paletas de los estudios: cada color tiene nombre. Toca el cuadrado para pintar con él; cambia el selector de la derecha para recolorear ese color en TODOS los dibujos (día, noche, otra ropa…).' }),
    list, el('div', { class: 'drow', style: 'gap:6px' }, [addCur, addSet]),
  ]);
  await dialog({ title: 'Colores con nombre', body, buttons: [{ label: 'Cerrar', value: null }] });
}

/* ----- línea de color: la línea toma el color del relleno que tiene debajo ----- */
async function colorLines(scope, dark) {
  const L = P.layers[cur.layer];
  if (!L || isGroup(L)) { toast('Elige la capa de la línea'); return; }
  const below = P.layers.filter((x, i) => i < cur.layer && !isGroup(x) && x.visible && (x.parent || null) === (L.parent || null));
  if (!below.length) { toast('Pon los colores en una capa debajo de la línea'); return; }
  const frames = [];
  const seen = new Set();
  for (let f = 0; f < P.frames; f++) {
    const id = L.cells[f];
    if (!id || seen.has(id)) continue;
    if (scope === 'frame' && f !== cur.frame) continue;
    seen.add(id); frames.push([f, id]);
  }
  const W = P.w, H = P.h;
  const work = mkCanvas(W, H), wt = ctx2d(work, { willReadFrequently: true });
  let n = 0;
  for (const [f, id] of frames) {
    for (const B of below) { const b = B.cells[f]; if (b) await loadCell(b); }
    const cv = await loadCell(id); if (!cv) continue;
    resetCtx(wt); wt.clearRect(0, 0, W, H);
    composeList(wt, below, f, W, H, getCellSync, false, 0);
    const bd = wt.getImageData(0, 0, W, H).data;
    const t = ctx2d(cv, { willReadFrequently: true });
    const img = t.getImageData(0, 0, W, H), d = img.data;
    const before = new ImageData(new Uint8ClampedArray(d), W, H);
    let hit = false;
    for (let k = 0; k < d.length; k += 4) {
      if (!d[k + 3] || bd[k + 3] < 200) continue;
      d[k] = bd[k] * dark; d[k + 1] = bd[k + 1] * dark; d[k + 2] = bd[k + 2] * dark; hit = true;
    }
    if (!hit) continue;
    t.putImageData(img, 0, 0);
    pushUndo({ label: 'Línea de color', cellId: id, layerId: L.id, frame: f, created: false, x: 0, y: 0, before, after: t.getImageData(0, 0, W, H) });
    afterEdit(id); n++;
  }
  toast(n ? 'Línea de color en ' + n + ' dibujos' : 'No hay relleno debajo de la línea (rellena antes la capa de color)');
}

/* ----- capas de sombra y brillo ----- */
function addToneLayer(kind) {
  const C = P.layers[cur.layer];
  if (!C || isGroup(C)) { toast('Elige la capa de color'); return null; }
  const L = { id: uid(), name: kind === 'shadow' ? 'Sombra' : 'Brillo', visible: true, locked: false, opacity: kind === 'shadow' ? 0.85 : 0.9,
    blend: kind === 'shadow' ? 'multiply' : 'screen', clip: true, parent: C.parent || null, cells: new Array(P.frames).fill(null) };
  P.layers.splice(cur.layer + 1, 0, L);
  reorderLayers(); cur.layer = P.layers.indexOf(L);
  return L;
}
async function autoToneLayer(kind, dist, lightDeg, col, soft) {
  const C = P.layers[cur.layer];
  if (!C || isGroup(C)) { toast('Elige la capa de color (la que tiene los rellenos)'); return; }
  const base = C;
  const map = new Map();
  for (const id of base.cells) if (id && !map.has(id)) map.set(id, null);
  if (!map.size) { toast('La capa «' + base.name + '» no tiene dibujos'); return; }
  toast('Creando ' + (kind === 'shadow' ? 'sombras' : 'brillos') + ' en ' + map.size + ' dibujos…', 3000);
  const a = lightDeg * Math.PI / 180, lx = Math.cos(a), ly = Math.sin(a);
  const dx = (kind === 'shadow' ? lx : -lx) * dist, dy = (kind === 'shadow' ? ly : -ly) * dist;
  for (const id of map.keys()) {
    const src = await loadCell(id); if (!src) continue;
    const band = shiftedBand(src, P.w, P.h, dx, dy, col, soft, 'tone');
    const nid = createCell();
    ctx2d(getCellSync(nid)).drawImage(band, 0, 0);
    markCellDirty(nid);
    map.set(id, nid);
  }
  const L = addToneLayer(kind);
  if (!L) return;
  L.cells = base.cells.map(id => id ? map.get(id) : null);
  L.blend = kind === 'shadow' ? 'multiply' : 'screen';
  structural(kind === 'shadow' ? 'Sombras automáticas' : 'Brillos automáticos');
  toast('Capa «' + L.name + '» creada y recortada al color: retócala con el pincel o el borrador como cualquier dibujo', 4000);
}

/* ----- diálogo «Tinta y color» ----- */
async function inkPaintDialog() {
  const L = P.layers[cur.layer];
  const mk = (v, t, s) => el('button', { html: escapeHtml(t) + (s ? '<small>' + escapeHtml(s) + '</small>' : ''), onclick: () => closeDialog(v) });
  const isRef = L && L.ref;
  const r = await dialog({ title: 'Tinta y color', body: el('div', { class: 'menu' }, [
    mk('ref', isRef ? 'Dejar de usar «' + L.name + '» como línea' : 'Usar «' + (L ? L.name : '') + '» como línea de referencia', 'El relleno de las otras capas se detiene en esta línea (línea en una capa, color en otra)'),
    mk('named', 'Colores con nombre…', 'Piel, piel sombra, pelo…: cambia uno y cambia en todos los dibujos'),
    mk('lineF', 'Línea de color (este dibujo)', 'La línea toma el color del relleno que tiene debajo, más oscuro'),
    mk('lineL', 'Línea de color (toda la capa)', 'Lo mismo en todos los dibujos de la capa'),
    mk('autoS', 'Sombras automáticas → capa nueva', 'Sombra de anime de dos tonos en todos los dibujos, editable'),
    mk('autoH', 'Brillos automáticos → capa nueva', 'Brillo en el borde que mira a la luz, editable'),
    mk('newS', 'Capa de sombra vacía', 'Recortada al color y en Multiplicar: pinta las sombras a mano'),
    mk('newH', 'Capa de brillo vacía', 'Recortada al color y en Trama: pinta los brillos a mano'),
  ]), buttons: [{ label: 'Cerrar', value: null }] });
  if (!r) return;
  if (r === 'ref') {
    if (!L || isGroup(L)) { toast('Elige una capa de dibujo'); return; }
    L.ref = !L.ref; structural(L.ref ? 'Capa de línea' : 'Quitar capa de línea');
    toast(L.ref ? '«' + L.name + '» es la línea: al rellenar en otra capa, el color se detiene en ella' : '«' + L.name + '» ya no es la línea de referencia');
  } else if (r === 'named') namedColorsDialog();
  else if (r === 'lineF' || r === 'lineL') {
    const dk = await toneParams('Línea de color', [['dark', 'Oscuridad de la línea', 20, 100, 55, '%']]);
    if (dk) await colorLines(r === 'lineF' ? 'frame' : 'layer', dk.dark / 100);
  } else if (r === 'autoS' || r === 'autoH') {
    const sh = r === 'autoS';
    const p = await toneParams(sh ? 'Sombras automáticas' : 'Brillos automáticos', [
      ['dist', 'Tamaño', 2, 120, sh ? 22 : 8, ' px'], ['ang', 'Dirección de la luz', -180, 180, -45, '°'], ['soft', 'Suavidad', 0, 20, 0, ' px'],
    ], sh ? '#b8a6d6' : '#ffffff');
    if (p) await autoToneLayer(sh ? 'shadow' : 'light', p.dist, p.ang, p.col, p.soft);
  } else if (r === 'newS' || r === 'newH') {
    if (addToneLayer(r === 'newS' ? 'shadow' : 'light')) { structural(r === 'newS' ? 'Capa de sombra' : 'Capa de brillo'); toast('Pinta aquí: solo se verá dentro del color de la capa de abajo'); }
  }
}
async function toneParams(title, fields, col) {
  const x = {};
  const rows = fields.map(([k, label, min, max, v, unit]) => {
    x[k] = v;
    const out = el('output', { text: v + unit });
    const r = el('input', { type: 'range', min: String(min), max: String(max), value: String(v) });
    r.oninput = () => { x[k] = parseFloat(r.value); out.textContent = r.value + unit; };
    return el('label', {}, [el('span', {}, [label + ' ', out]), r]);
  });
  if (col) { x.col = col; const c = el('input', { type: 'color', value: col }); c.oninput = () => { x.col = c.value; }; rows.push(el('label', {}, ['Color', c])); }
  const ok = await dialog({ title, body: el('div', { class: 'form' }, rows), buttons: [{ label: 'Cancelar', value: false }, { label: 'Hacer', value: true, primary: true }] });
  return ok ? x : null;
}
/* ---------- 65-reproduccion.js ---------- */
/* =========================================================
   Reproducción
   ========================================================= */
const PB = { playing: false, frames: new Map(), shown: 0, start: 0, t0: 0, raf: 0, src: null, scale: 1 };
function invalidateFrame(f) { const b = PB.frames.get(f); if (b) { if (b.close) b.close(); PB.frames.delete(f); } thumbDirty(f); }
function invalidateAllFrames() { for (const b of PB.frames.values()) if (b.close) b.close(); PB.frames.clear(); for (let f = 0; f < STRIP.els.length; f++) thumbDirty(f); }
function invalidateCellFrames(id) { for (const L of P.layers) L.cells.forEach((x, f) => { if (x === id) invalidateFrame(f); }); }
async function preparePlayback() {
  const s = Math.min(1, PERF.previewMax / Math.max(P.w, P.h));
  const budget = PERF.playbackMB * MB, per = P.w * s * P.h * s * 4;
  const scale = per * P.frames > budget ? Math.sqrt(budget / (P.frames * P.w * P.h * 4)) : s;
  if (Math.abs(scale - PB.scale) > 1e-3) { invalidateAllFrames(); PB.scale = scale; }
  const w = Math.max(1, Math.round(P.w * PB.scale)), h = Math.max(1, Math.round(P.h * PB.scale));
  const missing = []; for (let f = 0; f < P.frames; f++) if (!PB.frames.has(f)) missing.push(f);
  if (!missing.length) return true;
  const c = mkCanvas(w, h), t = ctx2d(c);
  busyCancel = false;
  const showBusy = missing.length > 6;
  for (let i = 0; i < missing.length; i++) {
    if (busyCancel) { busy(false); return false; }
    if (showBusy && i % 2 === 0) { busy(true, 'Preparando reproducción…', i / missing.length); await raf(); }
    const f = missing[i];
    await compositeFrameAsync(t, f, w, h, true, true);
    PB.frames.set(f, await createImageBitmap(c));
  }
  busy(false);
  trimCache();
  return true;
}
async function startPlayback() {
  if (!P || PB.playing) return;
  commitSel(); LS = null;
  if (S) abortStroke();
  if (!(await preparePlayback())) return;
  PB.playing = true; PB.start = cur.frame >= P.frames - 1 ? 0 : cur.frame; PB.shown = PB.start;
  $('playIco').innerHTML = '<rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/>';
  startAudioAt(PB.start);
  PB.t0 = clockNow();
  const tick = () => {
    if (!PB.playing) return;
    let f = PB.start + Math.floor((clockNow() - PB.t0) * P.fps);
    if (f >= P.frames) {
      if (P.loop) { PB.start = 0; startAudioAt(0); PB.t0 = clockNow(); f = 0; }
      else { stopPlayback(); setFrame(P.frames - 1, false); return; }
    }
    if (f !== PB.shown) { PB.shown = f; cur.frame = f; requestTimeline(); updateFrameUI(); ensureFrameVisible(); }
    requestRender();
    PB.raf = requestAnimationFrame(tick);
  };
  requestRender();
  PB.raf = requestAnimationFrame(tick);
}
function stopPlayback() {
  if (!PB.playing) return;
  PB.playing = false; cancelAnimationFrame(PB.raf);
  stopAudio();
  $('playIco').innerHTML = '<path d="M7 4v16l13-8z"/>';
  sceneDirty = true; requestRender(); requestTimeline(); updateFrameUI();
}
$('btnPlay').onclick = () => { PB.playing ? stopPlayback() : startPlayback(); };
/* ---------- 70-audio.js ---------- */
/* =========================================================
   Audio
   ========================================================= */
const AU = { ctx: null, gain: null, buffer: null, peaks: null, src: null, scrubSrc: null };
function actx() {
  if (!AU.ctx) {
    const C = window.AudioContext || window.webkitAudioContext;
    if (!C) return null;
    AU.ctx = new C(); AU.gain = AU.ctx.createGain(); AU.gain.connect(AU.ctx.destination);
  }
  if (AU.ctx.state === 'suspended') AU.ctx.resume();
  return AU.ctx;
}
function clockNow() { return (AU.ctx && AU.src) ? AU.ctx.currentTime : performance.now() / 1000; }
function audioOn() { return AU.buffer && P.audio && !P.audio.muted; }
function startAudioAt(f) {
  stopAudio();
  if (!audioOn()) return;
  const c = actx(); if (!c) return;
  const off = f / P.fps;
  if (off >= AU.buffer.duration) return;
  AU.gain.gain.value = P.audio.volume;
  const s = c.createBufferSource(); s.buffer = AU.buffer; s.connect(AU.gain); s.start(0, off);
  AU.src = s;
}
function stopAudio() { if (AU.src) { try { AU.src.stop(); } catch (e) { } AU.src.disconnect(); AU.src = null; } }
function scrubAudio(f) {
  if (!audioOn()) return;
  const c = actx(); if (!c) return;
  if (AU.scrubSrc) { try { AU.scrubSrc.stop(); } catch (e) { } }
  const off = f / P.fps;
  if (off >= AU.buffer.duration) return;
  AU.gain.gain.value = P.audio.volume;
  const s = c.createBufferSource(); s.buffer = AU.buffer; s.connect(AU.gain);
  s.start(0, off, Math.max(0.05, 1.4 / P.fps));
  AU.scrubSrc = s;
}
function computePeaks() {
  const b = AU.buffer, n = Math.ceil(b.duration * P.fps), per = b.sampleRate / P.fps;
  const chs = []; for (let c = 0; c < Math.min(2, b.numberOfChannels); c++) chs.push(b.getChannelData(c));
  const peaks = new Float32Array(n); let max = 0;
  for (let f = 0; f < n; f++) {
    const a = Math.floor(f * per), z = Math.min(b.length, Math.floor((f + 1) * per));
    let m = 0;
    for (const ch of chs) for (let i = a; i < z; i += 4) { const v = Math.abs(ch[i]); if (v > m) m = v; }
    peaks[f] = m; if (m > max) max = m;
  }
  if (max > 0) for (let f = 0; f < n; f++) peaks[f] /= max;
  AU.peaks = peaks;
}
async function decodeAudio(arrayBuf) {
  const c = actx();
  if (!c) throw new Error('Este dispositivo no permite audio');
  return await new Promise((res, rej) => {
    const p = c.decodeAudioData(arrayBuf, res, rej);
    if (p && p.then) p.then(res, rej);
  });
}
async function loadProjectAudio() {
  AU.buffer = null; AU.peaks = null;
  if (!P.audio) return;
  try {
    const blob = await DB.get('audio', P.id);
    if (!blob) { P.audio = null; return; }
    AU.buffer = await decodeAudio(await blob.arrayBuffer());
    computePeaks();
  } catch (e) { console.error(e); toast('No se pudo cargar el audio del proyecto'); }
}
$('btnAudio').onclick = () => { stopPlayback(); AU.buffer ? audioMenu() : $('audioFile').click(); };
$('audioFile').onchange = async e => {
  const file = e.target.files && e.target.files[0];
  e.target.value = '';
  if (!file || !P) return;
  busy(true, 'Cargando audio…', 0.3);
  try {
    const buf = await decodeAudio(await file.arrayBuffer());
    await DB.put('audio', file, P.id);
    AU.buffer = buf;
    P.audio = { name: file.name.replace(/\.[^.]+$/, '').slice(0, 40), volume: 1, muted: false, duration: buf.duration };
    computePeaks();
    busy(false);
    const need = Math.ceil(buf.duration * P.fps);
    if (need > P.frames) {
      const ok = await confirmDlg('Duración del audio', 'El audio dura ' + buf.duration.toFixed(1) + ' s (' + need + ' cuadros a ' + P.fps + ' fps). Tu animación tiene ' + P.frames + ' cuadros. ¿Alargar la animación para que dure lo mismo que el audio?', 'Alargar');
      if (ok) { for (const L of P.layers) while (L.cells.length < need) L.cells.push(null); P.frames = need; }
    }
    structural('Añadir audio');
    toast('Audio añadido: ' + P.audio.name);
  } catch (err) {
    busy(false); console.error(err);
    toast('No se pudo leer ese audio. Prueba con MP3, WAV, M4A u OGG.', 4000);
  }
};
async function audioMenu() {
  if (!P.audio) { $('audioFile').click(); return; }
  const vol = el('input', { type: 'range', min: 0, max: 100, value: Math.round(P.audio.volume * 100), id: 'auVol' });
  const volV = el('output', { text: Math.round(P.audio.volume * 100) + '%' });
  vol.oninput = () => { volV.textContent = vol.value + '%'; };
  const mute = el('input', { type: 'checkbox', id: 'auMute' }); mute.checked = P.audio.muted;
  const body = el('div', { class: 'form' }, [
    el('p', { class: 'note', text: P.audio.name + ' · ' + (P.audio.duration || AU.buffer.duration).toFixed(1) + ' s' }),
    el('label', {}, [el('span', {}, ['Volumen ', volV]), vol]),
    el('label', { class: 'chk' }, [mute, 'Silenciar']),
  ]);
  const r = await dialog({ title: 'Audio', body, buttons: [{ label: 'Quitar audio', value: 'remove', danger: true }, { label: 'Cambiar', value: 'replace' }, { label: 'Listo', value: 'ok', primary: true }] });
  if (!r) return;
  P.audio.volume = vol.value / 100; P.audio.muted = mute.checked;
  if (r === 'remove') {
    if (await confirmDlg('Quitar audio', 'Se quitará la pista de audio del proyecto.', 'Quitar', true)) {
      await DB.del('audio', P.id); P.audio = null; AU.buffer = null; AU.peaks = null; structural('Quitar audio');
    }
    return;
  }
  if (r === 'replace') { $('audioFile').click(); }
  scheduleSave(); buildHeads(); requestTimeline(); updateFrameUI();
}
/* ---------- 75-exportar.js ---------- */
/* =========================================================
   Exportar
   ========================================================= */
function b64(u8) {
  let s = '';
  for (let i = 0; i < u8.length; i += 0x8000) s += String.fromCharCode.apply(null, u8.subarray(i, i + 0x8000));
  return btoa(s);
}
async function saveBinary(name, mime, data) {
  const u8 = data instanceof Uint8Array ? data : new Uint8Array(data);
  if (window.AndroidBridge) {
    const tok = window.AndroidBridge.beginFile(name, mime);
    if (!tok || tok.startsWith('ERROR')) throw new Error(tok || 'No se pudo crear el archivo');
    const CH = 384 * 1024;
    for (let off = 0; off < u8.length; off += CH) {
      const ok = window.AndroidBridge.appendFile(tok, b64(u8.subarray(off, off + CH)));
      if (!ok) { window.AndroidBridge.abortFile(tok); throw new Error('Error al escribir el archivo'); }
      if ((off / CH) % 8 === 7) await sleep(0);
    }
    const r = window.AndroidBridge.finishFile(tok);
    if (!r || r.startsWith('ERROR')) throw new Error(r || 'No se pudo terminar el archivo');
    return r;
  }
  const url = URL.createObjectURL(new Blob([u8], { type: mime }));
  const a = el('a', { href: url, download: name }); document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 30000);
  return 'Descargado: ' + name;
}
const safeName = s => (s || 'animacion').replace(/[^\w\-áéíóúñÁÉÍÓÚÑ ]+/g, '').trim().replace(/\s+/g, '_').slice(0, 40) || 'animacion';
async function exportPng() {
  stopPlayback();
  busy(true, 'Exportando imagen…', 0.5);
  try {
    const c = mkCanvas(P.w, P.h);
    await compositeFrameAsync(ctx2d(c), cur.frame, P.w, P.h, true, true);
    const blob = await canvasToBlob(c);
    const r = await saveBinary(safeName(P.name) + '_cuadro' + (cur.frame + 1) + '.png', 'image/png', await blob.arrayBuffer());
    busy(false); toast(r, 3500);
  } catch (e) { busy(false); toast('Error al exportar: ' + e.message, 4000); }
}
async function pickVideoCodec(w, h, fps, bitrate) {
  const cands = [
    { codec: 'avc1.640028', mux: 'avc' }, { codec: 'avc1.4d0028', mux: 'avc' }, { codec: 'avc1.42001f', mux: 'avc' },
    { codec: 'vp09.00.40.08', mux: 'vp9' }, { codec: 'vp09.00.10.08', mux: 'vp9' },
  ];
  for (const c of cands) {
    const cfg = { codec: c.codec, width: w, height: h, bitrate, framerate: fps };
    if (c.mux === 'avc') cfg.avc = { format: 'avc' };
    try { const r = await VideoEncoder.isConfigSupported(cfg); if (r.supported) return { cfg, mux: c.mux }; } catch (e) { }
  }
  return null;
}
async function pickAudioCodec(sr, ch) {
  if (!('AudioEncoder' in window)) return null;
  const cands = [{ codec: 'mp4a.40.2', mux: 'aac', sr }, { codec: 'opus', mux: 'opus', sr: 48000 }];
  for (const c of cands) {
    const cfg = { codec: c.codec, sampleRate: c.sr, numberOfChannels: ch, bitrate: 128000 };
    try { const r = await AudioEncoder.isConfigSupported(cfg); if (r.supported) return { cfg, mux: c.mux }; } catch (e) { }
  }
  return null;
}
async function resample(buffer, sr) {
  if (buffer.sampleRate === sr) return buffer;
  const ch = Math.min(2, buffer.numberOfChannels);
  const oc = new OfflineAudioContext(ch, Math.ceil(buffer.duration * sr), sr);
  const s = oc.createBufferSource(); s.buffer = buffer; s.connect(oc.destination); s.start();
  return await oc.startRendering();
}
async function exportVideoDialog() {
  stopPlayback();
  if (!('VideoEncoder' in window) || !('VideoFrame' in window)) {
    await dialog({ title: 'Exportar video', body: 'Este dispositivo no permite crear videos. Actualiza «Android System WebView» desde Google Play y vuelve a intentarlo.' });
    return;
  }
  const sizeSel = el('select', { id: 'exSize' }, [
    el('option', { value: '1', text: 'Tamaño completo (' + P.w + ' × ' + P.h + ')' }),
    el('option', { value: '0.5', text: 'Mitad (' + Math.round(P.w / 2) + ' × ' + Math.round(P.h / 2) + ')' }),
  ]);
  const withAudio = el('input', { type: 'checkbox', id: 'exAudio' }); withAudio.checked = !!audioOn();
  const kids = [el('label', {}, ['Resolución', sizeSel])];
  if (AU.buffer) kids.push(el('label', { class: 'chk' }, [withAudio, 'Incluir audio']));
  kids.push(el('p', { class: 'note', text: P.frames + ' cuadros a ' + P.fps + ' fps = ' + (P.frames / P.fps).toFixed(1) + ' s. El video se guarda en Películas/Artlas 2D.' }));
  const ok = await dialog({ title: 'Exportar video MP4', body: el('div', { class: 'form' }, kids), buttons: [{ label: 'Cancelar', value: false }, { label: 'Exportar', value: true, primary: true }] });
  if (!ok) return;
  try {
    const r = await exportVideo(+sizeSel.value, AU.buffer ? withAudio.checked : false);
    if (r) toast(r, 4000);
  } catch (e) { console.error(e); busy(false); await dialog({ title: 'No se pudo exportar', body: String(e && e.message || e) }); }
}
async function exportVideo(scale, includeAudio) {
  const even = v => Math.max(2, Math.round(v / 2) * 2);
  const w = even(P.w * scale), h = even(P.h * scale), fps = P.fps;
  const bitrate = clamp(Math.round(w * h * fps * 0.2), 1_000_000, 16_000_000);
  const v = await pickVideoCodec(w, h, fps, bitrate);
  if (!v) throw new Error('No hay ningún códec de video disponible en este dispositivo para ' + w + '×' + h + '.');
  let a = null, abuf = null;
  if (includeAudio && AU.buffer) {
    const ch = Math.min(2, AU.buffer.numberOfChannels);
    a = await pickAudioCodec(AU.buffer.sampleRate, ch);
    if (a) abuf = await resample(AU.buffer, a.cfg.sampleRate);
    else toast('Este dispositivo no puede codificar audio: el video saldrá sin sonido', 4000);
  }
  const muxer = new Mp4Muxer.Muxer({
    target: new Mp4Muxer.ArrayBufferTarget(),
    video: { codec: v.mux, width: w, height: h, frameRate: fps },
    audio: a ? { codec: a.mux, numberOfChannels: a.cfg.numberOfChannels, sampleRate: a.cfg.sampleRate } : undefined,
    fastStart: 'in-memory', firstTimestampBehavior: 'offset',
  });
  let encErr = null;
  const venc = new VideoEncoder({ output: (chunk, meta) => muxer.addVideoChunk(chunk, meta), error: e => { encErr = e; } });
  venc.configure(v.cfg);
  const c = mkCanvas(w, h), t = ctx2d(c);
  busyCancel = false;
  const dur = Math.round(1e6 / fps);
  try {
    for (let f = 0; f < P.frames; f++) {
      if (busyCancel) throw new Error('cancel');
      if (encErr) throw encErr;
      busy(true, 'Exportando video… cuadro ' + (f + 1) + ' de ' + P.frames, f / P.frames * (a ? 0.85 : 1));
      await compositeFrameAsync(t, f, w, h, true, true);
      const vf = new VideoFrame(c, { timestamp: f * dur, duration: dur });
      venc.encode(vf, { keyFrame: f % (fps * 2) === 0 });
      vf.close();
      while (venc.encodeQueueSize > 3) await sleep(4);
      if (f % 4 === 3) { trimCache(); await raf(); }
    }
    await venc.flush();
    if (encErr) throw encErr;
    venc.close();
    if (a && abuf) {
      busy(true, 'Exportando audio…', 0.9);
      const aenc = new AudioEncoder({ output: (chunk, meta) => muxer.addAudioChunk(chunk, meta), error: e => { encErr = e; } });
      aenc.configure(a.cfg);
      const sr = abuf.sampleRate, ch = a.cfg.numberOfChannels;
      const total = Math.min(abuf.length, Math.round(P.frames / fps * sr));
      const vol = P.audio ? P.audio.volume : 1;
      const srcCh = []; for (let i = 0; i < ch; i++) srcCh.push(abuf.getChannelData(Math.min(i, abuf.numberOfChannels - 1)));
      const N = 4096;
      for (let off = 0; off < total; off += N) {
        if (busyCancel) throw new Error('cancel');
        const n = Math.min(N, total - off);
        const data = new Float32Array(n * ch);
        for (let k = 0; k < ch; k++) { const src = srcCh[k]; for (let i = 0; i < n; i++) data[k * n + i] = src[off + i] * vol; }
        const ad = new AudioData({ format: 'f32-planar', sampleRate: sr, numberOfFrames: n, numberOfChannels: ch, timestamp: Math.round(off / sr * 1e6), data });
        aenc.encode(ad); ad.close();
        while (aenc.encodeQueueSize > 8) await sleep(2);
      }
      await aenc.flush();
      if (encErr) throw encErr;
      aenc.close();
    }
    muxer.finalize();
    busy(true, 'Guardando video…', 0.97);
    const r = await saveBinary(safeName(P.name) + '.mp4', 'video/mp4', muxer.target.buffer);
    busy(false);
    return r;
  } catch (e) {
    busy(false);
    try { if (venc.state !== 'closed') venc.close(); } catch (_) { }
    if (e && e.message === 'cancel') return 'Exportación cancelada';
    throw e;
  }
}
window.__trazoExportForTest = (scale, aud) => exportVideo(scale, aud);
/* ---------- 80-menu.js ---------- */
/* =========================================================
   Menú y ajustes
   ========================================================= */
async function projectSettings() {
  const name = el('input', { type: 'text', value: P.name, maxlength: 60, id: 'psName' });
  const fps = el('input', { type: 'number', min: 1, max: 60, value: P.fps, id: 'psFps' });
  const frames = el('input', { type: 'number', min: 1, max: 5000, value: P.frames, id: 'psFrames' });
  const prev = el('input', { type: 'number', min: 0, max: 8, value: P.onion.prev, id: 'psOnPrev' });
  const next = el('input', { type: 'number', min: 0, max: 8, value: P.onion.next, id: 'psOnNext' });
  const paper = el('input', { type: 'color', value: P.paper, id: 'psPaper' });
  const body = el('div', { class: 'form' }, [
    el('label', {}, ['Nombre', name]),
    el('div', { class: 'row2' }, [el('label', {}, ['Cuadros por segundo', fps]), el('label', {}, ['Total de cuadros', frames])]),
    el('div', { class: 'row2' }, [el('label', {}, ['Cebolla: anteriores', prev]), el('label', {}, ['Cebolla: siguientes', next])]),
    el('label', {}, ['Color del papel', paper]),
    el('p', { class: 'note', text: 'Resolución: ' + P.w + ' × ' + P.h }),
  ]);
  const ok = await dialog({ title: 'Ajustes del proyecto', body, buttons: [{ label: 'Cancelar', value: false }, { label: 'Guardar', value: true, primary: true }] });
  if (!ok) return;
  P.name = name.value.trim().slice(0, 60) || P.name; $('pname').textContent = P.name;
  if (/^#[0-9a-f]{6}$/i.test(paper.value)) P.paper = paper.value.toLowerCase();
  const newFps = clamp(parseInt(fps.value, 10) || P.fps, 1, 60);
  const nf = clamp(parseInt(frames.value, 10) || P.frames, 1, 5000);
  P.onion.prev = clamp(parseInt(prev.value, 10) || 0, 0, 8); P.onion.next = clamp(parseInt(next.value, 10) || 0, 0, 8);
  if (nf < P.frames) {
    const lost = P.layers.some(L => L.cells.slice(nf).some(Boolean));
    if (lost && !(await confirmDlg('Reducir duración', 'Se borrarán los cuadros ' + (nf + 1) + ' a ' + P.frames + '.', 'Reducir', true))) { scheduleSave(); return; }
    for (const L of P.layers) L.cells.length = nf;
  } else for (const L of P.layers) while (L.cells.length < nf) L.cells.push(null);
  P.frames = nf; cur.frame = Math.min(cur.frame, nf - 1);
  if (newFps !== P.fps) { P.fps = newFps; if (AU.buffer) computePeaks(); }
  structural('Ajustes del proyecto');
}
async function showHelp() {
  const items = [
    ['Dibujar', 'Un dedo o el lápiz. Con lápiz, el pincel responde a la presión.'],
    ['Zoom, mover y girar', 'Dos dedos. Junta o separa para zoom; gira para rotar la hoja (se endereza sola cerca de 0°).'],
    ['Deshacer rápido', 'Toca con dos dedos a la vez.'],
    ['Exposición', '«Extender →» mantiene el mismo dibujo en el cuadro siguiente. Si editas ese dibujo, cambia en todos los cuadros donde aparece. «Separar» lo vuelve independiente.'],
    ['Papel cebolla', 'Rojo: dibujos anteriores. Verde: dibujos siguientes.'],
    ['Relleno', '«Cerrar huecos» rellena aunque la línea tenga pequeños cortes. «Usar todas las capas» permite pintar en una capa de color debajo de la capa de líneas.'],
    ['Pinceles', 'Toca otra vez el pincel para elegir entre Pincel, Tinta, Rotulador, Grafito, Cera y Aerógrafo.'],
    ['Simetría', 'El botón de guías activa el dibujo en espejo (vertical, horizontal o en cuatro) y la cuadrícula, tercios o zona segura.'],
    ['Capas', 'En Ajustes de cada capa puedes cambiar su modo de fusión: Multiplicar para sombras, Trama o Añadir luz para brillos.'],
    ['Lazo', 'Rodea parte del dibujo. Arrástrala para moverla, usa una esquina para escalar y el punto rosa para girar. «Listo» la fija.'],
    ['Cuadros', 'Toca una miniatura para ir a ese cuadro. Tócala otra vez para duplicar, extender, copiar, pegar o eliminar.'],
    ['Herramientas', 'Toca dos veces el pincel o el bote para ver sus ajustes. Los deslizadores de la derecha cambian tamaño y opacidad.'],
    ['Personajes por piezas', 'Panel Animar → «Punto de giro» en cada articulación y «Pegada a» la pieza de arriba (mano → antebrazo → brazo → cuerpo). Al girar el brazo, la mano va con él. «Estirar ancho / alto» sirve para aplastar y estirar.'],
    ['Sustitución y labios', 'Menú → «Cambiar dibujo» pone cualquier dibujo de la capa en el cuadro actual. «Labios automáticos» elige la boca de cada cuadro según la voz del audio.'],
    ['Efectos', 'Menú → «Efectos de la capa»: sombra proyectada, resplandor, desenfoque, brillo, contraste, saturación, tono y teñido.'],
    ['Tinta y color', 'Menú → «Tinta y color»: marca la capa de la línea como referencia y rellena en otra capa debajo; el color entra bajo la línea (ajuste «Bajo la línea» del bote). «Colores con nombre» recolorea un color en todos los dibujos. «Línea de color» tiñe la línea con el relleno. «Sombras / brillos automáticos» crean capas recortadas que puedes retocar.'],
    ['Tiempo de anime', 'Menú del cuadro → «Duración del dibujo» (a 1s, 2s, 3s) y «Marcar: clave / extremo / intermedio». Menú → «Hoja de tiempos» muestra todo como la hoja de un estudio. Mantén pulsado el botón del papel cebolla para sus ajustes: hasta 8 dibujos, colores, solo claves, ayuda para intercalar y mesa de luz.'],
    ['Línea limpia', 'Toca dos veces el pincel → «Cuerda»: el trazo solo avanza cuando el lápiz se aleja, para líneas limpias de anime. Tres dedos = rehacer.'],
    ['Anime', 'Menú → «Efectos de anime»: aura de energía que se mueve sola, luz de contorno, sombra de dos tonos y destellos, con estilos listos (Ultra instinto, aura dorada…). «Efectos de escena»: líneas de velocidad, temblor, resplandor, aberración cromática, destello y grano entre los cuadros que elijas.'],
    ['Teclado', 'B pincel · P lápiz · E borrador · F relleno · S formas · L lazo · I cuentagotas · Espacio reproducir · , y . cuadros · Ctrl+Z/Y/C/V'],
  ];
  const body = el('div', { class: 'form' }, items.map(([a, b]) => el('p', { class: 'note', html: '<b style="color:var(--text)">' + escapeHtml(a) + ':</b> ' + escapeHtml(b) })));
  await dialog({ title: 'Cómo se usa', body });
}
$('btnMenu').onclick = async () => {
  stopPlayback(); commitSel();
  const mk = (v, t, s) => el('button', { html: escapeHtml(t) + (s ? '<small>' + escapeHtml(s) + '</small>' : ''), onclick: () => closeDialog(v) });
  const body = el('div', { class: 'menu' }, [
    mk('video', 'Exportar video MP4', 'Con audio, listo para compartir'),
    mk('png', 'Exportar cuadro como PNG', 'Imagen del cuadro actual'),
    mk('pngseq', 'Exportar secuencia PNG', 'Todos los cuadros en un ZIP, con fondo transparente'),
    mk('swap', 'Cambiar dibujo de este cuadro', 'Sustitución: elige cualquier dibujo de la capa (bocas, manos, ojos…)'),
    mk('lips', 'Labios automáticos', 'La boca se mueve sola siguiendo la voz del audio'),
    mk('fx', 'Efectos de la capa', 'Sombra, resplandor, desenfoque, brillo, color'),
    mk('ink', '🖌️ Tinta y color', 'Línea de referencia, colores con nombre, línea de color, sombras y brillos'),
    mk('xsheet', '📋 Hoja de tiempos', 'Cuadros y dibujos como en un estudio; ritmo a 1s, 2s, 3s'),
    mk('onion', '🧅 Papel cebolla y mesa de luz', 'Cuántos dibujos, colores, opacidad, ayuda para intercalar'),
    mk('anime', '⚡ Efectos de anime', 'Aura de energía, luz de contorno, sombra de anime, destellos'),
    mk('scene', '🎬 Efectos de escena', 'Líneas de velocidad, temblor, resplandor, aberración, grano'),
    mk('image', 'Importar imagen', 'Fondo o referencia en una capa nueva'),
    mk('videoref', 'Importar vídeo (rotoscopia)', 'Un fotograma por cuadro en una capa de referencia'),
    mk('audio', P.audio ? 'Audio: ' + P.audio.name : 'Añadir audio', 'Música, voces o efectos (MP3, WAV, M4A, OGG)'),
    mk('settings', 'Ajustes del proyecto', 'Nombre, fps, duración, papel cebolla'),
    mk('pen', (penOnly ? '✓ ' : '') + 'Dibujar solo con lápiz', 'Los dedos solo mueven y hacen zoom (evita marcas con la palma)'),
    mk('backup', 'Copia de seguridad', 'Archivo .artlas con todo el proyecto'),
    mk('history', 'Historial', undoStack.length + ' acciones · mantén «Deshacer»'),
    mk('perf', 'Rendimiento', 'Perfil actual: ' + PERF.name),
    mk('help', 'Cómo se usa', 'Gestos, atajos y trucos'),
  ]);
  const r = await dialog({ title: P.name, body, buttons: [{ label: 'Cerrar', value: null }] });
  if (r === 'video') exportVideoDialog();
  else if (r === 'png') exportPng();
  else if (r === 'pngseq') exportPngSequence();
  else if (r === 'swap') swapDrawingDialog();
  else if (r === 'lips') lipSyncDialog();
  else if (r === 'fx') layerFxDialog();
  else if (r === 'anime') animeFxDialog();
  else if (r === 'xsheet') xsheetDialog();
  else if (r === 'ink') inkPaintDialog();
  else if (r === 'onion') onionDialog();
  else if (r === 'scene') sceneFxDialog();
  else if (r === 'image') $('imageFile').click();
  else if (r === 'videoref') $('videoFile').click();
  else if (r === 'audio') audioMenu();
  else if (r === 'settings') projectSettings();
  else if (r === 'pen') { penOnly = !penOnly; savePrefs(); toast(penOnly ? 'Ahora los dedos solo mueven la hoja' : 'Los dedos vuelven a dibujar'); }
  else if (r === 'help') showHelp();
  else if (r === 'perf') perfDialog();
  else if (r === 'history') historyPanel();
  else if (r === 'backup') { try { busy(true, 'Creando copia de seguridad…', 0.5); const m = await exportProjectBackup(P.id); busy(false); toast(m, 4000); } catch (e) { busy(false); toast('No se pudo crear la copia: ' + e.message, 4000); } }
};
/* ---------- 82-teclado.js ---------- */
/* =========================================================
   Teclado
   ========================================================= */
addEventListener('keydown', e => {
  if (e.key === ' ' && !/INPUT|SELECT|TEXTAREA/.test(document.activeElement.tagName)) spaceDown = true;
  if (!P || $('editor').hidden || !$('modal').hidden) return;
  if (/INPUT|SELECT|TEXTAREA/.test(document.activeElement.tagName)) return;
  const k = e.key.toLowerCase();
  if ((e.ctrlKey || e.metaKey) && k === 'z') { e.preventDefault(); e.shiftKey ? redo() : undo(); return; }
  if ((e.ctrlKey || e.metaKey) && k === 'y') { e.preventDefault(); redo(); return; }
  if ((e.ctrlKey || e.metaKey) && k === 'c') { e.preventDefault(); copyCell(); return; }
  if ((e.ctrlKey || e.metaKey) && k === 'v') { e.preventDefault(); pasteClip(); return; }
  if (SEL && (k === 'delete' || k === 'backspace')) { e.preventDefault(); deleteSel(); return; }
  if (SEL && k === 'enter') { e.preventDefault(); commitSel(); return; }
  if (e.ctrlKey || e.metaKey || e.altKey) return;
  const map = { b: 'brush', p: 'pencil', e: 'eraser', f: 'fill', s: 'shape', l: 'lasso', i: 'picker', v: 'move' };
  if (map[k]) { setTool(map[k]); return; }
  if (k === ',' || k === 'arrowleft') { stopPlayback(); setFrame(cur.frame - 1); }
  else if (k === '.' || k === 'arrowright') { stopPlayback(); setFrame(cur.frame + 1); }
  else if (k === 'arrowup') setLayer(cur.layer + 1);
  else if (k === 'arrowdown') setLayer(cur.layer - 1);
  else if (k === ' ') { e.preventDefault(); PB.playing ? stopPlayback() : startPlayback(); }
});
addEventListener('keyup', e => { if (e.key === ' ') spaceDown = false; });
addEventListener('keydown', e => {
  if (e.key !== 'Escape') return;
  if (presenting) exitPresent();
  else if (!$('modal').hidden) closeDialog(null);
  else if (!$('toolPop').hidden) closeToolPop();
  else if (!$('guidePop').hidden) $('guidePop').hidden = true;
  else if (!$('colorPop').hidden) closeColorPop();
  else if (!$('busy').hidden) busyCancel = true;
});
/* ---------- 84-deslizadores.js ---------- */
/* =========================================================
   Deslizadores verticales (tamaño y opacidad)
   ========================================================= */
function vslider(root, { min, max, curve, get, set, fmt, bubble }) {
  root.innerHTML = '<span class="vval"></span><div class="vtrack"><i class="vfill"></i><b class="vthumb"></b></div>';
  const tr = root.querySelector('.vtrack'), fill = root.querySelector('.vfill'), th = root.querySelector('.vthumb'), val = root.querySelector('.vval');
  const toT = v => Math.pow(clamp((v - min) / (max - min), 0, 1), 1 / curve);
  const fromT = t => min + (max - min) * Math.pow(clamp(t, 0, 1), curve);
  let bub = null;
  function draw() {
    const v = get(), t = toT(v);
    fill.style.height = (t * 100) + '%'; th.style.bottom = 'calc(' + (t * 100) + '% - 10px)'; val.textContent = fmt(v);
    if (bub) bubble(bub, v);
  }
  function at(e) { const r = tr.getBoundingClientRect(); set(Math.round(fromT(1 - (e.clientY - r.top) / r.height))); draw(); }
  root.addEventListener('pointerdown', e => {
    if (root.classList.contains('dis')) return;
    try { root.setPointerCapture(e.pointerId); } catch (_) { }
    bub = el('div', { class: 'vbubble' }, [el('i')]); root.appendChild(bub);
    at(e);
    const mv = ev => at(ev);
    const up = () => {
      root.removeEventListener('pointermove', mv); root.removeEventListener('pointerup', up); root.removeEventListener('pointercancel', up);
      if (bub) { bub.remove(); bub = null; } savePrefs();
    };
    root.addEventListener('pointermove', mv); root.addEventListener('pointerup', up); root.addEventListener('pointercancel', up);
  });
  return { draw };
}
const curTS = () => toolSettings[tool] || toolSettings.brush;
const sizeSlider = vslider($('sizeSlider'), {
  min: 1, max: 120, curve: 2, get: () => curTS().size, set: v => { curTS().size = clamp(v, 1, 120); }, fmt: v => String(v),
  bubble: (b, v) => { const i = b.firstChild, d = clamp(v * view.z, 2, 56); i.style.width = i.style.height = d + 'px'; i.style.background = tool === 'eraser' ? '#fff' : color; },
});
const opSlider = vslider($('opSlider'), {
  min: 5, max: 100, curve: 1, get: () => tool === 'eraser' ? 100 : curTS().opacity, set: v => { if (tool !== 'eraser') curTS().opacity = clamp(v, 5, 100); }, fmt: v => v + '%',
  bubble: (b, v) => { const i = b.firstChild; i.style.width = i.style.height = '40px'; i.style.background = color; i.style.opacity = v / 100; },
});

/* ----- ajustes de la herramienta (segundo toque) ----- */
function openToolPop(btn) {
  const t = btn.dataset.tool;
  if (t === 'eraser') { closeToolPop(); return; }
  $('optBrush').hidden = !(t === 'brush' || t === 'pencil'); $('optFill').hidden = t !== 'fill'; $('optLasso').hidden = t !== 'lasso'; $('optShape').hidden = t !== 'shape';
  $('brushGrid').hidden = $('brushLbl').hidden = $('brushPackRow').hidden = t !== 'brush';
  if (t === 'brush') renderBrushGrid();
  if (t === 'shape') renderShapeOpts();
  if (t === 'lasso') renderSelOpts();
  const pop = $('toolPop'); pop.hidden = false;
  const r = btn.getBoundingClientRect();
  pop.style.left = Math.min(r.right + 12, innerWidth - pop.offsetWidth - 8) + 'px';
  pop.style.top = clamp(r.top + r.height / 2 - pop.offsetHeight / 2, 8, innerHeight - pop.offsetHeight - 8) + 'px';
}
function closeToolPop() { $('toolPop').hidden = true; }
document.addEventListener('pointerdown', e => {
  if (!$('toolPop').hidden && !$('toolPop').contains(e.target) && !e.target.closest('.tool')) closeToolPop();
});
/* ---------- 85-seleccion.js ---------- */
/* =========================================================
   Selección con lazo, copiar, pegar e importar imagen
   ========================================================= */
let LS = null;        // lazo en curso
let SEL = null;       // selección flotante
let SD = null;        // arrastre sobre la selección
let clipboard = null; // dibujo copiado
const cloneCanvas = src => { const c = mkCanvas(src.width, src.height); ctx2d(c).drawImage(src, 0, 0); return c; };
const selMatrix = s => new DOMMatrix().translate(s.cx, s.cy).rotate(s.r * 180 / Math.PI).scale(s.s * (s.flip ? -1 : 1), s.s);
function selLocal(p) { const q = selMatrix(SEL).inverse().transformPoint(new DOMPoint(p.x, p.y)); return { x: q.x, y: q.y }; }
function selHit(p) {
  const k = 1 / (view.z * SEL.s), tol = 26 * k, l = selLocal(p), hw = SEL.w / 2, hh = SEL.h / 2;
  if (Math.hypot(l.x, l.y - (-hh - 34 * k)) < tol) return 'rotate';
  if (Math.abs(Math.abs(l.x) - hw) < tol && Math.abs(Math.abs(l.y) - hh) < tol) return 'scale';
  if (Math.abs(l.x) <= hw + tol * 0.4 && Math.abs(l.y) <= hh + tol * 0.4) return 'move';
  return null;
}
function showSelBar(on) { $('selBar').hidden = !on; }
function lassoDown(e, p) {
  if (SEL) {
    const h = selHit(p);
    if (h) { SD = { pid: e.pointerId, mode: h, p0: p, cx: SEL.cx, cy: SEL.cy, s: SEL.s, r: SEL.r }; return; }
    commitSel();
  }
  const L = P.layers[cur.layer];
  if (L.locked) { toast('La capa «' + L.name + '» está bloqueada'); return; }
  if (!L.visible) { toast('La capa «' + L.name + '» está oculta'); return; }
  if (selMode !== 'lasso') { TAP = { pid: e.pointerId, x: e.offsetX, y: e.offsetY, t: performance.now(), run: () => wandSelect(p) }; return; }
  LS = { pid: e.pointerId, pts: [p] };
  requestRender();
}
function lassoMove(p) {
  const l = LS.pts[LS.pts.length - 1];
  if (Math.hypot(p.x - l.x, p.y - l.y) > 2 / view.z) LS.pts.push(p);
  requestRender();
}
function selDrag(p) {
  const d = SD;
  if (d.mode === 'move') { SEL.cx = d.cx + p.x - d.p0.x; SEL.cy = d.cy + p.y - d.p0.y; }
  else if (d.mode === 'scale') {
    const a = Math.hypot(d.p0.x - d.cx, d.p0.y - d.cy) || 1, b = Math.hypot(p.x - d.cx, p.y - d.cy);
    SEL.s = clamp(d.s * b / a, 0.03, 30);
  } else {
    let r = d.r + Math.atan2(p.y - d.cy, p.x - d.cx) - Math.atan2(d.p0.y - d.cy, d.p0.x - d.cx);
    const q = Math.PI / 2, near = Math.round(r / q) * q;
    if (Math.abs(r - near) < 0.06) r = near;
    SEL.r = r;
  }
  requestRender();
}
function lassoEnd() {
  const pts = LS.pts; LS = null;
  if (pts.length < 3) { requestRender(); return; }
  const c = currentCellForEdit(false);
  if (!c) { if (!P.layers[cur.layer].cells[cur.frame]) toast('No hay dibujo en esta celda'); requestRender(); return; }
  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
  for (const q of pts) { x0 = Math.min(x0, q.x); y0 = Math.min(y0, q.y); x1 = Math.max(x1, q.x); y1 = Math.max(y1, q.y); }
  const box = clampBox({ x0: x0 - 1, y0: y0 - 1, x1: x1 + 1, y1: y1 + 1 });
  if (box.w < 2 || box.h < 2) { requestRender(); return; }
  const path = new Path2D(); path.moveTo(pts[0].x, pts[0].y); for (const q of pts) path.lineTo(q.x, q.y); path.closePath();
  const fl = mkCanvas(box.w, box.h), f = ctx2d(fl, { willReadFrequently: true });
  f.save(); f.translate(-box.x, -box.y); f.clip(path); f.drawImage(c.cv, 0, 0); f.restore();
  const d = f.getImageData(0, 0, box.w, box.h).data;
  let any = false; for (let i = 3; i < d.length; i += 4) if (d[i]) { any = true; break; }
  if (!any) { toast('No hay dibujo dentro de la selección'); requestRender(); return; }
  const before = crop(c.cv, 0, 0, P.w, P.h);
  const cc = ctx2d(c.cv); cc.save(); cc.globalCompositeOperation = 'destination-out'; cc.fill(path); cc.restore();
  SEL = { cellId: c.id, layerId: c.L.id, frame: cur.frame, created: false, before, cv: fl, cx: box.x + box.w / 2, cy: box.y + box.h / 2, w: box.w, h: box.h, s: 1, r: 0, flip: false };
  showSelBar(true); requestRender();
}
function commitSel() {
  const s = SEL; if (!s) return;
  SEL = null; SD = null; showSelBar(false);
  const L = P && P.layers.find(l => l.id === s.layerId), cv = getCellSync(s.cellId);
  if (!L || !cv) { requestRender(); return; }
  const c = ctx2d(cv);
  c.save(); const m = selMatrix(s); c.setTransform(m.a, m.b, m.c, m.d, m.e, m.f); c.imageSmoothingQuality = 'high';
  c.drawImage(s.cv, -s.w / 2, -s.h / 2); c.restore();
  pushUndo({ label: s.label || 'Mover selección', cellId: s.cellId, layerId: s.layerId, frame: s.frame, created: s.created, x: 0, y: 0, before: s.before, after: crop(cv, 0, 0, P.w, P.h) });
  afterEdit(s.cellId);
  if (s.exposeAll) { for (let f = 0; f < P.frames; f++) if (!L.cells[f]) L.cells[f] = s.cellId; structural('Exponer imagen en todos los cuadros'); }
}
function cancelSel() {
  const s = SEL; if (!s) return;
  SEL = null; SD = null; showSelBar(false);
  const L = P.layers.find(l => l.id === s.layerId), cv = getCellSync(s.cellId);
  if (cv) ctx2d(cv).putImageData(s.before, 0, 0);
  if (s.created && L && L.cells[s.frame] === s.cellId) { L.cells[s.frame] = null; cache.delete(s.cellId); }
  sceneDirty = true; requestRender(); requestTimeline(); updateFrameUI();
}
function deleteSel() {
  const s = SEL; if (!s) return;
  if (s.created) { cancelSel(); return; }
  SEL = null; SD = null; showSelBar(false);
  const cv = getCellSync(s.cellId); if (!cv) return;
  pushUndo({ label: 'Borrar selección', cellId: s.cellId, layerId: s.layerId, frame: s.frame, created: false, x: 0, y: 0, before: s.before, after: crop(cv, 0, 0, P.w, P.h) });
  afterEdit(s.cellId);
}
function contentBox(cv) {
  const d = ctx2d(cv, { willReadFrequently: true }).getImageData(0, 0, cv.width, cv.height).data, W = cv.width;
  let x0 = W, y0 = cv.height, x1 = -1, y1 = -1;
  for (let i = 3, p = 0; i < d.length; i += 4, p++) if (d[i]) { const x = p % W, y = (p / W) | 0; if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
