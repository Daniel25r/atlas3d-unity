  if (gap > 0) { const dil = dilate(barrier, W, H, gap); if (!dil[seed]) bar = dil; }
  if (bar[seed]) { toast('Toca dentro de un área cerrada'); if (c.created) { P.layers[cur.layer].cells[cur.frame] = null; cache.delete(c.id); } return; }
