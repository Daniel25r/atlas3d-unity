  if (!c) return;
  const bk = ctx2d(backupCv); bk.globalCompositeOperation = 'copy'; bk.drawImage(c.cv, 0, 0); bk.globalCompositeOperation = 'source-over';
  const ts = toolSettings[tool] || toolSettings.brush;
  const erase = tool === 'eraser';
  const def = tool === 'brush' ? brushDef() : { kind: 'path' };
