const redo = () => applyHistory(redoStack, undoStack, 'redo');
function crop(cv, x, y, w, h) { return ctx2d(cv).getImageData(x, y, w, h); }
function clampBox(b) {
  const x = clamp(Math.floor(b.x0), 0, P.w), y = clamp(Math.floor(b.y0), 0, P.h);
  const x1 = clamp(Math.ceil(b.x1), 0, P.w), y1 = clamp(Math.ceil(b.y1), 0, P.h);
