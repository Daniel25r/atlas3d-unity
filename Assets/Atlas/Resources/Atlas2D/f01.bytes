    const top = m.transformPoint(new DOMPoint(0, -hh)), rh = m.transformPoint(new DOMPoint(0, -hh - 34 / (view.z * SEL.s)));
    c.save(); c.lineWidth = 1.6 * k; c.setLineDash([7 * k, 5 * k]); c.strokeStyle = '#b04dff';
