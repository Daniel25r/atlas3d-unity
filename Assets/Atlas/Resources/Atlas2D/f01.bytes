$('selDone').onclick = () => commitSel();
$('selDelete').onclick = () => deleteSel();
$('selFlip').onclick = () => { if (SEL) { SEL.flip = !SEL.flip; requestRender(); } };
$('selCopy').onclick = () => copyCell();
$('btnCopy').onclick = () => { if (P) copyCell(); };
$('btnPaste').onclick = () => pasteClip();
$('imageFile').onchange = async e => {
  const file = e.target.files && e.target.files[0];
  e.target.value = '';
  if (!file || !P) return;
  try {
    const bm = await createImageBitmap(file);
    const sc = Math.min(1, (P.w * 0.9) / bm.width, (P.h * 0.9) / bm.height);
    const w = Math.max(1, Math.round(bm.width * sc)), h = Math.max(1, Math.round(bm.height * sc));
    const cv = mkCanvas(w, h); ctx2d(cv).drawImage(bm, 0, 0, w, h); if (bm.close) bm.close();
    stopPlayback(); commitSel();
    addLayer(); P.layers[cur.layer].name = 'Imagen';
    const c = currentCellForEdit(true); if (!c) return;
    SEL = { cellId: c.id, layerId: c.L.id, frame: cur.frame, created: c.created, before: crop(c.cv, 0, 0, P.w, P.h), cv, cx: P.w / 2, cy: P.h / 2, w, h, s: 1, r: 0, flip: false, exposeAll: true, label: 'Importar imagen' };
    buildHeads(); setTool('lasso', true); showSelBar(true); requestRender(); updateFrameUI();
    toast('Coloca la imagen y pulsa «Listo». Quedará en todos los cuadros vacíos de esa capa.', 3500);
  } catch (err) { console.error(err); toast('No se pudo abrir esa imagen'); }
};
/* ---------- 86-tira.js ---------- */
/* =========================================================
   Tira de cuadros con miniaturas
   ========================================================= */
const STRIP = { els: [], vis: new Set(), queue: new Set(), busy: false, io: null, last: -1 };
function buildStrip() {
  const s = $('strip');
  if (STRIP.io) STRIP.io.disconnect();
  s.innerHTML = ''; STRIP.els = []; STRIP.vis.clear(); STRIP.queue.clear(); STRIP.last = -1;
  if (!P) return;
  const ratio = clamp(P.w / P.h, 0.5, 2.4), ch = 96, cw = Math.round(ch * ratio);
  STRIP.io = new IntersectionObserver(ents => {
    for (const en of ents) {
      const f = +en.target.dataset.f;
      if (en.isIntersecting) { STRIP.vis.add(f); if (!en.target.dataset.drawn) queueThumb(f); } else STRIP.vis.delete(f);
    }
  }, { root: s, rootMargin: '0px 240px' });
  const frag = document.createDocumentFragment();
  for (let f = 0; f < P.frames; f++) {
    const b = el('button', { class: 'fr', 'aria-label': 'Cuadro ' + (f + 1) });
    b.dataset.f = f;
    b.append(mkCanvas(cw, ch), el('span', { text: String(f + 1) }));
    b.onclick = () => onThumbClick(f);
    STRIP.els.push(b); frag.appendChild(b);
  }
  const add = el('button', { class: 'fr add', title: 'Nuevo cuadro después del actual', 'aria-label': 'Nuevo cuadro', text: '+' });
  add.style.width = 'calc(var(--thumbH) * ' + ratio.toFixed(3) + ')';
  add.onclick = () => guard(insertFrame)();
  frag.appendChild(add);
  s.appendChild(frag);
  for (const b of STRIP.els) STRIP.io.observe(b);
  markStrip();
}
function markStrip() {
  if (!P || !STRIP.els.length) return;
  const L = P.layers[cur.layer];
  if (STRIP.last >= 0 && STRIP.els[STRIP.last]) STRIP.els[STRIP.last].classList.remove('on');
  const b = STRIP.els[cur.frame];
  if (b) {
    b.classList.add('on');
    if (STRIP.last !== cur.frame && !STRIP.tapped) {
      // solo se desplaza lo justo si el cuadro actual queda fuera de la vista (reproducción, flechas)
      const s = $('strip'), sr = s.getBoundingClientRect(), br = b.getBoundingClientRect();
      if (br.left < sr.left) s.scrollLeft -= sr.left - br.left + 6;
      else if (br.right > sr.right) s.scrollLeft += br.right - sr.right + 6;
    }
    STRIP.tapped = false;
  }
  STRIP.last = cur.frame;
  STRIP.els.forEach((e, f) => { e.classList.toggle('held', f > 0 && !!L.cells[f] && L.cells[f] === L.cells[f - 1]); e.classList.toggle('kf', anyKeyAt(L.keys, f) || anyKeyAt(P.camera && P.camera.keys, f)); });
}
function onThumbClick(f) {
  if (!P) return;
  if (f === cur.frame && !PB.playing) { frameMenu(); return; }
  STRIP.tapped = true; // el usuario tocó la miniatura: la tira no se mueve
  stopPlayback(); setFrame(f);
  STRIP.tapped = false;
}
function queueThumb(f) { STRIP.queue.add(f); if (!STRIP.busy) runThumbs(); }
async function runThumbs() {
  STRIP.busy = true;
  const proj = P;
  try {
    while (STRIP.queue.size && P === proj) {
      if (PB.playing || S || SEL || LS) { await sleep(200); continue; }
      const f = STRIP.queue.values().next().value; STRIP.queue.delete(f);
      const b = STRIP.els[f];
      if (!b || f >= P.frames || !STRIP.vis.has(f)) continue;
      const c = b.firstChild;
      await compositeFrameAsync(ctx2d(c), f, c.width, c.height, true);
      b.dataset.drawn = '1';
      await sleep(0);
    }
  } catch (e) { /* las miniaturas se reintentan al volver a verse */ } finally { STRIP.busy = false; }
}
function thumbDirty(f) { const b = STRIP.els[f]; if (!b) return; delete b.dataset.drawn; if (STRIP.vis.has(f)) queueThumb(f); }
async function frameMenu() {
  stopPlayback(); commitSel();
  const L = P.layers[cur.layer], id = L.cells[cur.frame];
  const mk = (v, t, s, cls) => el('button', { class: cls || '', html: escapeHtml(t) + (s ? '<small>' + escapeHtml(s) + '</small>' : ''), onclick: () => closeDialog(v) });
  const items = [mk('dup', 'Duplicar cuadro', 'Copia independiente'), mk('add', 'Insertar vacío', 'Después de este'), mk('extend', 'Extender →', 'Mantener el dibujo un cuadro más')];
  if (id && isShared(cur.layer, cur.frame)) items.push(mk('split', 'Separar', 'Hacerlo un dibujo independiente'));
  items.push(mk('hold', 'Duración del dibujo…', id ? 'Ahora: ' + runAt(L, cur.frame).len + ' cuadros · a 1s, 2s, 3s' : 'Ritmo de toda la capa'));
  if (id) items.push(mk('mark', 'Marcar: clave / extremo / intermedio', markOf(id) ? 'Ahora: ' + MARKS[markOf(id)][0] : 'Sin marca'));
  if (id) items.push(mk('light', (P.light || []).indexOf(id) >= 0 ? 'Quitar de la mesa de luz' : 'Fijar en mesa de luz', 'Verlo en azul mientras dibujas otros cuadros'));
  items.push(mk('copy', 'Copiar dibujo', 'De la capa «' + L.name + '»'), mk('paste', 'Pegar', clipboard ? 'Como selección movible' : 'Primero copia algo'));
  if (id) items.push(mk('clear', 'Borrar dibujo', 'Solo en la capa «' + L.name + '»', 'danger'));
  if (cur.frame > 0) items.push(mk('left', '← Mover antes', 'Intercambia con el cuadro ' + cur.frame));
  if (cur.frame < P.frames - 1) items.push(mk('right', 'Mover después →', 'Intercambia con el cuadro ' + (cur.frame + 2)));
  if (P.frames > 1) items.push(mk('del', 'Eliminar cuadro', 'En todas las capas', 'danger'));
  const r = await dialog({ title: 'Cuadro ' + (cur.frame + 1), body: el('div', { class: 'menu' }, items), buttons: [{ label: 'Cerrar', value: null }] });
  const act = { hold: holdDialog, mark: markDialog, light: toggleLightTable, dup: duplicateFrame, add: insertFrame, extend: extendExposure, split: splitCell, del: deleteFrame, clear: clearCell, copy: copyCell, paste: pasteClip, left: () => moveFrame(-1), right: () => moveFrame(1) }[r];
  if (act) guard(act)();
}
/* ---------- 86b-varita.js ---------- */
/* =========================================================
   Varita mágica y selección por color
   ========================================================= */
let selMode = ['lasso', 'wand', 'color'].includes(prefs.selMode) ? prefs.selMode : 'lasso';
let wandTol = typeof prefs.wandTol === 'number' ? prefs.wandTol : 32;
// Crea una selección flotante con los píxeles marcados en `mask` (1 = seleccionado).
function liftMask(c, mask, label) {
  const W = P.w, H = P.h;
  let x0 = W, y0 = H, x1 = -1, y1 = -1;
  const src = ctx2d(c.cv, { willReadFrequently: true }).getImageData(0, 0, W, H), d = src.data;
  for (let i = 0; i < mask.length; i++) {
    if (!mask[i] || !d[i * 4 + 3]) continue;
    const x = i % W, y = (i / W) | 0;
    if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y;
  }
  if (x1 < 0) { toast('No hay dibujo en esa zona'); return false; }
  const bw = x1 - x0 + 1, bh = y1 - y0 + 1;
  const before = new ImageData(new Uint8ClampedArray(d), W, H);
  const fl = mkCanvas(bw, bh), ft = ctx2d(fl), fi = ft.createImageData(bw, bh), fd = fi.data;
  for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) {
    const i = y * W + x; if (!mask[i]) continue;
    const k = i * 4, o = ((y - y0) * bw + (x - x0)) * 4;
    fd[o] = d[k]; fd[o + 1] = d[k + 1]; fd[o + 2] = d[k + 2]; fd[o + 3] = d[k + 3];
    d[k + 3] = 0;
  }
  ft.putImageData(fi, 0, 0);
  ctx2d(c.cv).putImageData(src, 0, 0);
  SEL = { cellId: c.id, layerId: c.L.id, frame: cur.frame, created: false, before, cv: fl, cx: x0 + bw / 2, cy: y0 + bh / 2, w: bw, h: bh, s: 1, r: 0, flip: false, label };
  showSelBar(true); requestRender();
  return true;
}
function colorMatcher(d, k0, tol) {
  const r = d[k0], g = d[k0 + 1], b = d[k0 + 2], a = d[k0 + 3];
  const lim = 6 + tol * 4;
  if (a < 24) return k => d[k + 3] < 24;
  return k => d[k + 3] >= 24 && Math.abs(d[k] - r) + Math.abs(d[k + 1] - g) + Math.abs(d[k + 2] - b) + Math.abs(d[k + 3] - a) * 0.5 <= lim;
}
function wandSelect(p) {
  const x = Math.floor(p.x), y = Math.floor(p.y);
  if (x < 0 || y < 0 || x >= P.w || y >= P.h) return;
  const c = currentCellForEdit(false);
  if (!c) { if (!P.layers[cur.layer].cells[cur.frame]) toast('No hay dibujo en esta celda'); return; }
  const W = P.w, H = P.h, N = W * H;
  const d = ctx2d(c.cv, { willReadFrequently: true }).getImageData(0, 0, W, H).data;
  const k0 = (y * W + x) * 4;
  if (d[k0 + 3] < 24) { toast('Toca sobre una parte del dibujo'); return; }
  const match = colorMatcher(d, k0, wandTol);
  let mask;
  if (selMode === 'color') {
    mask = new Uint8Array(N);
    for (let i = 0; i < N; i++) if (match(i * 4)) mask[i] = 1;
  } else {
    const bar = new Uint8Array(N);
    for (let i = 0; i < N; i++) bar[i] = match(i * 4) ? 0 : 1;
    mask = floodMask(bar, W, H, x, y);
  }
  liftMask(c, mask, selMode === 'color' ? 'Selección por color' : 'Varita mágica');
}
function renderSelOpts() {
  segGroup($('selModeSeg'), [['lasso', 'Lazo'], ['wand', 'Varita mágica'], ['color', 'Por color']], () => selMode, v => { selMode = v; savePrefs(); syncSelOpts(); });
  $('wandTol').value = wandTol; $('wandTolV').textContent = wandTol;
  syncSelOpts();
}
function syncSelOpts() {
  $('wandRow').hidden = selMode === 'lasso';
  $('selHint').textContent = selMode === 'lasso' ? 'Rodea una parte del dibujo. Luego arrástrala para moverla, usa la esquina para escalar y el punto de arriba para girar.'
    : selMode === 'wand' ? 'Toca una zona: se seleccionan los píxeles conectados de color parecido en esta capa.'
      : 'Toca un color: se seleccionan todos los píxeles de ese color en esta capa, aunque estén separados.';
}
$('wandTol').oninput = e => { wandTol = +e.target.value; $('wandTolV').textContent = wandTol; savePrefs(); };
/* ---------- 86c-video.js ---------- */
/* =========================================================
   Importar vídeo (rotoscopia): el vídeo entra en una capa de
   referencia, un fotograma por cuadro, para dibujar encima.
   ========================================================= */
const videoSeek = (v, t) => new Promise(res => {
  let done = false;
  const fin = () => { if (done) return; done = true; v.removeEventListener('seeked', fin); res(); };
  v.addEventListener('seeked', fin);
  v.currentTime = t;
  setTimeout(fin, 4000);
});
const sleepMs = ms => new Promise(r => setTimeout(r, ms));
async function saveAndTrim() {
  while (saving) await sleepMs(40);
  await flushSave();
  trimCache();
}
async function importVideo(file) {
  if (!P || !file) return;
  stopPlayback(); commitSel();
  const url = URL.createObjectURL(file);
  const v = document.createElement('video');
  v.muted = true; v.playsInline = true; v.preload = 'auto'; v.src = url;
  try {
    await new Promise((res, rej) => {
      v.onloadeddata = res;
      v.onerror = () => rej(new Error('formato no compatible'));
      setTimeout(() => rej(new Error('tardó demasiado en abrir')), 20000);
    });
  } catch (e) {
    URL.revokeObjectURL(url);
    await dialog({ title: 'No se pudo abrir el vídeo', body: 'Este dispositivo no puede leer ese vídeo (' + e.message + '). Conviértelo a MP4 (H.264) con CapCut, InShot o cualquier editor y vuelve a probar.' });
    return;
  }
  const dur = isFinite(v.duration) ? v.duration : 0;
  if (!(dur > 0) || !v.videoWidth) { URL.revokeObjectURL(url); toast('Ese vídeo no tiene imagen que importar', 4000); return; }

  // Opciones
  const startIn = el('input', { type: 'number', min: '0', max: String(Math.floor(dur)), step: '0.1', value: '0' });
  const lenIn = el('input', { type: 'number', min: '0.1', max: String(dur.toFixed(1)), step: '0.1', value: String(Math.min(dur, 20).toFixed(1)) });
  const stepSel = el('select', {}, [
    el('option', { value: '1', text: 'Un fotograma por cuadro (más detalle)' }),
    el('option', { value: '2', text: 'Cada 2 cuadros («en dos», como el anime)' }),
    el('option', { value: '3', text: 'Cada 3 cuadros (más ligero)' }),
    el('option', { value: '4', text: 'Cada 4 cuadros (muy ligero)' }),
  ]);
  stepSel.value = P.fps >= 20 ? '2' : '1';
  const opIn = el('input', { type: 'range', min: '10', max: '100', value: '45' });
  const extend = el('input', { type: 'checkbox', checked: true });
  const lab = (t, input) => el('label', { class: 'field' }, [el('span', { text: t }), input]);
  const body = el('div', { class: 'form' }, [
    el('p', { class: 'note', text: 'El vídeo dura ' + dur.toFixed(1) + ' s. Entrará desde el cuadro actual (' + (cur.frame + 1) + ') en una capa nueva, bloqueada y semitransparente, para dibujar encima en otra capa.' }),
    lab('Empezar en el segundo', startIn),
    lab('Cuántos segundos', lenIn),
    lab('Fotogramas', stepSel),
    lab('Transparencia de la referencia', opIn),
    el('label', { class: 'chk' }, [extend, el('span', { text: ' Alargar la animación si el vídeo no cabe' })]),
  ]);
  const ok = await dialog({ title: 'Importar vídeo (rotoscopia)', body, buttons: [{ label: 'Cancelar', value: false }, { label: 'Importar', value: true, primary: true }] });
  if (!ok) { URL.revokeObjectURL(url); return; }
  const start = clamp(parseFloat(startIn.value) || 0, 0, Math.max(0, dur - 0.05));
  const len = clamp(parseFloat(lenIn.value) || dur, 0.05, dur - start);
  const step = clamp(parseInt(stepSel.value, 10) || 1, 1, 8);
  const first = cur.frame;
  let count = Math.max(1, Math.round(len * P.fps));
  if (extend.checked && first + count > P.frames) {
    const need = first + count;
    for (const L of P.layers) while (L.cells.length < need) L.cells.push(null);
    P.frames = need;
  }
  count = Math.min(count, P.frames - first);

  // Capa de referencia
  addLayer();
  const L = P.layers[cur.layer];
  L.name = 'Vídeo (referencia)';
  L.opacity = clamp((parseInt(opIn.value, 10) || 45) / 100, 0.05, 1);
  const sc = Math.min(P.w / v.videoWidth, P.h / v.videoHeight);
  const w = Math.round(v.videoWidth * sc), h = Math.round(v.videoHeight * sc);
  const x = Math.round((P.w - w) / 2), y = Math.round((P.h - h) / 2);
  busyCancel = false;
  busy(true, 'Importando vídeo…', 0);
  let made = 0;
  try {
    for (let i = 0; i < count && !busyCancel; i += step) {
      await videoSeek(v, Math.min(start + i / P.fps, dur - 0.01));
      const id = createCell();
      ctx2d(getCellSync(id)).drawImage(v, x, y, w, h);
      markCellDirty(id);
      // Un mismo dibujo dura los cuadros del paso (exposición).
      for (let k = 0; k < step && i + k < count; k++) L.cells[first + i + k] = id;
      made++;
      busy(true, 'Importando vídeo… ' + Math.min(count, i + step) + ' / ' + count, (i + step) / count);
      // Guarda a menudo para no llenar la memoria del móvil.
      if (made % 8 === 0) await saveAndTrim();
    }
  } catch (e) {
    console.error(e);
    toast('Se paró la importación: ' + (e && e.message || e), 4000);
  } finally {
    busy(false);
    URL.revokeObjectURL(url);
  }
  L.locked = true;
  structural('Importar vídeo');
  await saveAndTrim();
  toast(made + ' fotogramas del vídeo en la capa «' + L.name + '». Dibuja en otra capa; oculta esta antes de exportar.', 6000);
}
$('videoFile').onchange = async e => {
  const file = e.target.files && e.target.files[0];
  e.target.value = '';
  if (file) await importVideo(file);
};
/* ---------- 87-paneles.js ---------- */
/* =========================================================
   Panel de capas y línea de tiempo
   ========================================================= */
function renderLayersPanel() {
  if (!P) return;
  $('layerBadge').textContent = P.layers.length;
  if ($('layersPanel').hidden) return;
  const list = $('layerList'); list.innerHTML = '';
  const th = Math.round(64 * clamp(P.h / P.w, 0.3, 1.6));
  for (const li of visibleRows()) {
    const L = P.layers[li], grp = isGroup(L), d = depthOf(L);
    const sib = childrenOf(L.parent || null), clipped = !grp && L.clip && sib.indexOf(L) > 0;
    const row = el('div', { class: 'lrow' + (li === cur.layer ? ' on' : '') + (clipped ? ' clip' : '') + (grp ? ' grp' : '') });
    row.style.marginLeft = (d * 16 + (clipped ? 18 : 0)) + 'px';
    let thumb;
    if (grp) {
      thumb = el('button', { class: 'fold', title: L.collapsed ? 'Desplegar carpeta' : 'Plegar carpeta', 'aria-label': (L.collapsed ? 'Desplegar ' : 'Plegar ') + L.name, html: '<svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>' + (L.collapsed ? '<path d="m11 10 3 3-3 3"/>' : '<path d="m9 12 3 3 3-3"/>') + '</svg>' });
      thumb.onclick = ev => { ev.stopPropagation(); toggleCollapse(L); };
    } else {
      thumb = mkCanvas(128, Math.round(128 * P.h / P.w)); thumb.style.height = th + 'px';
      const t = ctx2d(thumb); t.fillStyle = '#fff'; t.fillRect(0, 0, thumb.width, thumb.height);
      const id = L.cells[cur.frame];
      if (id) { const src = getCellSync(id); if (src) t.drawImage(src, 0, 0, thumb.width, thumb.height); else loadCell(id).then(c => t.drawImage(c, 0, 0, thumb.width, thumb.height)).catch(() => { }); }
    }
    const eye = el('button', { class: 'mini' + (L.visible ? '' : ' off'), title: L.visible ? 'Ocultar' : 'Mostrar', 'aria-label': 'Visibilidad de ' + L.name, html: ICON_EYE });
    eye.onclick = ev => { ev.stopPropagation(); L.visible = !L.visible; layerChanged(); };
    const lock = el('button', { class: 'mini' + (L.locked ? ' lockon' : ' off'), title: L.locked ? 'Desbloquear' : 'Bloquear', 'aria-label': 'Bloqueo de ' + L.name, html: ICON_LOCK });
    lock.onclick = ev => { ev.stopPropagation(); L.locked = !L.locked; buildHeads(); renderLayersPanel(); scheduleSave(); };
    const info = grp ? 'Carpeta · ' + descendantsOf(L).filter(x => !isGroup(x)).length + ' capas · ' + blendName(L.blend) + ' · ' + Math.round(L.opacity * 100) + '%'
      : blendName(L.blend) + ' · ' + Math.round(L.opacity * 100) + '%' + (clipped ? ' · Recorte' : '') + (L.alphaLock ? ' · α' : '');
    row.append(thumb, el('span', { class: 'nm' }, [L.name, el('small', { text: info })]), eye, lock);
    row.onclick = () => setLayer(li);
    row.ondblclick = () => layerSettings(li);
    list.appendChild(row);
  }
  const L = P.layers[cur.layer];
  const firstSib = childrenOf(L.parent || null).indexOf(L) <= 0;
  $('btnClipLayer').classList.toggle('on', !!L.clip); $('btnClipLayer').disabled = isGroup(L) || firstSib;
  $('btnAlphaLock').classList.toggle('on', !!L.alphaLock); $('btnAlphaLock').disabled = isGroup(L);
  $('btnMergeLayer').disabled = isGroup(L);
  $('lpOpacity').value = Math.round(L.opacity * 100); $('lpOpacityV').textContent = Math.round(L.opacity * 100) + '%';
}
$('btnLayers').onclick = () => { const p = $('layersPanel'); if (p.hidden && animOpen()) toggleAnimPanel(false); p.hidden = !p.hidden; $('btnLayers').classList.toggle('tog', true); $('btnLayers').classList.toggle('on', !p.hidden); renderLayersPanel(); };
$('btnCloseLayers').onclick = () => { $('layersPanel').hidden = true; $('btnLayers').classList.remove('on'); };
$('btnClipLayer').onclick = () => { if (!P || isGroup(P.layers[cur.layer]) || childrenOf(P.layers[cur.layer].parent || null).indexOf(P.layers[cur.layer]) <= 0) return; commitSel(); const L = P.layers[cur.layer]; L.clip = !L.clip; layerChanged(); toast(L.clip ? 'Recortada a la capa de abajo' : 'Recorte desactivado'); };
$('btnAlphaLock').onclick = () => { if (!P) return; commitSel(); const L = P.layers[cur.layer]; L.alphaLock = !L.alphaLock; layerChanged(); toast(L.alphaLock ? 'Bloqueo alfa: solo pintas sobre lo ya dibujado' : 'Bloqueo alfa desactivado'); };
$('btnRenameLayer').onclick = () => { if (P) layerSettings(cur.layer); };
$('lpOpacity').oninput = e => { if (!P) return; P.layers[cur.layer].opacity = e.target.value / 100; $('lpOpacityV').textContent = e.target.value + '%'; sceneDirty = true; requestRender(); };
$('lpOpacity').onchange = () => { if (P) layerChanged(); };
function toggleTimeline(force) {
  const t = $('tl'), show = force !== undefined ? force : t.hidden;
  t.hidden = !show; $('btnTimeline').classList.toggle('on', show);
