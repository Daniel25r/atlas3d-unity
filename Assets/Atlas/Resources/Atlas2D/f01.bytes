function doRender() {
  renderQueued = false;
  if (!P || !SW) return;
  const c = sctx;
  c.setTransform(1, 0, 0, 1, 0, 0); c.globalAlpha = 1; c.globalCompositeOperation = 'source-over';
  c.fillStyle = presenting ? '#000000' : '#2a2a30'; c.fillRect(0, 0, stage.width, stage.height);
  const m = viewMatrix();
  c.setTransform(DPR, 0, 0, DPR, 0, 0); c.transform(m.a, m.b, m.c, m.d, m.e, m.f);
  c.imageSmoothingEnabled = view.z < 2; c.imageSmoothingQuality = 'high';
  drawPegBar(c);
  c.save(); c.shadowColor = 'rgba(0,0,0,.4)'; c.shadowBlur = 22; c.shadowOffsetY = 6; c.fillStyle = P.paper; c.fillRect(0, 0, P.w, P.h); c.restore();
  if (PB.playing) {
    const bm = PB.frames.get(PB.shown);
    if (bm) c.drawImage(bm, 0, 0, P.w, P.h);
  } else {
    const ready = !sceneDirty || rebuildScene();
    if (ready) sceneDirty = false;
    if (hasClipping() || anyMotion() || hasGroups() || anyFx() || sceneFxOn(cur.frame)) {
      // con máscaras de recorte se compone el cuadro completo
      const cc = tmpCanvas('comp', P.w, P.h), t = resetCtx(ctx2d(cc));
      t.clearRect(0, 0, P.w, P.h);
      if (ready) { drawOnionInto(t); composeLayers(t, cur.frame, P.w, P.h, getCellSync, true); }
      if (ready && sceneFxOn(cur.frame)) {
        t.globalCompositeOperation = 'destination-over'; t.fillStyle = P.paper || '#ffffff'; t.fillRect(0, 0, P.w, P.h);
        resetCtx(t); applySceneFx(cc, cur.frame, P.w, P.h);
      }
      c.drawImage(cc, 0, 0);
    } else {
      c.drawImage(belowCv, 0, 0);
      const L = P.layers[cur.layer];
      if (L && L.visible) {
