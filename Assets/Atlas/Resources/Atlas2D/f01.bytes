  if (L0.alphaLock && tool === 'eraser') { toast('Bloqueo alfa activo: desactívalo para borrar en «' + L0.name + '»'); return; }
  if (L0.alphaLock && !L0.cells[cur.frame]) { toast('Bloqueo alfa: solo puedes pintar sobre lo que ya está dibujado'); return; }
