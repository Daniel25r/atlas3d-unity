/* ---------- 20-vista.js ---------- */
/* =========================================================
   Vista (zoom, desplazamiento, rotación)
   ========================================================= */
const stage = $('stage'), sctx = stage.getContext('2d');
let SW = 0, SH = 0, DPR = 1;
const view = { x: 0, y: 0, z: 1, r: 0 };
const viewMatrix = () => new DOMMatrix().translate(view.x, view.y).rotate(view.r * 180 / Math.PI).scale(view.z);
function screenToWorld(sx, sy) { const p = viewMatrix().inverse().transformPoint(new DOMPoint(sx, sy)); return { x: p.x, y: p.y }; }
function fitView() {
  if (!P || !SW) return;
  const ml = presenting ? 0 : Math.min(84, SW * 0.12), mr = presenting ? 0 : Math.min(76, SW * 0.1), mv = presenting ? 0 : Math.max(14, Math.min(40, SH * 0.06));
  view.r = 0;
  view.z = Math.min((SW - ml - mr) / P.w, (SH - mv * 2) / P.h);
  view.x = ml + ((SW - ml - mr) - P.w * view.z) / 2; view.y = mv + ((SH - mv * 2) - P.h * view.z) / 2;
  requestRender();
}
function sizeStage() {
  const r = $('stagewrap').getBoundingClientRect();
  const first = !SW;
  DPR = Math.min(window.devicePixelRatio || 1, PERF.dprMax);
  if (r.width < 2 || r.height < 2) return;
  const oldW = SW, oldH = SH;
  SW = r.width; SH = r.height;
  stage.width = Math.round(SW * DPR); stage.height = Math.round(SH * DPR);
  if (P) { if (first || !oldW) fitView(); else { view.x += (SW - oldW) / 2; view.y += (SH - oldH) / 2; } }
  requestRender();
}
new ResizeObserver(sizeStage).observe($('stagewrap'));
function updateHud() {
  if (!P) return;
  const deg = Math.round(((view.r * 180 / Math.PI) % 360 + 360) % 360);
  $('hud').textContent = Math.round(view.z * 100) + '%' + (deg ? ' · ' + deg + '°' : '');
}

/* =========================================================
   Dibujo en pantalla
   ========================================================= */
let renderQueued = false, tlQueued = false;
function requestRender() { if (!renderQueued) { renderQueued = true; requestAnimationFrame(doRender); } }
