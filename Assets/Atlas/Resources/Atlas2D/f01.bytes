      const q = f({ x, y });
      if (o.scatter) { q.x += (Math.random() - 0.5) * 2 * o.scatter * w; q.y += (Math.random() - 0.5) * 2 * o.scatter * w; }
      const rot = rotMode === 'random' ? Math.random() * 6.2832 : rotMode === 'direction' ? (ang || 0) : 0;
