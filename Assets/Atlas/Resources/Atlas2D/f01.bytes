}
$('btnTimeline').onclick = () => toggleTimeline();
$('btnTlClose').onclick = () => toggleTimeline(false);
$('fcount').onclick = () => toggleTimeline();
$('hud').onclick = () => fitView();
$('btnExport').onclick = () => exportChooser();
$('btnPicker').onclick = () => { closeColorPop(); setTool('picker'); toast('Toca el dibujo para tomar su color'); };

/* ----- intro ----- */
const splashStart = performance.now();
function hideSplash() {
  const s = $('splash');
  // la animación del logo dura 2,5 s (entrada 0,5 · pausa 1,5 · salida 0,5); luego entra la app
  const wait = Math.max(0, 2500 - (performance.now() - splashStart));
  setTimeout(() => { s.classList.add('out'); setTimeout(() => { s.hidden = true; }, 260); }, wait);
}

