  const x = Math.floor(p.x), y = Math.floor(p.y);
  if (x < 0 || y < 0 || x >= P.w || y >= P.h) return;
  const t = resetCtx(ctx2d(workCv, { willReadFrequently: true }));
  t.fillStyle = P.paper; t.fillRect(0, 0, P.w, P.h);
  composeLayers(t, cur.frame, P.w, P.h, getCellSync, false); // muestrea lo mismo que se ve
  const d = t.getImageData(x, y, 1, 1).data;
  setColor('#' + [d[0], d[1], d[2]].map(v => v.toString(16).padStart(2, '0')).join(''));
  setTool(prevTool === 'picker' ? 'brush' : prevTool);
