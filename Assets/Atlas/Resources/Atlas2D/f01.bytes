}
function loadTipImage(b) {
  return new Promise(res => {
    if (b.tip !== 'image' || !b.tipData) { res(); return; }
    const im = new Image();
    im.onload = () => { const c = mkCanvas(96, 96); ctx2d(c).drawImage(im, 0, 0, 96, 96); TIPS['img:' + b.id] = c; res(); };
    im.onerror = () => res();
    im.src = b.tipData;
  });
}
const tipsReady = Promise.all(customBrushes.map(loadTipImage));

async function brushEditor(existing) {
  const base = existing ? { ...existing } : { ...brushDef(), id: undefined, name: 'Mi pincel', custom: true };
  if (base.kind !== 'stamp') { base.tip = 'round'; base.hardness = 0.95; base.spacing = 0.06; base.flow = 1; }
  let b = sanitizeBrush(base);
  if (!existing) b.id = 'c_' + uid();
  await loadTipImage(b);
  const prev = mkCanvas(440, 110); prev.className = 'bprev';
  const draw = () => { renderBrushPreview({ ...b, kind: 'stamp' }, prev); };
  const rng = (key, label, min, max, step, fmt) => {
    const out = el('output', { text: fmt(b[key]) });
    const inp = el('input', { type: 'range', min, max, step, value: b[key], id: 'be_' + key });
    inp.oninput = () => { b[key] = +inp.value; out.textContent = fmt(b[key]); draw(); };
    return el('label', { class: 'sl' }, [el('span', { text: label }), inp, out]);
  };
  const pct = v => Math.round(v * 100) + '%';
  const name = el('input', { type: 'text', value: b.name, maxlength: 24, id: 'be_name' });
  name.oninput = () => { b.name = name.value.trim() || 'Mi pincel'; };
  const tipSel = el('select', { id: 'be_tip' }, TIP_KINDS.map(([v, t]) => el('option', { value: v, text: t, selected: b.tip === v })));
  const pick = el('button', { class: 'btn sm', text: 'Elegir imagen…', type: 'button' });
  const fileIn = el('input', { type: 'file', accept: 'image/*', hidden: true, id: 'be_file' });
  const hard = rng('hardness', 'Dureza', 0, 1, 0.01, pct);
  const syncTip = () => { pick.hidden = b.tip !== 'image'; hard.hidden = b.tip !== 'round'; };
  tipSel.onchange = () => { b.tip = tipSel.value; syncTip(); if (b.tip === 'image' && !b.tipData) fileIn.click(); draw(); };
  pick.onclick = () => fileIn.click();
  fileIn.onchange = async () => {
    const f = fileIn.files && fileIn.files[0]; fileIn.value = '';
    if (!f) return;
    try { b.tipData = await imageToTip(f); b.tip = 'image'; tipSel.value = 'image'; await loadTipImage(b); syncTip(); draw(); }
    catch (e) { toast('No se pudo usar esa imagen como punta'); }
  };
  const rot = el('select', { id: 'be_rot' }, ROT_MODES.map(([v, t]) => el('option', { value: v, text: t, selected: b.rotation === v })));
  rot.onchange = () => { b.rotation = rot.value; draw(); };
  const chk = (key, label) => { const i = el('input', { type: 'checkbox', id: 'be_' + key }); i.checked = !!b[key]; i.onchange = () => { b[key] = i.checked; draw(); }; return el('label', { class: 'chk' }, [i, label]); };
  syncTip();
  const body = el('div', { class: 'form beditor' }, [
    prev,
    el('div', { class: 'row2' }, [el('label', {}, ['Nombre', name]), el('label', {}, ['Punta', tipSel])]),
    el('div', { class: 'drow' }, [pick, fileIn]),
    hard,
    rng('spacing', 'Separación', 0.02, 1.5, 0.01, pct),
    rng('flow', 'Flujo', 0.02, 1, 0.01, pct),
    rng('scatter', 'Dispersión', 0, 2, 0.01, pct),
    rng('sizeJitter', 'Variación de tamaño', 0, 1, 0.01, pct),
    rng('opacityJitter', 'Variación de opacidad', 0, 1, 0.01, pct),
    rng('sizeMul', 'Escala de la punta', 0.2, 4, 0.05, v => '×' + Number(v).toFixed(2)),
    el('label', {}, ['Rotación de la punta', rot]),
    chk('pressure', 'La presión cambia el grosor'),
    chk('pressureFlow', 'La presión cambia la opacidad'),
    chk('speed', 'Se afina al ir rápido'),
    chk('taper', 'Punta afilada al empezar'),
  ]);
  requestAnimationFrame(draw);
  const buttons = [{ label: 'Cancelar', value: false }];
  if (existing) buttons.push({ label: 'Eliminar', value: 'delete', danger: true });
  buttons.push({ label: existing ? 'Guardar' : 'Crear pincel', value: true, primary: true });
  const r = await dialog({ title: existing ? 'Editar pincel' : 'Nuevo pincel', body, buttons });
  if (r === 'delete') {
    if (!(await confirmDlg('Eliminar pincel', '«' + b.name + '» se borrará de tu biblioteca.', 'Eliminar', true))) return;
    customBrushes = customBrushes.filter(x => x.id !== b.id);
    if (brushType === b.id) brushType = 'round';
    saveCustomBrushes(); savePrefs(); toast('Pincel eliminado');
  } else if (r === true) {
    b = sanitizeBrush(b);
    const i = customBrushes.findIndex(x => x.id === b.id);
    if (i >= 0) customBrushes[i] = b; else customBrushes.push(b);
    if (!saveCustomBrushes()) return;
    brushType = b.id; savePrefs();
    toast(existing ? 'Pincel guardado' : 'Pincel creado: ' + b.name);
  }
  if (!$('toolPop').hidden) renderBrushGrid();
}
async function exportBrushPack() {
  if (!customBrushes.length) { toast('Aún no tienes pinceles propios para exportar'); return; }
  const data = JSON.stringify({ format: 'trazo-brushes', version: 1, brushes: customBrushes });
  try { toast(await saveBinary('pinceles_artlas.artlasbrush', 'application/json', new TextEncoder().encode(data)), 3500); }
  catch (e) { toast('No se pudo exportar: ' + e.message, 4000); }
}
async function importBrushPack(file) {
  try {
    const j = JSON.parse(await file.text());
    if (!j || j.format !== 'trazo-brushes' || !Array.isArray(j.brushes)) throw new Error('No es un paquete de pinceles de Artlas 2D');
    let n = 0;
    for (const raw of j.brushes.slice(0, 200)) {
      const b = sanitizeBrush(raw);
      if (customBrushes.some(x => x.id === b.id)) b.id = 'c_' + uid();
      await loadTipImage(b);
      customBrushes.push(b); n++;
    }
    if (saveCustomBrushes()) toast(n + (n === 1 ? ' pincel importado' : ' pinceles importados'));
    if (!$('toolPop').hidden) renderBrushGrid();
  } catch (e) { toast('No se pudo importar: ' + e.message, 4000); }
}
$('brushFile').onchange = e => { const f = e.target.files && e.target.files[0]; e.target.value = ''; if (f) importBrushPack(f); };
/* ---------- 34-historial.js ---------- */
/* =========================================================
   Historial avanzado: lista de acciones y salto a cualquier punto
   ========================================================= */
let historyBusy = false;
function timeAgo(t) {
  const s = Math.max(0, Math.round((Date.now() - t) / 1000));
  if (s < 10) return 'ahora';
  if (s < 60) return 'hace ' + s + ' s';
  const m = Math.round(s / 60);
  return m < 60 ? 'hace ' + m + ' min' : 'hace ' + Math.round(m / 60) + ' h';
}
function historyWhere(e) {
  const L = P.layers.find(l => l.id === e.layerId);
  return 'Cuadro ' + (e.frame + 1) + (L ? ' · ' + L.name : '');
}
// Deshace o rehace hasta que queden exactamente `n` acciones aplicadas.
async function historyJump(n) {
  if (historyBusy) return;
  historyBusy = true;
  try {
    stopPlayback();
    let guard = 500;
    while (undoStack.length > n && guard-- > 0) await undo();
    while (undoStack.length < n && redoStack.length && guard-- > 0) await redo();
  } finally { historyBusy = false; }
}
async function historyPanel() {
  if (!P) return;
  stopPlayback(); commitSel();
  const done = undoStack.slice(), undone = redoStack.slice().reverse();
  const list = el('div', { class: 'hlist' });
  const row = (n, title, sub, state) => {
    const b = el('button', { class: 'hrow ' + state }, [el('span', { class: 'hn', text: String(n).padStart(2, '0') }), el('span', { class: 'ht' }, [title, el('small', { text: sub })])]);
    b.onclick = () => closeDialog(n);
    return b;
  };
  list.appendChild(row(0, 'Estado inicial', 'Antes de la primera acción guardada en el historial', done.length === 0 ? 'cur' : ''));
  done.forEach((e, i) => list.appendChild(row(i + 1, e.label || 'Acción', historyWhere(e) + ' · ' + timeAgo(e.t), i === done.length - 1 ? 'cur' : '')));
  undone.forEach((e, i) => list.appendChild(row(done.length + i + 1, e.label || 'Acción', historyWhere(e) + ' · deshecho', 'undone')));
  const note = el('p', { class: 'note', text: 'Toca una acción para volver a ese momento. Se guardan hasta ' + PERF.undoSteps + ' pasos (perfil ' + PERF.name + '), incluidos los cambios de cuadros y capas.' });
  const r = await dialog({ title: 'Historial', body: el('div', { class: 'form' }, [list, note]), buttons: [{ label: 'Cerrar', value: null }] });
  if (typeof r === 'number') { await historyJump(r); toast(r === 0 ? 'Vuelto al estado inicial' : 'Vuelto a: ' + ((done.concat(undone))[r - 1].label || 'acción')); }
}
// Mantener pulsado «Deshacer» abre el historial
(() => {
  const b = $('btnUndo');
  let t = null, longFired = false;
  b.addEventListener('pointerdown', () => { longFired = false; clearTimeout(t); t = setTimeout(() => { longFired = true; historyPanel(); }, 550); });
  const cancel = () => clearTimeout(t);
  b.addEventListener('pointerup', cancel); b.addEventListener('pointerleave', cancel); b.addEventListener('pointercancel', cancel);
  b.addEventListener('click', e => { if (longFired) { e.stopImmediatePropagation(); e.preventDefault(); longFired = false; } }, true);
})();
/* ---------- 40-gestos.js ---------- */
/* =========================================================
   Gestos en el lienzo
   ========================================================= */
let TAP = null; // toque pendiente (relleno, cuentagotas, varita): se ejecuta al soltar si no hubo deslizamiento
const ptrs = new Map();
let G = null;          // gesto de 2 dedos
let pan = null;        // desplazamiento con 1 dedo / ratón
let gestureLock = false;
let twoTap = null;
let spaceDown = false;
const stagePos = e => { const r = stage.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
stage.addEventListener('pointerdown', e => {
  if (!P) return;
  if (presenting) { exitPresent(); return; }
  closeColorPop();
  stopPlayback();
  try { stage.setPointerCapture(e.pointerId); } catch (_) { }
  const pos = stagePos(e);
  ptrs.set(e.pointerId, { ...pos, type: e.pointerType, t0: performance.now(), x0: pos.x, y0: pos.y });
  const touches = [...ptrs.values()].filter(p => p.type === 'touch');
  if (e.pointerType === 'touch') {
    if (touches.length === 2) {
      if (S) abortStroke();
      if (MV) endMove(true);
      LS = null; SD = null; TAP = null; if (AD) animUp();
      pan = null; startGesture();
      twoTap = { t: performance.now(), moved: false };
      return;
    }
    if (touches.length > 2) { if (twoTap) twoTap.n = Math.max(twoTap.n || 2, touches.length); return; }
    if (gestureLock) return;
    if (penOnly) { pan = { x: pos.x, y: pos.y, vx: view.x, vy: view.y, id: e.pointerId }; return; }
  }
  if (e.pointerType === 'mouse' && (e.button === 1 || e.button === 2 || spaceDown)) { pan = { x: pos.x, y: pos.y, vx: view.x, vy: view.y, id: e.pointerId }; e.preventDefault(); return; }
  if (e.button > 0) return;
  if (S || MV || LS || SD || AD || TAP) return;
  closeToolPop();
  if (animOpen()) { animDown(e); return; }
  toolDown(e);
});
stage.addEventListener('pointermove', e => {
  const p = ptrs.get(e.pointerId);
  if (!p) return;
  const pos = stagePos(e); p.x = pos.x; p.y = pos.y;
  if (G) { updateGesture(); if (twoTap && [...ptrs.values()].some(q => Math.hypot(q.x - q.x0, q.y - q.y0) > 12)) twoTap.moved = true; return; }
  if (pan && pan.id === e.pointerId) { view.x = pan.vx + pos.x - pan.x; view.y = pan.vy + pos.y - pan.y; requestRender(); return; }
  if (TAP && TAP.pid === e.pointerId) { if (Math.hypot(e.offsetX - TAP.x, e.offsetY - TAP.y) > 10) TAP = null; return; } // deslizar no es tocar
  if (AD && AD.pid === e.pointerId) { animMove(e); return; }
  if ((S && S.pid === e.pointerId) || (MV && MV.pid === e.pointerId) || (LS && LS.pid === e.pointerId) || (SD && SD.pid === e.pointerId)) toolMove(e);
});
function endPointer(e) {
  const had = ptrs.get(e.pointerId);
  ptrs.delete(e.pointerId);
  if (!had) return;
  const touchesLeft = [...ptrs.values()].filter(p => p.type === 'touch').length;
  if (G) {
    if (touchesLeft < 2) { G = null; gestureLock = touchesLeft > 0; }
  }
  if (twoTap && touchesLeft === 0) {
    // toque rápido con dos dedos sin moverlos = deshacer
    const tap = twoTap; twoTap = null;
    if (!tap.moved && performance.now() - tap.t < 450) { if ((tap.n || 2) === 3) redo(); else if ((tap.n || 2) === 2) undo(); }
  }
  if (had.type === 'touch' && (G || gestureLock || twoTap)) { if (!ptrs.size) gestureLock = false; return; }
  if (!ptrs.size) gestureLock = false;
  if (pan && pan.id === e.pointerId) { pan = null; return; }
  if (TAP && TAP.pid === e.pointerId) {
    const t = TAP; TAP = null;
    if (e.type !== 'pointercancel' && performance.now() - t.t < 800 && Math.hypot(e.offsetX - t.x, e.offsetY - t.y) <= 10) t.run();
    return;
  }
  if (AD && AD.pid === e.pointerId) { animUp(); return; }
  if (LS && LS.pid === e.pointerId) { if (e.type === 'pointercancel') { LS = null; requestRender(); } else lassoEnd(); return; }
  if (SD && SD.pid === e.pointerId) { SD = null; return; }
  if (S && S.pid === e.pointerId) { if (e.type === 'pointercancel') abortStroke(); else toolUp(e); }
  else if (MV && MV.pid === e.pointerId) endMove(e.type === 'pointercancel');
}
stage.addEventListener('pointerup', endPointer);
stage.addEventListener('pointercancel', endPointer);
stage.addEventListener('contextmenu', e => e.preventDefault());
stage.addEventListener('wheel', e => {
  if (!P) return;
  e.preventDefault();
  const pos = stagePos(e);
  if (e.ctrlKey || e.metaKey || !e.shiftKey) {
    const before = screenToWorld(pos.x, pos.y);
    view.z = clamp(view.z * Math.exp(-e.deltaY * 0.0015), 0.05, 32);
    const m = viewMatrix(), after = m.transformPoint(new DOMPoint(before.x, before.y));
    view.x += pos.x - after.x; view.y += pos.y - after.y;
  } else { view.x -= e.deltaY; }
  requestRender();
}, { passive: false });
function startGesture() {
  const [a, b] = [...ptrs.values()].filter(p => p.type === 'touch');
  const mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
  G = { a0: { x: a.x, y: a.y }, b0: { x: b.x, y: b.y }, d0: Math.max(10, Math.hypot(b.x - a.x, b.y - a.y)), ang0: Math.atan2(b.y - a.y, b.x - a.x),
    world: screenToWorld(mid.x, mid.y), z0: view.z, r0: view.r };
}
function updateGesture() {
  const t = [...ptrs.values()].filter(p => p.type === 'touch');
  if (t.length < 2) return;
  const [a, b] = t;
  const d = Math.max(10, Math.hypot(b.x - a.x, b.y - a.y)), ang = Math.atan2(b.y - a.y, b.x - a.x);
  view.z = clamp(G.z0 * d / G.d0, 0.05, 32);
  let r = G.r0 + (ang - G.ang0);
  const deg = ((r * 180 / Math.PI) % 360 + 360) % 360;
  if (deg < 4 || deg > 356) r = Math.round(r / (Math.PI * 2)) * Math.PI * 2;
  view.r = r;
  const mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
  view.x = 0; view.y = 0;
  const p = viewMatrix().transformPoint(new DOMPoint(G.world.x, G.world.y));
  view.x = mid.x - p.x; view.y = mid.y - p.y;
