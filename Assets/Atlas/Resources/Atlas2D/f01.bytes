/* ---------- 32-pinceles.js ---------- */
/* =========================================================
   Pinceles personalizados: editor, puntas desde imagen y paquetes
   ========================================================= */
const TIP_KINDS = [['round', 'Redonda'], ['soft', 'Suave'], ['grain', 'Grano'], ['crayon', 'Cera'], ['image', 'Imagen propia']];
