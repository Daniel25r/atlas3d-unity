    pid: e.pointerId, tool, cellId: c.id, layerId: c.L.id, frame: cur.frame, created: c.created,
    size: ts.size, opacity: erase ? 1 : (ts.opacity / 100) * (def.marker ? 0.72 : 1), p0: p,
  };
  const t = erase ? ctx2d(c.cv) : ctx2d(strokeCv);
  if (!erase) t.clearRect(0, 0, P.w, P.h);
  t.globalCompositeOperation = erase ? 'destination-out' : 'source-over'; t.globalAlpha = 1;
  S.ctx = t;
  S.label = erase ? 'Borrador' : tool === 'shape' ? ({ line: 'Línea', rect: 'Rectángulo', ellipse: 'Elipse' }[shapeType] || 'Forma') : tool === 'pencil' ? 'Lápiz' : (def.name || 'Pincel');
  if (tool === 'shape') { S.shape = shapeType; drawShape(p, e.shiftKey); requestRender(); return; }
  S.eng = makeStroke(t, { ...def, size: ts.size, color: erase ? '#000000' : color, mirrors: mirrorFns(), zoom: view.z });
